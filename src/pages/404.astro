---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getDict } from '../i18n';
import { BOAT_VIEWBOX, boatInner } from '../lib/boat';

// une seule 404.html pour tout le site : le français est affiché par défaut,
// l'anglais prend le relais côté navigateur pour les URL en /en/…
const fr = getDict('fr');
const en = getDict('en');
const versions = [
  { l: 'fr', d: fr, home: '/', work: '/work' },
  { l: 'en', d: en, home: '/en', work: '/en/work' },
] as const;
---

<SiteLayout lang="fr" title={`${fr.notFound.title} — Isaure Lohest`} description={fr.notFound.text}>
  <meta slot="head" name="robots" content="noindex, nofollow" />

  <main class="adrift" data-adrift>
    <button
      class="adrift__boat"
      type="button"
      data-boat
      data-label-fr={fr.notFound.again}
      data-label-en={en.notFound.again}
      aria-label={fr.notFound.again}
    >
      <svg viewBox={BOAT_VIEWBOX} aria-hidden="true" set:html={boatInner} />
    </button>

    {/* la bulle de BD : le bateau commente la 404 (un autre message à chaque touche sur le bateau) */}
    <div class="adrift__bubble" data-bubble data-jokes-fr={JSON.stringify(fr.notFound.jokes)} data-jokes-en={JSON.stringify(en.notFound.jokes)}>
      <span class="adrift__bubble-box" aria-hidden="true"></span>
      <p class="adrift__bubble-text">
        <span class="adrift__ghost" data-ghost aria-hidden="true"></span>
        <span class="adrift__typed" data-typed aria-hidden="true"></span>
      </p>
      <span class="adrift__tail" aria-hidden="true">
        <svg viewBox="0 0 34 30" width="34" height="30"><path d="M3,0 C6,11 9,19 6,30 C16,20 24,11 31,0" /></svg>
      </span>
      <span class="sr-only" role="status" aria-live="polite" data-live></span>
    </div>

    {
      versions.map(({ l, d, home, work }) => (
        <div class="adrift__copy" data-l={l} hidden={l === 'en'}>
          <p class="label">404</p>
          <h1 class="adrift__title display">{d.notFound.heading}</h1>
          <p class="adrift__text">{d.notFound.text}</p>
          <div class="adrift__actions">
            <a class="pill-link" href={home}>{d.notFound.back}</a>
            <a class="adrift__link label" href={work}>
              {d.notFound.work} →
            </a>
          </div>
        </div>
      ))
    }
  </main>
</SiteLayout>

<script>
  import '../scripts/adrift';
</script>

<style is:global>
  .adrift {
    position: relative;
    flex: 1;
    min-height: calc(100svh - 120px);
    overflow: hidden;
    padding: calc(var(--nav-h) + clamp(50px, 12vh, 130px)) var(--gutter) 80px;
  }
  .adrift__svg {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 0;
    pointer-events: none;
  }
  /* le bateau tangue au cœur du tourbillon ; une touche = tour sur lui-même + nouveau message + averse */
  .adrift__boat {
    position: absolute;
    z-index: 1;
    width: 62px;
    height: 40px;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transform-origin: 50% 70%;
    animation: adrift-rock 5.5s ease-in-out infinite;
  }
  .adrift__boat svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .adrift__boat:focus-visible {
    outline: 1.5px dashed var(--blue);
    outline-offset: 8px;
    border-radius: 8px;
  }
  .adrift__boat.is-spin {
    animation: adrift-spin 0.9s cubic-bezier(0.3, 0.1, 0.2, 1) 1;
  }
  @keyframes adrift-rock {
    0%,
    100% {
      transform: rotate(-6deg) translateY(0);
    }
    50% {
      transform: rotate(7deg) translateY(-3px);
    }
  }
  @keyframes adrift-spin {
    from {
      transform: rotate(0deg) translateY(0);
    }
    40% {
      transform: rotate(250deg) translateY(-14px);
    }
    to {
      transform: rotate(360deg) translateY(0);
    }
  }

  /* la bulle de BD : contour tremblé (même trait que les cartes de la FAQ), queue vers le bateau */
  .adrift__bubble {
    position: absolute;
    z-index: 3;
    width: clamp(220px, 26vw, 300px);
    padding: 16px 18px 14px;
    font-family: var(--font-serif);
    color: var(--ink);
    pointer-events: none;
    --tail-x: 50%;
  }
  .adrift__bubble-box {
    position: absolute;
    inset: 0;
    z-index: -1;
    border: 1.7px solid var(--ink);
    border-radius: 24px 30px 26px 32px / 28px 24px 32px 26px;
    background: var(--paper);
    filter: url(#ink-rough);
  }
  .adrift__bubble-text {
    display: grid;
    margin: 0;
    font-size: clamp(14px, 1.15vw, 16.5px);
    line-height: 1.38;
  }
  .adrift__ghost,
  .adrift__typed {
    grid-area: 1 / 1;
  }
  .adrift__ghost {
    visibility: hidden;
  }
  .adrift__typed::after {
    content: '';
    display: inline-block;
    width: 1px;
    height: 1em;
    margin-left: 2px;
    vertical-align: -0.12em;
    background: var(--blue);
    animation: adrift-caret 0.9s steps(1) infinite; /* le curseur clignote tout le temps, y compris à la fin de la phrase */
  }
  @keyframes adrift-caret {
    50% {
      opacity: 0;
    }
  }
  .adrift__tail {
    position: absolute;
    top: 100%;
    left: var(--tail-x);
    margin: -2px 0 0 -14px;
    line-height: 0;
    filter: url(#ink-rough);
  }
  .adrift__tail path {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 1.7;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .adrift__rain {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 1;
    pointer-events: none;
  }
  .adrift__copy {
    position: relative;
    z-index: 2;
    max-width: 30rem;
  }
  .adrift__copy[hidden] {
    display: none;
  }
  .adrift__copy .label {
    margin: 0 0 18px;
    color: #85847e;
  }
  .adrift__title {
    margin: 0 0 22px;
    font-size: clamp(56px, 9vw, 140px);
    line-height: 0.92;
    text-transform: lowercase;
  }
  .adrift__text {
    margin: 0 0 32px;
    font-size: clamp(16px, 1.3vw, 19px);
    line-height: 1.45;
    color: var(--ink-soft);
  }
  .adrift__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px 26px;
  }
  .adrift__link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  @media (prefers-reduced-motion: reduce) {
    .adrift__boat,
    .adrift__boat.is-spin,
    .adrift__typed::after {
      animation: none;
    }
  }
</style>
