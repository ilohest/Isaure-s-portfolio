---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  widths?: number[];
  sizes?: string;
  class?: string;
  imgClass?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
}

const {
  src,
  alt,
  widths = [640, 960, 1280, 1920],
  sizes = '100vw',
  class: pictureClass,
  imgClass,
  loading = 'lazy',
  fetchpriority = 'auto',
} = Astro.props;
const remote = src.src.startsWith('https://cdn.sanity.io/');
// image hébergée par Sanity : le CDN redimensionne et choisit le format (avif / webp) lui-même
const srcset = remote ? widths.filter((w) => w <= src.width).concat(src.width <= widths[widths.length - 1] ? [src.width] : []).map((w) => `${src.src}?w=${w}&auto=format ${w}w`).join(', ') : '';
---

{
  remote ? (
    <img
      src={`${src.src}?w=${Math.min(src.width, 1280)}&auto=format`}
      srcset={srcset}
      sizes={sizes}
      width={src.width}
      height={src.height}
      alt={alt}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding="async"
      class={imgClass}
    />
  ) : (
<Picture
  src={src}
  alt={alt}
  widths={widths}
  sizes={sizes}
  formats={['avif', 'webp']}
  fallbackFormat="webp"
  loading={loading}
  fetchpriority={fetchpriority}
  decoding="async"
  class={imgClass}
  pictureAttributes={{ class: pictureClass }}
/>
  )
}
