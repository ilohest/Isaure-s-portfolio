---
import ProjectSheet from '../v2/ProjectSheet.astro';
import type { SheetBlock } from './case-study';
import mockupSrc from '/src/assets/media-src/projects/web-dev/mark-conlan/mockup-mark-conlan.png';

const M = '/assets/media/projects/web-dev/mark-conlan';

const blocks: SheetBlock[] = [
  { type: 'image', src: mockupSrc, alt: 'Mark Conlan ecommerce mockup' },
  {
    type: 'text',
    title: 'Custom portfolio gallery',
    paragraphs: [
      "Squarespace's grid options couldn't handle the variety of Mark's formats. I built a masonry-style gallery in Liquid, 100% tailored to how his illustrations are meant to be seen: format-aware, flexible, and fully editable by Mark without touching code.",
    ],
  },
  {
    type: 'text',
    title: 'E-commerce built to scale',
    paragraphs: [
      "Product templates, structured collections, variant logic: everything was set up to handle a growing catalog cleanly. Adding new works, new series, or new product types doesn't require rebuilding anything.",
    ],
  },
  {
    type: 'text',
    title: 'His store, his control',
    paragraphs: [
      'One of the core goals was autonomy. Mark can now manage his entire catalog, update collections, and launch new pieces without depending on a developer. The back-end is as considered as the front.',
    ],
  },
  { type: 'video', src: '/media/videos/mark-conlan-2-web.mp4', alt: 'Mark Conlan storefront scroll' },
  {
    type: 'video',
    src: '/media/videos/mark-conlan-1-web.mp4',
    poster: `${M}/mark-conlan-temp-960.avif`,
    alt: 'Mark Conlan product interaction',
  },
];

const { year = '', others = [] } = Astro.props;
---

<ProjectSheet
  year={year}
  others={others}
  title="Mark Conlan"
  sector="Illustration /painting / art"
  country="Ireland"
  format="Shopify e-commerce website"
  tags={['Shopify', 'Liquid', 'E-commerce']}
  url={{ href: 'https://markconlan.com/', label: 'markconlan.com' }}
  projectParagraphs={[
    "Mark Conlan is an Irish illustrator with a growing catalog of originals, prints, and collections. He had a Squarespace site that did its job: clean, presentable, his work on display. But as his catalog grew, the cracks started showing. The e-commerce was too rigid to handle the way he actually sells. The gallery looked fine, but couldn't adapt to the specifics of each project. He needed a platform that could grow with his practice, not hold it back. So we moved to Shopify, and built everything around how he actually works.",
  ]}
  responsibilities="Shopify setup &amp; migration - Liquid theme customization - Masonry gallery development - Product &amp; collection architecture - Launch"
  blocks={blocks}
  showContext={false}
/>
