---
import ResponsiveImage from '../media/ResponsiveImage.astro';
import type { ImageMetadata } from 'astro';

const images = import.meta.glob<ImageMetadata>(
  '/src/assets/media-src/projects/web-dev/goa-b2b/*.png',
  { eager: true, import: 'default' },
);
const pic = (base: string): ImageMetadata =>
  images[`/src/assets/media-src/projects/web-dev/goa-b2b/${base}.png`];

const pipeline = [
  {
    step: '01',
    title: 'Sync',
    text: 'A server-side job pulls the catalogue, per-client prices, discounts and delivery settings from Easybeer and caches them in Firestore.',
  },
  {
    step: '02',
    title: 'Order',
    text: 'Professional customers browse their own catalogue at their own prices and build a cart that already knows their discounts, minimum and carrier rules.',
  },
  {
    step: '03',
    title: 'Write back',
    text: 'Validating the cart creates the order directly in Easybeer. Nothing is retyped, and re-saving updates the same order instead of duplicating it.',
  },
];

const decisions = [
  {
    title: 'Easybeer stays the source of truth',
    text: 'The platform reads catalogue, prices, discounts, client settings and invoices from the ERP, and writes exactly one thing back: the order. No business data is duplicated, so GOA keeps managing its products and pricing where it always has.',
  },
  {
    title: 'Every price is personal',
    text: 'Prices are never uniform — the same bottle costs a different amount depending on customer type, with custom per-client rates and four levels of discounts layered on top. Every price on screen is resolved for the customer who is logged in, never a default list price.',
  },
  {
    title: 'An opt-in catalogue',
    text: 'The ERP holds dozens of referenced products, but only a handful should be orderable. An override layer lets GOA toggle visibility, rewrite technical labels, attach a photo and flag a product as out of stock — new products stay hidden by default.',
  },
  {
    title: 'Business rules live in the cart',
    text: 'Carrier constraints are enforced while ordering: customers shipped by La Poste order in multiples of 3 for 35 cl and 2 for 1 L so crates stay homogeneous, and the minimum order value is read from each customer record.',
  },
  {
    title: 'Editable, not re-ordered',
    text: 'An order stays editable until the ERP marks it as delivered. Saving again upserts the same order rather than creating a second one, which removes the old “this order cancels the previous one” workaround.',
  },
  {
    title: 'Mobile before desktop',
    text: 'Around 90 % of orders are placed from a phone, often in a bar or a back room. The ordering flow is designed for that context first; the admin side assumes a larger screen.',
  },
];

const technicalGroups = [
  {
    title: 'Frontend',
    text: 'Vue 3, Vite and TypeScript, with shadcn-vue (Reka UI + Tailwind CSS v4) as a single design system across the customer shop and the admin console. TanStack Query for reads, TanStack Table for the admin grids, Zod for validation.',
  },
  {
    title: 'Backend',
    text: 'A Hono server acting as the only door to Easybeer: Basic Auth credentials stay server-side and never reach the browser bundle, alongside admin endpoints, order writes and the scheduled sync job.',
  },
  {
    title: 'Auth & data',
    text: 'Firebase Auth, with no public sign-up at all: an account exists only for a customer GOA already invoices, invited from their ERP record. Firestore holds the platform-side state — the part the ERP does not own — and Firebase Storage the product photos.',
  },
  {
    title: 'Living with a throttled API',
    text: 'The ERP API throttles aggressively, and retrying during a cooldown only makes it worse. A single outbound queue paces every call, a circuit breaker fails locally instead of hammering the API while a cooldown is active, and the cached read model means customer traffic never reaches the ERP at all — only order writes do.',
  },
];

const screens = [
  {
    base: '01-espace-pro',
    alt: 'GOA B2B sign-in screen for professional customers',
    caption:
      'Sign-in — access is invitation-only: there is no public sign-up, only customers GOA already works with.',
  },
  {
    base: '02-boutique-client',
    alt: 'Customer shop showing products, per-client prices and a live cart',
    caption:
      'Customer shop — commercial terms, per-client prices, discounts and VAT are computed live while the cart is built.',
  },
  {
    base: '03-tableau-de-bord',
    alt: 'Admin dashboard summarising customers, orders and catalogue',
    caption:
      'Admin dashboard — customers, orders and catalogue in one glance, with the timestamp of the last ERP sync.',
  },
  {
    base: '04-commandes',
    alt: 'Admin order list with statuses, payment state and documents',
    caption:
      'Orders — the list that used to be a form inbox, now reading order status, payment state and invoices straight from the ERP.',
  },
  {
    base: '05-catalogue',
    alt: 'Catalogue administration with pricing tiers, visibility and stock toggles',
    caption:
      'Catalogue — the override layer: display name, price tiers, visibility and availability, product by product.',
  },
  {
    base: '06-clients',
    alt: 'Admin customer list with search, customer types and account status',
    caption:
      'Customers — the bridge between an ERP record and a platform account, and where invitations are sent from.',
  },
];

const tags = ['Full-stack development', 'ERP integration', 'B2B ordering'];
---

<section class="goab-project relative mx-auto px-4 py-4">
  <div class="goab-layout">
    <aside class="goab-sticky">
      <div class="goab-card-inner flex flex-col gap-4">
        <h1 class="project-title-reveal goab-title font-display m-0 uppercase">
          <span class="project-title-reveal__inner">GOA B2B</span>
        </h1>

        <ul class="goab-tags" aria-label="Project tags">
          {tags.map((tag) => <li>{tag}</li>)}
        </ul>

        <div class="goab-meta" aria-label="Project details">
          <p><i>Client: </i>La Brasserie de GOA</p>
          <p><i>Sector: </i>Food &amp; Beverage</p>
          <p><i>Country: </i>France</p>
          <p><i>Format: </i>B2B ordering platform &amp; admin console</p>
        </div>

        <div class="goab-copy">
          <p>
            GOA brews artisanal kombucha in the Périgord and sells it to a couple of hundred
            professional customers: bars and restaurants, grocery stores, distributors, festivals.
          </p>
          <p>
            I designed and developed the platform where those customers now order, and connected it
            to Easybeer, the ERP GOA already runs its business on — so an order placed on the web
            becomes an order in the ERP, with no manual step in between.
          </p>
        </div>
      </div>
    </aside>

    <div class="project-screens">
      <figure class="goab-screen goab-screen--hero">
        <ResponsiveImage
          src={pic(screens[0].base)}
          alt={screens[0].alt}
          sizes="(min-width: 1280px) 1040px, (min-width: 970px) 64vw, 100vw"
          loading="eager"
          imgClass="project-screen"
        />
        <figcaption>{screens[0].caption}</figcaption>
      </figure>

      <section class="goab-feature-panel" aria-labelledby="goab-context-title">
        <h2 id="goab-context-title" class="goab-section-title">Project context</h2>
        <hr class="goab-feature-rule" />
        <div class="goab-context-copy">
          <p>
            Orders used to arrive through a Jotform. Someone at GOA then retyped each one into
            Easybeer, by hand, between 100 and 150 times a month. The form knew nothing about who was
            ordering: no customer-specific prices, no discounts, no minimum order, no carrier
            constraints. Everything was checked afterwards, and mistakes were caught late.
          </p>
          <p>
            The brief was not to rebuild that ERP, it was to stop duplicating it. The platform reads
            from Easybeer and writes only orders back to it, which means GOA keeps a single place to
            manage products, prices and customers — and their customers get an ordering experience
            that already knows their terms.
          </p>
        </div>
      </section>

      <figure class="goab-screen">
        <ResponsiveImage
          src={pic(screens[1].base)}
          alt={screens[1].alt}
          sizes="(min-width: 1280px) 1040px, (min-width: 970px) 64vw, 100vw"
          loading="lazy"
          imgClass="project-screen"
        />
        <figcaption>{screens[1].caption}</figcaption>
      </figure>

      <section class="goab-feature-panel" aria-labelledby="goab-pipeline-title">
        <h2 id="goab-pipeline-title" class="goab-section-title">How it works</h2>
        <hr class="goab-feature-rule" />
        <ol class="goab-pipeline">
          {
            pipeline.map((item) => (
              <li class="goab-pipeline-item">
                <span class="goab-pipeline-step" aria-hidden="true">
                  {item.step}
                </span>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </li>
            ))
          }
        </ol>
      </section>

      {
        screens.slice(2, 5).map((screen) => (
          <figure class="goab-screen">
            <ResponsiveImage
              src={pic(screen.base)}
              alt={screen.alt}
              sizes="(min-width: 1280px) 1040px, (min-width: 970px) 64vw, 100vw"
              loading="lazy"
              imgClass="project-screen"
            />
            <figcaption>{screen.caption}</figcaption>
          </figure>
        ))
      }

      <section class="goab-feature-panel" aria-labelledby="goab-decisions-title">
        <h2 id="goab-decisions-title" class="goab-section-title">Selected product decisions</h2>
        <hr class="goab-feature-rule" />
        <div class="goab-feature-list">
          {
            decisions.map((decision) => (
              <article class="goab-feature-item">
                <h3>{decision.title}</h3>
                <p>{decision.text}</p>
              </article>
            ))
          }
        </div>
      </section>

      <figure class="goab-screen">
        <ResponsiveImage
          src={pic(screens[5].base)}
          alt={screens[5].alt}
          sizes="(min-width: 1280px) 1040px, (min-width: 970px) 64vw, 100vw"
          loading="lazy"
          imgClass="project-screen"
        />
        <figcaption>{screens[5].caption}</figcaption>
      </figure>

      <section class="goab-feature-panel" aria-labelledby="goab-technical-title">
        <h2 id="goab-technical-title" class="goab-section-title">Technical approach</h2>
        <hr class="goab-feature-rule" />
        <div class="goab-feature-list">
          {
            technicalGroups.map((group) => (
              <article class="goab-feature-item">
                <h3>{group.title}</h3>
                <p>{group.text}</p>
              </article>
            ))
          }
        </div>
      </section>
    </div>
  </div>
</section>

<style>
  .goab-project { width:min(100%,1680px); max-width:min(100%,1680px); }
  :global(.project-detail-page)>.goab-project { max-width:min(100%,1680px); }
  .goab-layout { display:grid; grid-template-columns:minmax(18rem,.72fr) minmax(0,1.58fr); gap:clamp(2rem,4vw,5rem); align-items:start; }
  .goab-sticky { position:sticky; top:clamp(1rem,3vw,2.5rem); min-width:0; }
  .goab-card-inner { gap:clamp(.95rem,1.4vw,1.25rem); padding:clamp(.35rem,1.2vw,1rem) 0; }
  .goab-title { max-width:12.5ch; color:var(--text-primary); font-size:clamp(2.4rem,5.4vw,5.8rem); line-height:.94; letter-spacing:.02em; }
  .goab-tags { display:flex; flex-wrap:wrap; gap:.5rem; padding:0; margin:0; list-style:none; }
  .goab-tags li { border:1px solid currentColor; border-radius:999px; padding:.42rem .7rem; color:var(--text-primary); font-family:var(--font-family-display); font-size:.78rem; line-height:1; text-transform:uppercase; }
  .goab-meta { display:flex; flex-direction:column; gap:.25rem; max-width:34ch; color:var(--text-secondary); font-family:var(--font-family-body); font-size:.95rem; font-weight:300; line-height:1.45; }
  .goab-meta p { margin:0; }
  .goab-meta i { color:var(--text-primary); font-style:italic; text-transform:uppercase; }
  .goab-copy,.goab-context-copy { color:var(--text-secondary); font-family:'Red Hat Text',sans-serif; font-weight:300; }
  .goab-copy p,.goab-context-copy p { margin:0; font-size:clamp(.95rem,1vw,1.05rem); line-height:1.6; }
  .goab-copy p+p,.goab-context-copy p+p { margin-top:1rem; }
  .project-screens { display:grid; gap:clamp(2rem,4.5vw,4.25rem); min-width:0; }
  .goab-feature-panel { padding:clamp(1.4rem,2.8vw,2.4rem); background:var(--palette-white); box-shadow:0 12px 32px rgba(0,0,0,.08); }
  .goab-section-title { margin:0; color:var(--text-primary); font-family:var(--font-family-display); font-size:clamp(1.1rem,1.9vw,1.7rem); font-weight:400; line-height:1.05; letter-spacing:.04em; text-transform:uppercase; }
  .goab-feature-rule { width:100%; height:0; margin:clamp(.8rem,1.6vw,1.2rem) 0 clamp(1.2rem,2.6vw,2rem); border:0; border-top:1px solid color-mix(in srgb,var(--text-primary) 26%,transparent); }
  .goab-feature-list { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:clamp(1.25rem,2.5vw,2.5rem) clamp(1.5rem,4vw,3.5rem); }
  .goab-feature-item { display:flex; flex-direction:column; gap:.55rem; margin:0; }
  .goab-feature-item h3 { display:flex; flex-direction:column; gap:.5rem; margin:0; color:var(--text-primary); font-size:clamp(.95rem,1vw,1.05rem); font-weight:400; line-height:1.1; }
  .goab-feature-item h3::after { content:''; display:block; width:100%; height:1px; background:color-mix(in srgb,var(--text-primary) 35%,transparent); }
  .goab-feature-item p { margin:0; color:var(--text-secondary); font-family:'Red Hat Text',sans-serif; font-size:clamp(.92rem,.95vw,1rem); font-weight:300; line-height:1.6; }
  .goab-pipeline { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:clamp(1.5rem,3vw,3rem); padding:0; margin:0; list-style:none; counter-reset:none; }
  .goab-pipeline-item { display:flex; flex-direction:column; gap:.55rem; margin:0; }
  .goab-pipeline-step { color:var(--text-primary); font-family:var(--font-family-display); font-size:clamp(1.6rem,3vw,2.6rem); line-height:1; opacity:.28; }
  .goab-pipeline-item h3 { display:flex; flex-direction:column; gap:.5rem; margin:0; color:var(--text-primary); font-family:var(--font-family-display); font-size:clamp(.95rem,1.1vw,1.15rem); font-weight:400; letter-spacing:.04em; line-height:1.1; text-transform:uppercase; }
  .goab-pipeline-item h3::after { content:''; display:block; width:100%; height:1px; background:color-mix(in srgb,var(--text-primary) 35%,transparent); }
  .goab-pipeline-item p { margin:0; color:var(--text-secondary); font-family:'Red Hat Text',sans-serif; font-size:clamp(.92rem,.95vw,1rem); font-weight:300; line-height:1.6; }
  .goab-screen { margin:0; }
  .goab-screen :global(.project-screen) { display:block; width:100%; height:auto; box-shadow:0 12px 32px rgba(0,0,0,.08); }
  .goab-screen figcaption { max-width:48rem; margin-top:.65rem; color:var(--text-secondary); font-family:'Red Hat Text',sans-serif; font-size:.82rem; font-weight:300; line-height:1.5; }
  @media(min-width:768px){ .goab-card-inner { padding-right:clamp(.5rem,1.5vw,1.5rem); } }
  @media(max-width:1100px){ .goab-layout { grid-template-columns:minmax(17rem,.8fr) minmax(0,1.2fr); gap:clamp(1.5rem,3vw,3rem); } .goab-title { font-size:clamp(2.25rem,5vw,4.6rem); } }
  @media(max-width:860px){ .goab-layout { grid-template-columns:1fr; } .goab-sticky { position:static; } .goab-card-inner { padding-right:0; } .goab-title { max-width:14ch; font-size:clamp(2.6rem,13vw,4.6rem); } .goab-pipeline { grid-template-columns:1fr; } }
  @media(max-width:560px){ .goab-project { padding-inline:1rem; } .goab-feature-panel { padding:1.25rem; } .goab-feature-list { grid-template-columns:1fr; } }
</style>
