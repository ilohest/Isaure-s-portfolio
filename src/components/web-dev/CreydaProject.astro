---
import CaseStudyProject from './CaseStudyProject.astro';
import type { CaseStudyMedia } from './case-study';

import type { ImageMetadata } from 'astro';

const images = import.meta.glob<ImageMetadata>('/src/assets/media-src/projects/web-dev/creyda/*.png', {
  eager: true,
  import: 'default',
});

const pic = (base: string): ImageMetadata =>
  images[`/src/assets/media-src/projects/web-dev/creyda/${base}.png`];

const media: CaseStudyMedia[] = [
  { type: 'image', src: pic('creyda-screen-home'), alt: 'Creyda Yoga homepage featuring the R.E.S. method' },
  { type: 'image', src: pic('creyda-screen-res'), alt: 'Creyda Yoga R.E.S. method quote section' },
  {
    type: 'video',
    src: '/media/videos/creyda-2026-detail.mp4',
    poster: '/assets/media/projects/web-dev/creyda-2026/creyda-yoga.webp',
    alt: 'Creyda Yoga website interaction detail',
  },
  { type: 'image', src: pic('creyda-screen-pricing'), alt: 'Creyda Yoga pricing page with class and subscription cards' },
  { type: 'image', src: pic('creyda-screen-yoga'), alt: 'Creyda Yoga trial class call to action' },
];

const palette = [
  { hex: '#1D744A', rgb: '29, 116, 74', cmyk: '75, 0, 36, 55', textColor: '#F4FFEF' },
  { hex: '#175F3C', rgb: '23, 95, 60', cmyk: '76, 0, 37, 63', textColor: '#F4FFEF' },
  { hex: '#F4FFEF', rgb: '244, 255, 239', cmyk: '4, 0, 6, 0', textColor: '#1D1D1D' },
  { hex: '#E8E7E2', rgb: '232, 231, 226', cmyk: '0, 0, 3, 9', textColor: '#1D1D1D' },
  { hex: '#1D1D1D', rgb: '29, 29, 29', cmyk: '0, 0, 0, 89', textColor: '#F4FFEF' },
];
---

<CaseStudyProject
  title="Creyda"
  subtitle="Yoga intégral"
  tags={['Nuxt', 'Accessibility', 'Local SEO']}
  meta={[
    { label: 'Client', value: 'Creyda Yoga' },
    { label: 'Sector', value: 'Yoga' },
    { label: 'Country', value: 'Belgium' },
    { label: 'Format', value: 'Showcase website' },
  ]}
  url={{ href: 'https://creyda-yoga.be/', label: 'creyda-yoga.be' }}
  heroVideo="/media/videos/creyda-2026-preview.mp4"
  heroPoster="/assets/media/projects/web-dev/creyda-2026/creyda-home.webp"
  heroAlt="Creyda Yoga website motion preview"
  projectParagraphs={[
    'A full redesign for Creyda, an integral yoga centre in Ixelles, Brussels, offering Hatha Yoga, prânayâma and meditation in small groups, wellbeing sessions and the R.E.S. method — Rhythm, Balance, Synchronicity — created by Patrick Noblet.',
    'The site is built with Nuxt and Vue as a fast, statically generated front end. Accessibility was part of the brief: keyboard-friendly navigation, visible focus states, generous touch targets and real text rather than images of text.',
    'Local SEO is built into the structure — descriptive headings, per-page titles and descriptions, and structured data so the centre surfaces on searches for yoga in Ixelles and Brussels.',
    'Editorial typography, generous white space and a deep green give the centre a calm, grounded presence, while clear routes to classes, pricing and contact keep the experience practical for beginners and regular practitioners alike.',
  ]}
  responsibilities="Web design - Content structure - Nuxt frontend development - Accessibility - Responsive optimization - Local SEO - Domain setup &amp; website launch"
  palette={palette}
  paletteLabel="Creyda Yoga color palette"
  paletteNote="The green of a garden after rain, steady and alive. A pale mint breath of light across the mat, the soft grey of stone underfoot, and a single ink line for words — a palette that slows the eye down, the way a practice slows the breath."
  media={media}
/>
