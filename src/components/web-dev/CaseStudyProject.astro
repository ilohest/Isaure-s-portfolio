---
import ResponsiveImage from '../media/ResponsiveImage.astro';

import type { CaseStudyMedia, CaseStudySwatch } from './case-study';

interface Props {
  title: string;
  subtitle?: string;
  tags: string[];
  meta: { label: string; value: string }[];
  url: { href: string; label: string };
  heroVideo: string;
  heroPoster: string;
  heroAlt: string;
  projectParagraphs: string[];
  responsibilities: string;
  palette: CaseStudySwatch[];
  paletteLabel: string;
  paletteNote: string;
  media: CaseStudyMedia[];
}

const {
  title,
  subtitle,
  tags,
  meta,
  url,
  heroVideo,
  heroPoster,
  heroAlt,
  projectParagraphs,
  responsibilities,
  palette,
  paletteLabel,
  paletteNote,
  media,
} = Astro.props;

const sizes = '(min-width: 1280px) 64vw, (min-width: 970px) calc(100vw - 24rem), calc(100vw - 2rem)';
---

<section class="cs-project relative mx-auto px-4 py-4">
  <div class="cs-layout">
    <aside class="cs-sticky">
      <div class="cs-intro">
        <h1 class="project-title-reveal cs-title font-display m-0 uppercase">
          <span class="project-title-reveal__inner">
            {title}
            {subtitle && <span class="cs-title-sub">{subtitle}</span>}
          </span>
        </h1>

        <ul class="cs-tags" aria-label="Project tags">
          {tags.map((tag) => <li>{tag}</li>)}
        </ul>

        <div class="cs-meta" aria-label="Project details">
          {meta.map((item) => <p><i>{item.label}: </i>{item.value}</p>)}
          <p>
            <i>URL: </i>
            <a href={url.href} target="_blank" rel="noopener noreferrer">{url.label}</a>
          </p>
        </div>
      </div>
    </aside>

    <div class="cs-flow">
      <figure class="cs-hero" data-cs-video-frame>
        <img src={heroPoster} alt="" class="cs-hero-placeholder" loading="eager" decoding="async" />
        <video
          src={heroVideo}
          class="cs-hero-video"
          poster={heroPoster}
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-label={heroAlt}
        ></video>
      </figure>

      <div class="cs-study-card">
        <article class="cs-block">
          <h2 class="cs-block__title">The Project</h2>
          <hr class="cs-block__rule" />
          <div class="cs-block__body">
            {projectParagraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </article>

        <article class="cs-block">
          <h2 class="cs-block__title">Responsibilities</h2>
          <hr class="cs-block__rule" />
          <div class="cs-block__body">
            <p>{responsibilities}</p>
          </div>
        </article>
      </div>

      <div class="cs-palette-card" role="group" aria-label={paletteLabel}>
        <div class="cs-palette-grid">
          {
            palette.map((sw) => (
              <div class="cs-palette-swatch" style={`background-color:${sw.hex};color:${sw.textColor}`}>
                <div class="cs-palette-label">
                  <p class="cs-palette-line">HEX {sw.hex}</p>
                  <p class="cs-palette-line">RGB {sw.rgb}</p>
                  <p class="cs-palette-line">CMYK {sw.cmyk}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="cs-palette-note">
        <p>{paletteNote}</p>
      </div>

      <div class="cs-screen-grid">
        {
          media.map((item) =>
            item.type === 'image' ? (
              <ResponsiveImage
                src={item.src}
                alt={item.alt}
                sizes={sizes}
                loading="lazy"
                imgClass="cs-screen"
                class="cs-picture"
              />
            ) : (
              <div class="cs-picture">
                <video
                  class="cs-screen"
                  src={item.src}
                  poster={item.poster}
                  aria-label={item.alt}
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                ></video>
              </div>
            ),
          )
        }
      </div>
    </div>
  </div>
</section>

<script>
  const initializedCaseStudyVideos = new WeakSet();

  const initCaseStudyVideos = () => {
    document.querySelectorAll('[data-cs-video-frame]').forEach((frame) => {
      const video = frame.querySelector('video');
      if (!(video instanceof HTMLVideoElement) || initializedCaseStudyVideos.has(video)) return;
      initializedCaseStudyVideos.add(video);

      const showVideo = () => frame.classList.add('is-video-ready');
      const keepPlaceholder = () => frame.classList.remove('is-video-ready');

      video.addEventListener('loadeddata', showVideo);
      video.addEventListener('canplay', showVideo);
      video.addEventListener('error', keepPlaceholder);

      if (video.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA) {
        showVideo();
      } else {
        keepPlaceholder();
        video.load();
      }

      void video.play().catch(() => {
        keepPlaceholder();
      });
    });
  };

  initCaseStudyVideos();
  document.addEventListener('astro:page-load', initCaseStudyVideos);
</script>

<style>
  .cs-project {
    width: min(100%, 1680px);
    max-width: min(100%, 1680px);
  }

  :global(.project-detail-page) > .cs-project {
    max-width: min(100%, 1680px);
  }

  .cs-layout {
    display: grid;
    grid-template-columns: minmax(18rem, 0.72fr) minmax(0, 1.58fr);
    gap: clamp(2rem, 4vw, 5rem);
    align-items: start;
  }

  .cs-sticky {
    position: sticky;
    top: clamp(4rem, 7vw, 5.5rem);
    min-width: 0;
  }

  .cs-intro {
    display: flex;
    flex-direction: column;
    gap: clamp(0.95rem, 1.4vw, 1.25rem);
    padding: clamp(0.35rem, 1.2vw, 1rem) 0;
  }

  .cs-title {
    color: var(--text-primary);
    font-size: clamp(2.5rem, 4.5vw, 5rem);
    line-height: 0.94;
    letter-spacing: 0.02em;
  }

  .cs-title-sub {
    display: block;
    font-size: clamp(1.1rem, 2.2vw, 2.3rem);
    line-height: 1.2;
    margin-top: 0.32em;
    letter-spacing: 0.04em;
  }

  .cs-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .cs-tags li {
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 0.42rem 0.7rem;
    color: var(--text-primary);
    font-family: var(--font-family-display);
    font-size: 0.78rem;
    line-height: 1;
    text-transform: uppercase;
  }

  .cs-meta,
  .cs-block__body {
    color: var(--text-secondary);
    font-family: 'Red Hat Text', sans-serif;
    font-size: clamp(0.92rem, 0.95vw, 1rem);
    font-weight: 300;
    line-height: 1.6;
  }

  .cs-meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    max-width: 33ch;
  }

  .cs-meta p,
  .cs-block__body p {
    margin: 0;
  }

  .cs-meta i {
    color: var(--text-primary);
    font-style: italic;
    text-transform: uppercase;
  }

  .cs-meta a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .cs-flow {
    display: grid;
    gap: clamp(2.4rem, 6vw, 4.5rem);
    min-width: 0;
  }

  .cs-hero {
    position: relative;
    display: block;
    margin: 0;
    overflow: hidden;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
  }

  .cs-hero-placeholder,
  .cs-hero-video {
    display: block;
    width: 100%;
    height: auto;
  }

  .cs-hero-placeholder {
    position: absolute;
    inset: 0;
    height: 100%;
    object-fit: cover;
    z-index: 1;
    transition: opacity 180ms ease;
  }

  .cs-hero-video {
    z-index: 2;
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .cs-hero.is-video-ready .cs-hero-video {
    opacity: 1;
  }

  .cs-hero.is-video-ready .cs-hero-placeholder {
    opacity: 0;
    visibility: hidden;
  }

  .cs-study-card {
    display: flex;
    flex-direction: column;
    gap: clamp(2.4rem, 6vw, 4.5rem);
    padding: clamp(1.4rem, 2.8vw, 2.4rem);
    background: var(--palette-white);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
  }

  .cs-block__title {
    margin: 0;
    color: var(--text-primary);
    font-family: var(--font-family-display);
    font-size: clamp(1.1rem, 1.9vw, 1.7rem);
    font-weight: 400;
    letter-spacing: 0.04em;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .cs-block__rule {
    width: 100%;
    height: 0;
    margin: clamp(0.8rem, 1.6vw, 1.2rem) 0 clamp(1.2rem, 2.6vw, 2rem);
    border: 0;
    border-top: 1px solid color-mix(in srgb, var(--text-primary) 26%, transparent);
  }

  .cs-block__body {
    display: flex;
    width: min(100%, 62ch);
    margin-left: auto;
    flex-direction: column;
    gap: 1rem;
  }

  .cs-block__body p {
    font-size: 1rem;
    line-height: 1.65;
  }

  .cs-palette-card {
    overflow: hidden;
    border-radius: var(--project-card-radius);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
  }

  .cs-palette-grid {
    display: flex;
    width: 100%;
    min-height: clamp(300px, 34vw, 520px);
    flex-direction: row;
  }

  .cs-palette-swatch {
    position: relative;
    display: flex;
    min-width: 0;
    min-height: 100%;
    flex: 1 1 0;
    align-items: flex-end;
    transition:
      flex-grow 260ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 260ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 260ms ease;
  }

  .cs-palette-label {
    min-width: 0;
    padding: clamp(0.75rem, 1.4vw, 1rem) clamp(0.7rem, 1.6vw, 1.25rem);
    line-height: 1.25;
    letter-spacing: 0.01em;
    transition:
      padding 260ms cubic-bezier(0.22, 1, 0.36, 1),
      letter-spacing 260ms ease,
      transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .cs-palette-line {
    margin: 0;
    overflow-wrap: anywhere;
    font-size: clamp(0.68rem, 1.45vw, 0.9rem);
    font-weight: 300;
  }

  .cs-palette-swatch:hover {
    z-index: 1;
    flex-grow: 1.18;
    filter: saturate(1.08) brightness(1.02);
    transform: scale(1.035);
  }

  .cs-palette-swatch:hover .cs-palette-label {
    padding-block: 1.2rem;
    letter-spacing: 0.06em;
    transform: translateY(-2px);
  }

  .cs-palette-note {
    padding: clamp(1.4rem, 2.8vw, 2.4rem);
    background: var(--palette-white);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
  }

  .cs-palette-note p {
    margin: 0;
    color: var(--text-secondary);
    font-family: 'Red Hat Text', sans-serif;
    font-size: clamp(0.95rem, 1.1vw, 1.05rem);
    font-style: italic;
    font-weight: 300;
    line-height: 1.7;
  }

  .cs-screen-grid {
    display: grid;
    gap: clamp(2.4rem, 6vw, 4.5rem);
  }

  .cs-flow :global(.cs-picture) {
    display: block;
    overflow: hidden;
    border-radius: var(--project-card-radius);
    border: 1px solid var(--surface-muted);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
  }

  .cs-flow :global(.cs-screen) {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 980px) {
    .cs-layout {
      grid-template-columns: 1fr;
    }

    .cs-sticky {
      position: static;
    }

    .cs-title {
      font-size: clamp(2.7rem, 15vw, 4.8rem);
    }

    .cs-title-sub {
      font-size: clamp(0.95rem, 4vw, 1.6rem);
    }

    .cs-block__body {
      width: 100%;
      margin-left: 0;
    }

    .cs-palette-grid {
      min-height: auto;
      flex-direction: column;
    }

    .cs-palette-swatch {
      min-height: clamp(82px, 16vw, 120px);
    }

    .cs-palette-label {
      padding: 1rem 1.25rem;
    }

    .cs-palette-line {
      font-size: 0.9rem;
    }
  }

  @media (max-width: 620px) {
    .cs-project {
      padding-inline: 1rem;
    }
  }
</style>
