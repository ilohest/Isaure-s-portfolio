---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const sourceGlob = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/media-src/projects/web-dev/canpruna-accomodation/canpruna-full-*.png',
  { eager: true },
);

const getSrc = (n: number): ImageMetadata | undefined => {
  const key = `/src/assets/media-src/projects/web-dev/canpruna-accomodation/canpruna-full-${String(n).padStart(2, '0')}.png`;
  return sourceGlob[key]?.default;
};

const WIDTHS = [640, 960, 1280, 1920];
const SIZES = '(max-width: 767px) 80vw, 95vw';
const HERO_SIZES = '(min-width: 1280px) 64vw, (min-width: 970px) calc(100vw - 24rem), calc(100vw - 2rem)';

const paletteSwatches = [
  { hex: '#1B1816', rgb: '27, 24, 22', cmyk: '0, 11, 19, 89', textColor: '#FFFFFF' },
  { hex: '#272D20', rgb: '39, 45, 32', cmyk: '13, 0, 29, 82', textColor: '#FFFFFF' },
  { hex: '#ADB49E', rgb: '173, 180, 158', cmyk: '4, 0, 12, 29', textColor: '#000000' },
  { hex: '#F6F3EE', rgb: '246, 243, 238', cmyk: '0, 1, 3, 4', textColor: '#000000' },
  { hex: '#EBE4DA', rgb: '235, 228, 218', cmyk: '0, 3, 7, 8', textColor: '#000000' },
];

// Ordre original de la galerie (hors vidéo)
const IMG_ORDER = [1, 8, 2, 12, 9, 3, 13, 14, 10, 4, 11, 5, 6, 7];

type ResolvedImage = { type: 'image'; avifSrcset: string; webpSrcset: string; fallbackSrc: string; alt: string };
type VideoItem    = { type: 'video'; src: string; alt: string };
type MediaItem    = ResolvedImage | VideoItem;

// Génère avif + webp pour chaque image en parallèle
const resolved = await Promise.all(
  IMG_ORDER.map(async (n) => {
    const src = getSrc(n);
    if (!src) return null;
    const [avif, webp] = await Promise.all([
      getImage({ src, widths: WIDTHS, format: 'avif' }),
      getImage({ src, widths: WIDTHS, format: 'webp' }),
    ]);
    return {
      type: 'image' as const,
      avifSrcset: avif.srcSet.attribute,
      webpSrcset: webp.srcSet.attribute,
      fallbackSrc: webp.src,
      alt: `Can Pruna portfolio image ${n}`,
    };
  })
);

// Reconstruit le tableau avec la vidéo en deuxième position
const media: MediaItem[] = [];
for (let i = 0; i < resolved.length; i++) {
  if (i === 1) {
    media.push({ type: 'video', src: '/media/videos/canpruna-gallery.mp4', alt: 'Can Pruna gallery video' });
  }
  const item = resolved[i];
  if (item) media.push(item);
}

const hero = resolved[0];
---

<section class="canpruna-project relative flex flex-col">
  <div class="cpw-intro-layout">
    <aside class="cpw-sticky">
      <header class="cpw-headline">
        <h1 id="canpruna-title" class="project-title-reveal font-display m-0 uppercase">
          <span class="project-title-reveal__inner">
            Can Pruna
            <span class="cpw-title-subword">ACCOMODATION</span>
          </span>
        </h1>
        <ul class="cpw-tags" aria-label="Project tags">
          <li>Nuxt</li>
          <li>Vue</li>
          <li>Hospitality</li>
        </ul>
        <div class="cpw-meta" aria-label="Project details">
          <p><i>Client: </i>Can Pruna</p>
          <p><i>Sector: </i>Hospitality &amp; tourism</p>
          <p><i>Country: </i>Spain</p>
          <p><i>Format: </i>Bilingual website</p>
          <p>
            <i>URL: </i>
            <a href="https://canprunaderiells.es/" target="_blank" rel="noopener noreferrer">
              canprunaderiells.es
            </a>
          </p>
        </div>
      </header>
    </aside>

    <div class="cpw-main-flow">
      {hero && (
        <figure class="cpw-hero">
          <picture>
            <source type="image/avif" srcset={hero.avifSrcset} sizes={HERO_SIZES} />
            <source type="image/webp" srcset={hero.webpSrcset} sizes={HERO_SIZES} />
            <img src={hero.fallbackSrc} alt="Can Pruna accommodation website overview" loading="eager" fetchpriority="high" decoding="async" />
          </picture>
        </figure>
      )}

      <div class="cpw-study">
        <div class="cpw-study-card masonry-reveal" style="--reveal-delay: 0ms">
          <article class="cpw-block">
            <h2 class="cpw-block__title">The project</h2>
            <hr class="cpw-block__rule" />
            <div class="cpw-block__body">
              <p>
                The website, built with Nuxt.js, Vue 3, and Vite, adapts seamlessly across desktop, tablet, and
                mobile screens, ensuring every visitor enjoys a smooth experience. An elegant, responsive photo
                gallery showcases the Masía's interiors and Montseny surroundings, while a custom map component
                pinpoints Can Pruna's location in the natural park. A dedicated testimonials section brings guest
                reviews to life, and a clear, user-friendly inquiry form makes it easy to send questions. The site
                is fully bilingual, offering content in Catalan and Spanish to serve its local audience. Under the
                hood, static-site generation and image optimization keep load times fast, while Vue's transition
                system adds subtle, polished interactions throughout.
              </p>
            </div>
          </article>

          <article class="cpw-block">
            <h2 class="cpw-block__title">Responsibilities</h2>
            <hr class="cpw-block__rule" />
            <div class="cpw-block__body">
              <p>
                Visual identity &amp; brand illustration - Web design personalization - Full-stack site
                development - Website launch - On-site photography &amp; retouching
              </p>
            </div>
          </article>
        </div>
      </div>

      <div class="palette-card masonry-reveal" role="group" aria-label="Can Pruna color palette" style="--reveal-delay: 120ms">
        <div class="palette-grid">
          {
            paletteSwatches.map((sw) => (
              <div class="palette-swatch" style={`background-color:${sw.hex};color:${sw.textColor}`}>
                <div class="palette-label">
                  <p class="palette-line">HEX {sw.hex}</p>
                  <p class="palette-line">RGB {sw.rgb}</p>
                  <p class="palette-line">CMYK {sw.cmyk}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <section class="canpruna-gallery" data-hscroll data-hscroll-mobile="stack" aria-label="Can Pruna project gallery">
        <div class="canpruna-gallery-stage" data-hscroll-stage>
          <div class="canpruna-gallery-viewport">
            <div class="canpruna-gallery-track" data-hscroll-track>
              {
                media.map((m) => (
                  <figure class="canpruna-gallery-item">
                    {m.type === 'video' ? (
                      <video class="canpruna-gallery-media" src={m.src} aria-label={m.alt} autoplay muted loop playsinline preload="metadata" />
                    ) : (
                      <picture>
                        <source type="image/avif" srcset={m.avifSrcset} sizes={SIZES} />
                        <source type="image/webp" srcset={m.webpSrcset} sizes={SIZES} />
                        <img class="canpruna-gallery-media" src={m.fallbackSrc} alt={m.alt} loading="lazy" decoding="async" />
                      </picture>
                    )}
                  </figure>
                ))
              }
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
</section>

<script>
  import '../../scripts/horizontal-scroll-gallery.ts';
  import '../../scripts/masonry-reveal.ts';
</script>

<style>
  :global(.project-detail-page) > .canpruna-project {
    width: 100%;
    max-width: min(100%, 1680px);
    margin-inline: auto;
    padding-inline: 20px;
    gap: clamp(2.5rem, 7vw, 5.5rem);
  }

  .cpw-intro-layout {
    display: grid;
    grid-template-columns: minmax(18rem, 0.72fr) minmax(0, 1.58fr);
    gap: clamp(2rem, 4vw, 5rem);
    align-items: start;
  }

  .cpw-sticky {
    position: sticky;
    top: clamp(4rem, 7vw, 5.5rem);
    min-width: 0;
  }

  .cpw-headline {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .cpw-headline h1 {
    max-width: 10ch;
    color: var(--text-primary);
    font-size: clamp(2.8rem, 8vw, 7.4rem);
    line-height: 0.9;
  }

  .cpw-title-subword {
    display: block;
    margin-top: 0.32em;
    font-size: clamp(1.1rem, 2.4vw, 2.3rem);
    letter-spacing: 0.04em;
    line-height: 1.2;
  }

  .cpw-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .cpw-tags li {
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 0.42rem 0.7rem;
    color: var(--text-primary);
    font-family: var(--font-family-display);
    font-size: 0.78rem;
    line-height: 1;
    text-transform: uppercase;
  }

  .cpw-meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    max-width: 31ch;
    color: var(--text-secondary);
    font-family: var(--font-family-body);
    font-size: 0.95rem;
    font-weight: 300;
    line-height: 1.45;
  }

  .cpw-meta p {
    margin: 0;
  }

  .cpw-meta i {
    color: var(--text-primary);
    font-style: italic;
    text-transform: uppercase;
  }

  .cpw-meta a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .cpw-main-flow {
    --cpw-study-gap: clamp(2.4rem, 6vw, 4.5rem);

    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: var(--cpw-study-gap);
  }

  .cpw-hero {
    margin: 0;
    overflow: hidden;
    border-radius: var(--project-card-radius);
    background: #fff;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
  }

  .cpw-hero picture,
  .cpw-hero img {
    display: block;
    width: 100%;
  }

  .cpw-study {
    display: flex;
    flex-direction: column;
    gap: var(--cpw-study-gap);
  }

  .cpw-study-card {
    display: flex;
    flex-direction: column;
    gap: clamp(2.4rem, 6vw, 4.5rem);
    padding: clamp(1.4rem, 2.8vw, 2.4rem);
    background: var(--palette-white);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
  }

  .cpw-built-title {
    margin: clamp(0.5rem, 2vw, 1.5rem) 0 0;
    color: var(--text-primary);
    font-size: clamp(2.2rem, 5.5vw, 4.6rem);
    line-height: 0.95;
  }

  .cpw-block__title {
    margin: 0;
    color: var(--text-primary);
    font-family: var(--font-family-display);
    font-size: clamp(1.1rem, 1.9vw, 1.7rem);
    font-weight: 400;
    letter-spacing: 0.04em;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .cpw-block__rule {
    width: 100%;
    height: 0;
    margin: clamp(0.8rem, 1.6vw, 1.2rem) 0 clamp(1.2rem, 2.6vw, 2rem);
    border: 0;
    border-top: 1px solid color-mix(in srgb, var(--text-primary) 26%, transparent);
  }

  .cpw-block__body {
    display: flex;
    width: min(100%, 62ch);
    margin-left: auto;
    flex-direction: column;
    gap: 1rem;
    color: var(--text-secondary);
    font-family: var(--font-family-body);
    font-weight: 300;
  }

  .cpw-block__body p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.65;
  }

  .palette-card {
    overflow: hidden;
    border-radius: var(--project-card-radius);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
  }

  .palette-grid {
    display: flex;
    width: 100%;
    min-height: clamp(360px, 42vw, 620px);
    flex-direction: row;
  }

  .palette-swatch {
    position: relative;
    display: flex;
    min-width: 0;
    min-height: 100%;
    flex: 1 1 0;
    align-items: flex-end;
    transition:
      flex-grow 260ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 260ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 260ms ease;
  }

  .palette-label {
    min-width: 0;
    padding: clamp(0.75rem, 1.4vw, 1rem) clamp(0.7rem, 1.6vw, 1.25rem);
    line-height: 1.25;
    letter-spacing: 0.01em;
    transition:
      padding 260ms cubic-bezier(0.22, 1, 0.36, 1),
      letter-spacing 260ms ease,
      transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .palette-line {
    margin: 0;
    overflow-wrap: anywhere;
    font-size: clamp(0.68rem, 1.45vw, 0.9rem);
    font-weight: 300;
  }

  .palette-swatch:hover {
    z-index: 1;
    flex-grow: 1.18;
    filter: saturate(1.08) brightness(1.02);
    transform: scale(1.035);
  }

  .palette-swatch:hover .palette-label {
    padding-block: 1.2rem;
    letter-spacing: 0.06em;
    transform: translateY(-2px);
  }

  .canpruna-gallery {
    position: relative;
    width: 100%;
    margin-top: calc(var(--cpw-study-gap) * -0.25);
  }

  .canpruna-gallery-stage {
    position: sticky;
    top: 1rem;
    width: 100%;
    overflow: hidden;
  }

  .canpruna-gallery-viewport {
    width: 100%;
    overflow: hidden;
    padding-block: 3rem 4.25rem;
  }

  .canpruna-gallery-track {
    display: flex;
    gap: 1.5rem;
    width: max-content;
    will-change: transform;
  }

  .canpruna-gallery-item {
    flex: 0 0 auto;
    margin: 0;
    height: min(68vh, 42rem);
    max-height: calc(100vh - 8rem);
    display: flex;
    align-items: center;
  }

  .canpruna-gallery-item picture {
    display: block;
    height: 100%;
  }

  .canpruna-gallery-media {
    display: block;
    width: auto;
    height: 100%;
    max-width: none;
    object-fit: cover;
    border-radius: var(--project-card-radius);
    background: #fff;
    box-shadow:
      0 22px 54px rgba(35, 35, 35, 0.11),
      0 6px 18px rgba(35, 35, 35, 0.06);
  }

  @media screen and (min-width: 768px) {
    .canpruna-gallery-track {
      gap: 2rem;
    }
    .canpruna-gallery-item {
      height: min(76vh, 48rem);
      max-height: calc(100vh - 10rem);
    }
  }

  @media (max-width: 960px) {
    .cpw-intro-layout {
      grid-template-columns: 1fr;
      gap: clamp(1.5rem, 5vw, 3rem);
    }

    .cpw-sticky {
      position: static;
    }

    .cpw-headline h1 {
      max-width: none;
      font-size: clamp(2.7rem, 15vw, 4.8rem);
    }

    .cpw-title-subword {
      font-size: clamp(0.95rem, 4vw, 1.6rem);
    }

    .cpw-block__body {
      width: 100%;
      margin-left: 0;
    }

    .palette-grid {
      min-height: auto;
      flex-direction: column;
    }

    .palette-swatch {
      min-height: clamp(82px, 16vw, 120px);
    }

    .palette-label {
      padding: 1rem 1.25rem;
    }

    .palette-line {
      font-size: 0.9rem;
    }
  }

  @media (max-width: 767px) {
    .canpruna-gallery {
      margin-top: var(--cpw-study-gap);
      height: auto !important;
    }

    .canpruna-gallery-stage {
      position: relative;
      top: auto !important;
      overflow: visible;
    }

    .canpruna-gallery-viewport {
      overflow: visible;
      padding-block: 0;
    }

    .canpruna-gallery-track {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      transform: none !important;
      will-change: auto;
    }

    .canpruna-gallery-item {
      width: 100%;
      height: auto;
      max-height: none;
      display: block;
    }

    .canpruna-gallery-item picture {
      height: auto;
    }

    .canpruna-gallery-media {
      width: 100%;
      height: auto;
      max-width: 100%;
    }
  }
</style>
