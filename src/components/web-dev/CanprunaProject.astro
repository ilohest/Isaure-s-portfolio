---
import ProjectSheet from '../v2/ProjectSheet.astro';
import type { SheetBlock } from './case-study';
import type { ImageMetadata } from 'astro';

const sourceGlob = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/media-src/projects/web-dev/canpruna-accomodation/canpruna-full-*.png',
  { eager: true },
);

const getSrc = (n: number): ImageMetadata =>
  sourceGlob[`/src/assets/media-src/projects/web-dev/canpruna-accomodation/canpruna-full-${String(n).padStart(2, '0')}.png`]
    ?.default;

const palette = [
  { hex: '#1B1816', rgb: '27, 24, 22', cmyk: '0, 11, 19, 89', textColor: '#FFFFFF' },
  { hex: '#272D20', rgb: '39, 45, 32', cmyk: '13, 0, 29, 82', textColor: '#FFFFFF' },
  { hex: '#ADB49E', rgb: '173, 180, 158', cmyk: '4, 0, 12, 29', textColor: '#000000' },
  { hex: '#F6F3EE', rgb: '246, 243, 238', cmyk: '0, 1, 3, 4', textColor: '#000000' },
  { hex: '#EBE4DA', rgb: '235, 228, 218', cmyk: '0, 3, 7, 8', textColor: '#000000' },
];

// Ordre original de la galerie (hors vidéo)
const IMG_ORDER = [1, 8, 2, 12, 9, 3, 13, 14, 10, 4, 11, 5, 6, 7];

const gallery: SheetBlock[] = [];
IMG_ORDER.forEach((n, i) => {
  if (i === 1) gallery.push({ type: 'video', src: '/media/videos/canpruna-gallery.mp4', alt: 'Can Pruna gallery video' });
  gallery.push({ type: 'image', src: getSrc(n), alt: `Can Pruna portfolio image ${n}` });
});

const blocks: SheetBlock[] = [
  { type: 'image', src: getSrc(1), alt: 'Can Pruna accommodation website overview' },
  { type: 'palette', swatches: palette, label: 'Can Pruna color palette' },
  ...gallery,
];

const { year = '', others = [] } = Astro.props;
---

<ProjectSheet
  year={year}
  others={others}
  title="Can Pruna"
  subtitle="ACCOMODATION"
  sector="Hospitality & tourism"
  country="Spain"
  format="Bilingual website"
  tags={['Nuxt', 'Vue', 'Hospitality']}
  url={{ href: 'https://canprunaderiells.es/', label: 'canprunaderiells.es' }}
  projectParagraphs={[
    "The website, built with Nuxt.js, Vue 3, and Vite, adapts seamlessly across desktop, tablet, and mobile screens, ensuring every visitor enjoys a smooth experience. An elegant, responsive photo gallery showcases the Masía's interiors and Montseny surroundings, while a custom map component pinpoints Can Pruna's location in the natural park. A dedicated testimonials section brings guest reviews to life, and a clear, user-friendly inquiry form makes it easy to send questions. The site is fully bilingual, offering content in Catalan and Spanish to serve its local audience. Under the hood, static-site generation and image optimization keep load times fast, while Vue's transition system adds subtle, polished interactions throughout.",
  ]}
  responsibilities="Visual identity &amp; brand illustration - Web design personalization - Full-stack site development - Website launch - On-site photography &amp; retouching"
  blocks={blocks}
/>
