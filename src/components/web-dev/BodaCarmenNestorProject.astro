---
const M = '/assets/media/projects/web-dev/boda-carmen-nestor';

const screens = [
  { src: `${M}/bcn-screen-1.webp`, alt: 'Boda Carmen and Nestor — homepage', width: 1600, height: 835 },
  { src: `${M}/bcn-screen-2.webp`, alt: 'Boda Carmen and Nestor — wedding details', width: 1600, height: 837 },
  { src: `${M}/bcn-screen-3.webp`, alt: 'Boda Carmen and Nestor — RSVP form', width: 1600, height: 838 },
  { src: `${M}/bcn-screen-4.webp`, alt: 'Boda Carmen and Nestor — information', width: 1600, height: 839 },
];
---

<section class="bcn-project relative flex flex-col">
  <div class="bcn-intro-layout">
    <aside class="bcn-sticky">
      <header class="bcn-headline">
        <h1 class="project-title-reveal font-display m-0 uppercase">
          <span class="project-title-reveal__inner">Boda Carmen &amp; Nestor</span>
        </h1>
        <ul class="bcn-tags" aria-label="Project tags">
          <li>Squarespace</li>
          <li>Web design</li>
          <li>RSVP</li>
        </ul>
        <div class="bcn-meta" aria-label="Project details">
          <p><i>Client: </i>Carmen &amp; Nestor</p>
          <p><i>Sector: </i>Events / wedding</p>
          <p><i>Country: </i>Spain</p>
          <p><i>Format: </i>Custom wedding invitation website</p>
          <p><i>Credits: </i>Illustrations by HUECO Studio</p>
        </div>
      </header>
    </aside>

    <div class="bcn-main-flow">
      <figure class="bcn-hero">
        <img
          src={`${M}/bcn-phones-hero.webp`}
          alt="Boda Carmen and Nestor three-phone mockup"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width="1600"
          height="1067"
        />
      </figure>

      <div class="bcn-study">
        <div class="bcn-study-card masonry-reveal" style="--reveal-delay: 0ms">
          <article class="bcn-block">
            <h2 class="bcn-block__title">The project</h2>
            <hr class="bcn-block__rule" />
            <div class="bcn-block__body">
              <p>
                In a beautiful collaboration with HUECO Studio, I crafted a custom wedding invitation
                website for Carmen and Nestor. The project features a bold and passionate visual
                identity, with rich shades of red setting the tone throughout the site.
              </p>
              <p>
                The handcrafted illustrations by HUECO bring warmth and character, harmoniously woven
                into the overall design. The website includes all the key details about the celebration,
                alongside an RSVP form to simplify guest responses.
              </p>
              <p>Together, we created a digital space that feels both intimate and expressive.</p>
            </div>
          </article>

          <article class="bcn-block">
            <h2 class="bcn-block__title">Responsibilities</h2>
            <hr class="bcn-block__rule" />
            <div class="bcn-block__body">
              <p>Web design personalization - Squarespace setup - Site development - Website launch</p>
            </div>
          </article>

        </div>
      </div>

      <section class="bcn-showcase" aria-label="Boda Carmen and Nestor website screens">
        <div class="bcn-showcase__media">
          {screens.map((screen, i) => (
            <figure class="masonry-reveal" style={`--reveal-delay: ${i * 70}ms`}>
              <img
                src={screen.src}
                alt={screen.alt}
                loading="lazy"
                decoding="async"
                width={screen.width}
                height={screen.height}
              />
            </figure>
          ))}
        </div>
      </section>
    </div>
  </div>
</section>

<script>
  import '../../scripts/masonry-reveal.ts';
</script>

<style>
  :global(.project-detail-page) > .bcn-project {
    width: 100%;
    max-width: min(100%, 1680px);
    margin-inline: auto;
    padding-inline: 20px;
    gap: clamp(2.5rem, 7vw, 5.5rem);
  }

  .bcn-intro-layout {
    display: grid;
    grid-template-columns: minmax(18rem, 0.72fr) minmax(0, 1.58fr);
    gap: clamp(2rem, 4vw, 5rem);
    align-items: start;
  }

  .bcn-sticky {
    position: sticky;
    top: clamp(1rem, 3vw, 2.5rem);
    min-width: 0;
  }

  .bcn-headline {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .bcn-headline h1 {
    max-width: 10ch;
    color: var(--text-primary);
    font-size: clamp(2.8rem, 8vw, 7.4rem);
    line-height: 0.9;
  }

  .bcn-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .bcn-tags li {
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 0.42rem 0.7rem;
    color: var(--text-primary);
    font-family: var(--font-family-display);
    font-size: 0.78rem;
    line-height: 1;
    text-transform: uppercase;
  }

  .bcn-meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    max-width: 31ch;
    color: var(--text-secondary);
    font-family: var(--font-family-body);
    font-size: 0.95rem;
    font-weight: 300;
    line-height: 1.45;
  }

  .bcn-meta p {
    margin: 0;
  }

  .bcn-meta i {
    color: var(--text-primary);
    font-style: italic;
    text-transform: uppercase;
  }

  .bcn-meta a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .bcn-main-flow {
    --bcn-study-gap: clamp(2.4rem, 6vw, 4.5rem);

    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: var(--bcn-study-gap);
  }

  .bcn-hero {
    margin: 0;
    overflow: hidden;
    border-radius: var(--project-card-radius);
  }

  .bcn-hero img {
    display: block;
    width: 100%;
    height: auto;
  }

  .bcn-study {
    display: flex;
    flex-direction: column;
    gap: var(--bcn-study-gap);
  }

  .bcn-study-card {
    display: flex;
    flex-direction: column;
    gap: clamp(2.4rem, 6vw, 4.5rem);
    padding: clamp(1.4rem, 2.8vw, 2.4rem);
    background: var(--palette-white);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
  }

  .bcn-built-title {
    margin: clamp(0.5rem, 2vw, 1.5rem) 0 0;
    color: var(--text-primary);
    font-size: clamp(2.2rem, 5.5vw, 4.6rem);
    line-height: 0.95;
  }

  .bcn-block__title {
    margin: 0;
    color: var(--text-primary);
    font-family: var(--font-family-display);
    font-size: clamp(1.1rem, 1.9vw, 1.7rem);
    font-weight: 400;
    letter-spacing: 0.04em;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .bcn-block__rule {
    width: 100%;
    height: 0;
    margin: clamp(0.8rem, 1.6vw, 1.2rem) 0 clamp(1.2rem, 2.6vw, 2rem);
    border: 0;
    border-top: 1px solid color-mix(in srgb, var(--text-primary) 26%, transparent);
  }

  .bcn-block__body {
    display: flex;
    width: min(100%, 62ch);
    margin-left: auto;
    flex-direction: column;
    gap: 1rem;
    color: var(--text-secondary);
    font-family: var(--font-family-body);
    font-weight: 300;
  }

  .bcn-block__body p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.65;
  }

  .bcn-showcase {
    width: 100%;
  }

  .bcn-showcase__media {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: var(--bcn-study-gap);
  }

  .bcn-showcase__media figure {
    margin: 0;
    overflow: hidden;
    border-radius: var(--project-card-radius);
    background: #641a18;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
  }

  .bcn-showcase__media img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 960px) {
    .bcn-intro-layout {
      grid-template-columns: 1fr;
      gap: clamp(1.5rem, 5vw, 3rem);
    }

    .bcn-sticky {
      position: static;
    }

    .bcn-headline h1 {
      max-width: none;
      font-size: clamp(2.7rem, 15vw, 4.8rem);
    }

    .bcn-block__body {
      width: 100%;
      margin-left: 0;
    }
  }
</style>
