---
import ProjectSheet from '../v2/ProjectSheet.astro';
import type { SheetBlock } from './case-study';

import type { ImageMetadata } from 'astro';

const images = import.meta.glob<ImageMetadata>(
  '/src/assets/media-src/projects/web-dev/boda-carmen-nestor/*.webp',
  { eager: true, import: 'default' },
);
const pic = (base: string): ImageMetadata =>
  images[`/src/assets/media-src/projects/web-dev/boda-carmen-nestor/${base}.webp`];

const blocks: SheetBlock[] = [
  { type: 'image', src: pic('bcn-phones-hero'), alt: 'Boda Carmen and Nestor three-phone mockup' },
  { type: 'image', src: pic('bcn-screen-1'), alt: 'Boda Carmen and Nestor — homepage' },
  { type: 'image', src: pic('bcn-screen-2'), alt: 'Boda Carmen and Nestor — wedding details' },
  { type: 'image', src: pic('bcn-screen-3'), alt: 'Boda Carmen and Nestor — RSVP form' },
  { type: 'image', src: pic('bcn-screen-4'), alt: 'Boda Carmen and Nestor — information' },
];

const { year = '', others = [] } = Astro.props;
---

<ProjectSheet
  year={year}
  others={others}
  title="Boda Carmen & Nestor"
  sector="Weddings & events"
  country="Spain"
  format="Custom wedding invitation website"
  tags={['Squarespace', 'Web design', 'RSVP']}
  projectParagraphs={[
    'In a beautiful collaboration with HUECO Studio, I crafted a custom wedding invitation website for Carmen and Nestor. The project features a bold and passionate visual identity, with rich shades of red setting the tone throughout the site.',
    'The handcrafted illustrations by HUECO bring warmth and character, harmoniously woven into the overall design. The website includes all the key details about the celebration, alongside an RSVP form to simplify guest responses.',
    'Together, we created a digital space that feels both intimate and expressive.',
  ]}
  responsibilities="Web design personalization - Squarespace setup - Site development - Website launch"
  blocks={blocks}
  showContext={true}
/>
