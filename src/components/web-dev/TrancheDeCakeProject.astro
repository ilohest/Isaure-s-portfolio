---
import ProjectSheet from '../v2/ProjectSheet.astro';
import type { SheetBlock } from './case-study';
import type { ImageMetadata } from 'astro';

const images = import.meta.glob<ImageMetadata>('/src/assets/media-src/projects/web-dev/tranche-de-cake/*.avif', {
  eager: true,
  import: 'default',
});
const pic = (base: string): ImageMetadata =>
  images[`/src/assets/media-src/projects/web-dev/tranche-de-cake/${base}.avif`];

const M = '/assets/media/projects/web-dev/tranche-de-cake';
const img = (base: string, alt: string): SheetBlock => ({ type: 'image', src: pic(base), alt });

const blocks: SheetBlock[] = [
  img('mockup-tdc-desktop1', 'Tranche de CaKe desktop view 1'),
  img('mockup-tdc-desktop5', 'Tranche de CaKe desktop view 2'),
  img('mockup-tdc-phone1', 'Tranche de CaKe mobile view'),
  {
    type: 'video',
    src: '/media/videos/video-tdc-accueil.mp4',
    poster: `${M}/tdc-desktop1-960.avif`,
    alt: 'Tranche de CaKe, la révolution de la collation',
  },
  { type: 'text', paragraphs: ['Tranche de CaKe, la révolution de la collation'] },
  img('tdc-desktop5', 'Tranche de CaKe desktop view'),
  img('tdc-desktop2', 'Tranche de CaKe desktop view'),
  img('tdc-desktop3', 'Tranche de CaKe desktop view'),
  {
    type: 'text',
    paragraphs: [
      "The website features an intuitive and user-friendly interface for customizing weekly snack boxes, allowing customers to select from a curated range of artisanal snacks to fill their box. To ensure a full and satisfying experience, each box must contain exactly 10 snacks before the purchase option becomes available.",
      "This design choice not only enhances user engagement by encouraging exploration of different snacks but also minimizes order errors, ensuring that every box ordered meets the startup's quality standards. This personalized approach to ordering allows users to tailor their weekly deliveries to their specific tastes, making each delivery a unique culinary adventure.",
    ],
  },
  img('tdc-desktop4', 'Tranche de CaKe desktop view'),
  {
    type: 'text',
    paragraphs: [
      'The Tranche de Cake ecommerce website includes a fully integrated backoffice system designed to streamline operations and enhance management efficiency for our client. This backoffice suite provides robust tools for order processing, inventory management, and customer relations. It allows for real-time tracking of sales trends and inventory levels, ensuring that our client can make informed decisions quickly. Additionally, the system supports promotional and marketing activities, enabling personalized customer engagements and targeted campaigns. This comprehensive backoffice solution empowers our client to maintain a high level of service quality while optimizing operational workflows.',
    ],
  },
  img('tdc-phone2', 'Tranche de CaKe mobile view'),
  img('tdc-phone5', 'Tranche de CaKe mobile view'),
  img('tdc-phone4', 'Tranche de CaKe mobile view'),
  img('tdc-phone6', 'Tranche de CaKe mobile view'),
];

const { year = '', others = [] } = Astro.props;
---

<ProjectSheet
  year={year}
  others={others}
  title="Tranche de CaKe"
  url={{ href: 'https://tranchedecake.be/', label: 'tranchedecake.be' }}
  projectParagraphs={[
    "For this e-commerce project, I collaborated with Belgian founders, Arnaud and Virginie, to create an online platform that offers a diverse range of handcrafted snacks delivered directly to customers' doors. The site features a minimalist design aesthetic with an earthy color palette of terracotta, orange, and chocolate brown that enhances the artisanal feel of the products. I focused on a simple, intuitive interface that reflects the homemade nature of the offer. Through this platform, Tranche de CaKe delivers convenience, variety, and the richness of authentic, homemade snacks to a broad audience.",
  ]}
  responsibilities="Web design personalization, Shopify setup, site development and features personalization, website launch."
  blocks={blocks}
  showContext={false}
/>
