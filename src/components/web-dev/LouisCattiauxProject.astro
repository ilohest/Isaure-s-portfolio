---
const M = '/assets/media/projects/web-dev/louis-cattiaux';

const desktopImages = [
  { src: 'lc-screen-1.webp', width: 1600, height: 814, alt: "Louis Cattiaux archive homepage" },
  { src: 'lc-screen-2.webp', width: 1600, height: 817, alt: "Louis Cattiaux biography and work overview" },
  { src: 'lc-screen-3.webp', width: 1600, height: 814, alt: 'Louis Cattiaux artwork gallery' },
  { src: 'lc-screen-4.webp', width: 1600, height: 819, alt: 'Louis Cattiaux press and publication archive' },
  { src: 'lc-screen-5.webp', width: 1600, height: 822, alt: 'Louis Cattiaux writings and correspondence index' },
  { src: 'lc-screen-6.webp', width: 1600, height: 816, alt: 'Louis Cattiaux literary work page' },
];

const mobileImages = [
  { name: 'lc-mobile-image1', alt: "Louis Cattiaux mobile homepage" },
  { name: 'lc-mobile-image2', alt: 'Louis Cattiaux mobile artwork view' },
  { name: 'lc-mobile-image3', alt: 'Louis Cattiaux mobile archive navigation' },
  { name: 'lc-mobile-image4', alt: 'Louis Cattiaux mobile content page' },
];

const paletteSwatches = [
  { hex: '#272434', rgb: '39, 36, 52', cmyk: '25, 31, 0, 80', textColor: '#FFFFFF' },
  { hex: '#31778E', rgb: '49, 119, 142', cmyk: '65, 16, 0, 44', textColor: '#FFFFFF' },
  { hex: '#9ECECE', rgb: '158, 206, 206', cmyk: '23, 0, 0, 19', textColor: '#000000' },
  { hex: '#D6F1EB', rgb: '214, 241, 235', cmyk: '11, 0, 2, 5', textColor: '#000000' },
  { hex: '#AB5577', rgb: '171, 85, 119', cmyk: '0, 50, 30, 33', textColor: '#FFFFFF' },
  { hex: '#F14B26', rgb: '241, 75, 38', cmyk: '0, 69, 84, 5', textColor: '#000000' },
];

const responsiveSrcset = (name: string) =>
  [640, 960, 1280, 1920].map((width) => `${M}/${name}-${width}.avif ${width}w`).join(', ');
---

<section class="lc-project relative flex flex-col">
  <div class="lc-intro-layout">
    <aside class="lc-sticky">
      <header class="lc-headline">
        <h1 id="louis-cattiaux-title" class="project-title-reveal font-display m-0 uppercase">
          <span class="project-title-reveal__inner">Louis Cattiaux</span>
        </h1>
        <ul class="lc-tags" aria-label="Project tags">
          <li>WordPress</li>
          <li>Archive</li>
          <li>Multilingual</li>
        </ul>
        <div class="lc-meta" aria-label="Project details">
          <p><i>Client: </i>Louis Cattiaux archives</p>
          <p><i>Sector: </i>Art &amp; literature</p>
          <p><i>Country: </i>Spain</p>
          <p><i>Format: </i>Multilingual WordPress archive</p>
          <p>
            <i>URL: </i>
            <a href="http://louiscattiaux.com" target="_blank" rel="noopener noreferrer">
              louiscattiaux.com
            </a>
          </p>
        </div>
      </header>
    </aside>

    <div class="lc-main-flow">
      <figure class="lc-hero">
        <img
          src={`${M}/louis-cattiaux-hero.webp`}
          alt="Louis Cattiaux archive website across desktop and mobile screens"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </figure>

      <div class="lc-study">
        <div class="lc-study-card masonry-reveal" style="--reveal-delay: 0ms">
          <article class="lc-block">
            <h2 class="lc-block__title">Project</h2>
            <hr class="lc-block__rule" />
            <div class="lc-block__body">
              <p>
                This website serves as a comprehensive portal dedicated to the life and works of Louis
                Cattiaux, an enigmatic figure in the realm of mystical and esoteric art. Designed as a
                digital archive, the site hosts an extensive collection of articles, essays, and analyses
                that explore Cattiaux's profound influence on spiritual art and thought. A curated gallery
                of high-resolution images showcases Cattiaux's most notable artworks, providing visitors
                with a visual understanding of his unique style and thematic preoccupations. This website is
                fully multilingual, allowing users to navigate in their preferred language, and it offers
                both a light and dark mode for an optimal viewing experience.
              </p>
            </div>
          </article>

          <article class="lc-block">
            <h2 class="lc-block__title">Responsibilities</h2>
            <hr class="lc-block__rule" />
            <div class="lc-block__body">
              <p>
                Web design personalization, WordPress installation and database setup, Site development,
                SEO optimization for improved visibility, Website launch, Client training on back-office
                management.
              </p>
            </div>
          </article>

        </div>
      </div>

      <section class="lc-showcase" aria-label="Louis Cattiaux archive screens">
        <figure class="lc-mobile-mockup masonry-reveal" style="--reveal-delay: 0ms">
          <img
            src={`${M}/lc-mobile-mockup.webp`}
            alt="Louis Cattiaux archive mobile screen mockups"
            loading="lazy"
            decoding="async"
          />
        </figure>

        <div class="palette-card masonry-reveal" role="group" aria-label="Louis Cattiaux color palette" style="--reveal-delay: 80ms">
          <div class="palette-grid">
            {
              paletteSwatches.map((sw) => (
                <div class="palette-swatch" style={`background-color:${sw.hex};color:${sw.textColor}`}>
                  <div class="palette-label">
                    <p class="palette-line">HEX {sw.hex}</p>
                    <p class="palette-line">RGB {sw.rgb}</p>
                    <p class="palette-line">CMYK {sw.cmyk}</p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <div class="lc-screen-grid" aria-label="Desktop archive pages">
          {
            desktopImages.map((img, i) => (
              <figure class="masonry-reveal" style={`--reveal-delay: ${(i % 3) * 70}ms`}>
                <img
                  src={`${M}/${img.src}`}
                  width={img.width}
                  height={img.height}
                  alt={img.alt}
                  loading={i < 2 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </figure>
            ))
          }
        </div>

        <div class="lc-mobile-grid" aria-label="Mobile archive pages">
          {
            mobileImages.map((img, i) => (
              <figure class="masonry-reveal" style={`--reveal-delay: ${i * 60}ms`}>
                <img
                  src={`${M}/${img.name}-960.avif`}
                  srcset={responsiveSrcset(img.name)}
                  sizes="(min-width: 1280px) 16vw, (min-width: 680px) 28vw, 42vw"
                  alt={img.alt}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            ))
          }
        </div>
      </section>
    </div>
  </div>
</section>

<script>
  import '../../scripts/masonry-reveal.ts';
</script>

<style>
  :global(.project-detail-page) > .lc-project {
    width: 100%;
    max-width: min(100%, 1680px);
    margin-inline: auto;
    padding-inline: 20px;
    gap: clamp(2.5rem, 7vw, 5.5rem);
    color: var(--text-primary);
  }

  .lc-intro-layout {
    display: grid;
    grid-template-columns: minmax(18rem, 0.72fr) minmax(0, 1.58fr);
    gap: clamp(2rem, 4vw, 5rem);
    align-items: start;
  }

  .lc-sticky {
    position: sticky;
    top: clamp(1rem, 3vw, 2.5rem);
    min-width: 0;
  }

  .lc-headline {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .lc-headline h1 {
    max-width: 11ch;
    margin-left: -0.08em;
    padding-left: 0.08em;
    color: var(--text-primary);
    font-size: clamp(2.45rem, 6.2vw, 5.8rem);
    line-height: 0.9;
  }

  .lc-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .lc-tags li {
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 0.42rem 0.7rem;
    color: var(--text-primary);
    font-family: var(--font-family-display);
    font-size: 0.78rem;
    line-height: 1;
    text-transform: uppercase;
  }

  .lc-meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    max-width: 31ch;
    color: var(--text-secondary);
    font-family: var(--font-family-body);
    font-size: 0.95rem;
    font-weight: 300;
    line-height: 1.45;
  }

  .lc-meta p {
    margin: 0;
  }

  .lc-meta i {
    color: var(--text-primary);
    font-style: italic;
    text-transform: uppercase;
  }

  .lc-meta a {
    color: var(--text-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .lc-main-flow {
    --lc-study-gap: clamp(2.4rem, 6vw, 4.5rem);

    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: var(--lc-study-gap);
  }

  .lc-hero {
    margin: 0;
    overflow: hidden;
    border-radius: var(--project-card-radius);
    background: var(--surface-muted);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
  }

  .lc-hero img {
    display: block;
    width: 100%;
    height: auto;
  }

  .lc-study {
    display: flex;
    flex-direction: column;
    gap: var(--lc-study-gap);
  }

  .lc-study-card {
    display: flex;
    flex-direction: column;
    gap: clamp(2.4rem, 6vw, 4.5rem);
    padding: clamp(1.4rem, 2.8vw, 2.4rem);
    background: var(--palette-white);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
  }

  .lc-built-title {
    margin: clamp(0.5rem, 2vw, 1.5rem) 0 0;
    color: var(--text-primary);
    font-size: clamp(2.2rem, 5.5vw, 4.6rem);
    line-height: 0.95;
  }

  .lc-block__title {
    margin: 0;
    color: var(--text-primary);
    font-family: var(--font-family-display);
    font-size: clamp(1.1rem, 1.9vw, 1.7rem);
    font-weight: 400;
    letter-spacing: 0.04em;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .lc-block__rule {
    width: 100%;
    height: 0;
    margin: clamp(0.8rem, 1.6vw, 1.2rem) 0 clamp(1.2rem, 2.6vw, 2rem);
    border: 0;
    border-top: 1px solid color-mix(in srgb, var(--text-primary) 26%, transparent);
  }

  .lc-block__body {
    display: flex;
    width: min(100%, 62ch);
    margin-left: auto;
    flex-direction: column;
    gap: 1rem;
    color: var(--text-secondary);
    font-family: var(--font-family-body);
    font-weight: 300;
  }

  .lc-block__body p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.65;
  }

  .palette-card {
    overflow: hidden;
    border-radius: var(--project-card-radius);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
  }

  .palette-grid {
    display: flex;
    width: 100%;
    min-height: clamp(360px, 42vw, 620px);
    flex-direction: row;
  }

  .palette-swatch {
    position: relative;
    display: flex;
    min-width: 0;
    min-height: 100%;
    flex: 1 1 0;
    align-items: flex-end;
    transition:
      flex-grow 260ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 260ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 260ms ease;
  }

  .palette-label {
    min-width: 0;
    padding: clamp(0.75rem, 1.4vw, 1rem) clamp(0.7rem, 1.6vw, 1.25rem);
    line-height: 1.25;
    letter-spacing: 0.01em;
    transition:
      padding 260ms cubic-bezier(0.22, 1, 0.36, 1),
      letter-spacing 260ms ease,
      transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .palette-line {
    margin: 0;
    overflow-wrap: anywhere;
    font-size: clamp(0.68rem, 1.45vw, 0.9rem);
    font-weight: 300;
  }

  .palette-swatch:hover {
    z-index: 1;
    flex-grow: 1.18;
    filter: saturate(1.08) brightness(1.02);
    transform: scale(1.035);
  }

  .palette-swatch:hover .palette-label {
    padding-block: 1.2rem;
    letter-spacing: 0.06em;
    transform: translateY(-2px);
  }

  .lc-showcase {
    display: flex;
    flex-direction: column;
    gap: var(--lc-study-gap);
    width: 100%;
  }

  .lc-mobile-mockup,
  .lc-screen-grid figure,
  .lc-mobile-grid figure {
    margin: 0;
    overflow: hidden;
    border-radius: var(--project-card-radius);
    background: var(--surface-muted);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
  }

  .lc-mobile-mockup {
    background: transparent;
    box-shadow: none;
  }

  .lc-mobile-mockup img,
  .lc-screen-grid img,
  .lc-mobile-grid img {
    display: block;
    width: 100%;
    height: auto;
  }

  .lc-screen-grid {
    display: flex;
    flex-direction: column;
    gap: var(--lc-study-gap);
  }

  .lc-mobile-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(0.8rem, 2vw, 1.4rem);
    align-items: start;
  }

  @media (max-width: 960px) {
    .lc-intro-layout {
      grid-template-columns: 1fr;
      gap: clamp(1.5rem, 5vw, 3rem);
    }

    .lc-sticky {
      position: static;
    }

    .lc-headline h1 {
      max-width: none;
      font-size: clamp(2.35rem, 11.5vw, 3.8rem);
    }

    .lc-block__body {
      width: 100%;
      margin-left: 0;
    }

    .lc-mobile-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .palette-grid {
      min-height: auto;
      flex-direction: column;
    }

    .palette-swatch {
      min-height: clamp(82px, 16vw, 120px);
    }

    .palette-label {
      padding: 1rem 1.25rem;
    }

    .palette-line {
      font-size: 0.9rem;
    }
  }

  @media (max-width: 640px) {
    :global(.project-detail-page) > .lc-project {
      padding-inline: 16px;
    }
  }
</style>
