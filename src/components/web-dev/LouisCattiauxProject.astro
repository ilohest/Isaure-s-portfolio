---
import ProjectSheet from '../v2/ProjectSheet.astro';
import type { SheetBlock } from './case-study';
import type { ImageMetadata } from 'astro';

const images = import.meta.glob<ImageMetadata>('/src/assets/media-src/projects/web-dev/louis-cattiaux/*.{webp,avif}', {
  eager: true,
  import: 'default',
});
const pic = (file: string): ImageMetadata => images[`/src/assets/media-src/projects/web-dev/louis-cattiaux/${file}`];

const paletteSwatches = [
  { hex: '#272434', rgb: '39, 36, 52', cmyk: '25, 31, 0, 80', textColor: '#FFFFFF' },
  { hex: '#31778E', rgb: '49, 119, 142', cmyk: '65, 16, 0, 44', textColor: '#FFFFFF' },
  { hex: '#9ECECE', rgb: '158, 206, 206', cmyk: '23, 0, 0, 19', textColor: '#000000' },
  { hex: '#D6F1EB', rgb: '214, 241, 235', cmyk: '11, 0, 2, 5', textColor: '#000000' },
  { hex: '#AB5577', rgb: '171, 85, 119', cmyk: '0, 50, 30, 33', textColor: '#FFFFFF' },
  { hex: '#F14B26', rgb: '241, 75, 38', cmyk: '0, 69, 84, 5', textColor: '#000000' },
];

const blocks: SheetBlock[] = [
  { type: 'image', src: pic('louis-cattiaux-hero.webp'), alt: 'Louis Cattiaux archive website across desktop and mobile screens' },
  { type: 'image', src: pic('lc-mobile-mockup.webp'), alt: 'Louis Cattiaux archive mobile screen mockups' },
  { type: 'palette', swatches: paletteSwatches, label: 'Louis Cattiaux color palette' },
  { type: 'image', src: pic('lc-screen-1.webp'), alt: 'Louis Cattiaux archive homepage' },
  { type: 'image', src: pic('lc-screen-2.webp'), alt: 'Louis Cattiaux biography and work overview' },
  { type: 'image', src: pic('lc-screen-3.webp'), alt: 'Louis Cattiaux artwork gallery' },
  { type: 'image', src: pic('lc-screen-4.webp'), alt: 'Louis Cattiaux press and publication archive' },
  { type: 'image', src: pic('lc-screen-5.webp'), alt: 'Louis Cattiaux writings and correspondence index' },
  { type: 'image', src: pic('lc-screen-6.webp'), alt: 'Louis Cattiaux literary work page' },
  { type: 'image', src: pic('lc-mobile-image1.avif'), alt: 'Louis Cattiaux mobile homepage' },
  { type: 'image', src: pic('lc-mobile-image2.avif'), alt: 'Louis Cattiaux mobile artwork view' },
  { type: 'image', src: pic('lc-mobile-image3.avif'), alt: 'Louis Cattiaux mobile archive navigation' },
  { type: 'image', src: pic('lc-mobile-image4.avif'), alt: 'Louis Cattiaux mobile content page' },
];

const { year = '', others = [] } = Astro.props;
---

<ProjectSheet
  year={year}
  others={others}
  title="Louis Cattiaux"
  sector="Art & literature"
  country="Spain"
  format="Multilingual WordPress archive"
  tags={['WordPress', 'Archive', 'Multilingual']}
  url={{ href: 'http://louiscattiaux.com', label: 'louiscattiaux.com' }}
  projectParagraphs={[
    "This website serves as a comprehensive portal dedicated to the life and works of Louis Cattiaux, an enigmatic figure in the realm of mystical and esoteric art. Designed as a digital archive, the site hosts an extensive collection of articles, essays, and analyses that explore Cattiaux's profound influence on spiritual art and thought. A curated gallery of high-resolution images showcases Cattiaux's most notable artworks, providing visitors with a visual understanding of his unique style and thematic preoccupations. This website is fully multilingual, allowing users to navigate in their preferred language, and it offers both a light and dark mode for an optimal viewing experience.",
  ]}
  responsibilities="Web design personalization, WordPress installation and database setup, Site development, SEO optimization for improved visibility, Website launch, Client training on back-office management."
  blocks={blocks}
  showContext={true}
/>
