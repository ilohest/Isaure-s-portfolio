---
import ResponsiveImage from '../media/ResponsiveImage.astro';
import type { ImageMetadata } from 'astro';

const images = import.meta.glob<ImageMetadata>(
  '/src/assets/media-src/projects/web-dev/client-lawyer-platform/*.png',
  { eager: true, import: 'default' },
);
const pic = (base: string): ImageMetadata =>
  images[`/src/assets/media-src/projects/web-dev/client-lawyer-platform/${base}.png`];

const decisions = [
  {
    title: 'One matter, several views',
    text: 'I structured the product around a shared legal matter, then adapted its information and actions to each role and permission level.',
  },
  {
    title: 'Plain language first',
    text: 'The intake starts with a life situation or a description in the client’s own words, rather than requiring legal terminology.',
  },
  {
    title: 'Visible next steps',
    text: 'Statuses, deadlines and pending actions make long legal processes easier to scan without flattening their complexity.',
  },
  {
    title: 'Scoped collaboration',
    text: 'Delegation is attached to a specific opinion, hearing or submission, preserving both confidentiality and traceability.',
  },
];

const technicalGroups = [
  {
    title: 'Product interface',
    text: 'Vue 3, TypeScript, Pinia, PrimeVue, Vue I18n, FullCalendar and Socket.IO.',
  },
  {
    title: 'Application architecture',
    text: 'Node.js, Express, PostgreSQL, Drizzle and shared domain rules used by the frontend and backend.',
  },
  {
    title: 'Security & reliability',
    text: 'Matter-level access control, runtime validation, MFA flows, file validation, antivirus scanning, monitoring and automated tests.',
  },
  {
    title: 'Legal workflows',
    text: 'Structured states, scheduling rules, real-time updates and generated documents support matters as they progress over time.',
  },
];

const screens = [
  {
    base: '01-accueil-hero',
    alt: 'Public homepage inviting clients to describe their legal situation',
    caption: 'Public homepage — an approachable entry point built around everyday language.',
  },
  {
    base: '02-parcours-situation',
    alt: 'Guided legal intake organised by everyday life situations',
    caption: 'Guided intake — legal classification stays behind a familiar, progressive interface.',
  },
  {
    base: '04-dossiers-client',
    alt: 'Client matter list with filters, statuses and pending actions',
    caption: 'Matter overview — compact statuses show what is happening and what needs attention.',
  },
  {
    base: '05-calendrier-client',
    alt: 'Client calendar combining consultations and court hearings',
    caption: 'Scheduling — consultations and hearings share one view, connected to availability rules and calendar constraints.',
  },
  {
    base: '06-missions-avocat',
    alt: 'Lawyer missions showing delegated and collaborative work',
    caption: 'Lawyer missions — delegated work remains scoped to a specific task and traceable to its matter.',
  },
  {
    base: '07-fil-activite-dossier',
    alt: 'Chronological matter feed combining messages, documents and legal events',
    caption: 'Matter activity — messages, documents, events and approvals form one permission-aware chronology.',
  },
  {
    base: '03-page-partenaires',
    alt: 'Public partnership page for lawyers',
    caption: 'Lawyer-facing landing page — the same visual system, with a denser professional message.',
  },
];

const tags = ['Product design', 'Full-stack development', 'Legal tech'];
---

<section class="clp-project relative mx-auto px-4 py-4">
  <div class="clp-layout">
    <aside class="clp-sticky">
      <div class="clp-card-inner flex flex-col gap-4">
        <h1 class="project-title-reveal clp-title font-display m-0 uppercase">
          <span class="project-title-reveal__inner">Client–Lawyer Platform</span>
        </h1>

        <ul class="clp-tags" aria-label="Project tags">
          {tags.map((tag) => <li>{tag}</li>)}
        </ul>

        <div class="clp-meta" aria-label="Project details">
          <p><i>Sector: </i>Legal tech / law</p>
          <p><i>Country: </i>Belgium</p>
          <p><i>Format: </i>Multi-role web platform</p>
        </div>

        <div class="clp-copy">
          <p>
            I designed and developed a platform that brings clients, lawyers and law-firm teams into the same legal matter while giving each role a different level of information and control.
          </p>
          <p>
            I led the project team while contributing hands-on to the design of the business workflows, the UX/UI and the full-stack development of the platform, including role-based experiences, confidential document handling, real-time updates and scheduling.
          </p>
        </div>
      </div>
    </aside>

    <div class="project-screens">
      <figure class="clp-screen clp-screen--hero">
        <ResponsiveImage
          src={pic(screens[0].base)}
          alt={screens[0].alt}
          sizes="(min-width: 1280px) 1040px, (min-width: 970px) 64vw, 100vw"
          loading="eager"
          imgClass="project-screen"
        />
        <figcaption>{screens[0].caption}</figcaption>
      </figure>

      <section class="clp-feature-panel" aria-labelledby="clp-context-title">
        <h2 id="clp-context-title" class="clp-section-title">Project context</h2>
        <hr class="clp-feature-rule" />
        <div class="clp-context-copy">
          <p>
            Belgian legal work involves consultations, proceedings, hearings, written opinions, submissions, decisions, documents, fees, payments and legal aid. These activities are closely connected, but they are not viewed or handled in the same way by everyone involved.
          </p>
          <p>
            I used the legal matter as the central organising unit. Conversations, dates, documents, financial actions and professional work all connect back to it, while permissions determine what each person can see and do.
          </p>
        </div>
      </section>

      <figure class="clp-screen">
        <ResponsiveImage src={pic(screens[1].base)} alt={screens[1].alt} sizes="(min-width: 1280px) 1040px, (min-width: 970px) 64vw, 100vw" loading="lazy" imgClass="project-screen" />
        <figcaption>{screens[1].caption}</figcaption>
      </figure>

      <section class="clp-feature-panel" aria-labelledby="clp-decisions-title">
        <h2 id="clp-decisions-title" class="clp-section-title">Selected design decisions</h2>
        <hr class="clp-feature-rule" />
        <div class="clp-feature-list">
          {decisions.map((decision) => (
            <article class="clp-feature-item">
              <h3>{decision.title}</h3>
              <p>{decision.text}</p>
            </article>
          ))}
        </div>
      </section>

      {screens.slice(2, 6).map((screen) => (
        <figure class="clp-screen">
          <ResponsiveImage src={pic(screen.base)} alt={screen.alt} sizes="(min-width: 1280px) 1040px, (min-width: 970px) 64vw, 100vw" loading="lazy" imgClass="project-screen" />
          <figcaption>{screen.caption}</figcaption>
        </figure>
      ))}

      <section class="clp-feature-panel" aria-labelledby="clp-technical-title">
        <h2 id="clp-technical-title" class="clp-section-title">Technical approach</h2>
        <hr class="clp-feature-rule" />
        <div class="clp-feature-list">
          {technicalGroups.map((group) => (
            <article class="clp-feature-item">
              <h3>{group.title}</h3>
              <p>{group.text}</p>
            </article>
          ))}
        </div>
      </section>

      <figure class="clp-screen">
        <ResponsiveImage src={pic(screens[6].base)} alt={screens[6].alt} sizes="(min-width: 1280px) 1040px, (min-width: 970px) 64vw, 100vw" loading="lazy" imgClass="project-screen" />
        <figcaption>{screens[6].caption}</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .clp-project { width:min(100%,1680px); max-width:min(100%,1680px); }
  :global(.project-detail-page)>.clp-project { max-width:min(100%,1680px); }
  .clp-layout { display:grid; grid-template-columns:minmax(18rem,.72fr) minmax(0,1.58fr); gap:clamp(2rem,4vw,5rem); align-items:start; }
  .clp-sticky { position:sticky; top:clamp(1rem,3vw,2.5rem); min-width:0; }
  .clp-card-inner { gap:clamp(.95rem,1.4vw,1.25rem); padding:clamp(.35rem,1.2vw,1rem) 0; }
  .clp-title { max-width:12.5ch; color:var(--text-primary); font-size:clamp(2.4rem,5.4vw,5.8rem); line-height:.94; letter-spacing:.02em; }
  .clp-tags { display:flex; flex-wrap:wrap; gap:.5rem; padding:0; margin:0; list-style:none; }
  .clp-tags li { border:1px solid currentColor; border-radius:999px; padding:.42rem .7rem; color:var(--text-primary); font-family:var(--font-family-display); font-size:.78rem; line-height:1; text-transform:uppercase; }
  .clp-meta { display:flex; flex-direction:column; gap:.25rem; max-width:34ch; color:var(--text-secondary); font-family:var(--font-family-body); font-size:.95rem; font-weight:300; line-height:1.45; }
  .clp-meta p { margin:0; }
  .clp-meta i { color:var(--text-primary); font-style:italic; text-transform:uppercase; }
  .clp-copy,.clp-context-copy { color:var(--text-secondary); font-family:'Red Hat Text',sans-serif; font-weight:300; }
  .clp-copy p,.clp-context-copy p { margin:0; font-size:clamp(.95rem,1vw,1.05rem); line-height:1.6; }
  .clp-copy p+p,.clp-context-copy p+p { margin-top:1rem; }
  .project-screens { display:grid; gap:clamp(2rem,4.5vw,4.25rem); min-width:0; }
  .clp-feature-panel { padding:clamp(1.4rem,2.8vw,2.4rem); background:var(--palette-white); box-shadow:0 12px 32px rgba(0,0,0,.08); }
  .clp-section-title { margin:0; color:var(--text-primary); font-family:var(--font-family-display); font-size:clamp(1.1rem,1.9vw,1.7rem); font-weight:400; line-height:1.05; letter-spacing:.04em; text-transform:uppercase; }
  .clp-feature-rule { width:100%; height:0; margin:clamp(.8rem,1.6vw,1.2rem) 0 clamp(1.2rem,2.6vw,2rem); border:0; border-top:1px solid color-mix(in srgb,var(--text-primary) 26%,transparent); }
  .clp-feature-list { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:clamp(1.25rem,2.5vw,2.5rem) clamp(1.5rem,4vw,3.5rem); }
  .clp-feature-item { display:flex; flex-direction:column; gap:.55rem; margin:0; }
  .clp-feature-item h3 { display:flex; flex-direction:column; gap:.5rem; margin:0; color:var(--text-primary); font-size:clamp(.95rem,1vw,1.05rem); font-weight:400; line-height:1.1; }
  .clp-feature-item h3::after { content:''; display:block; width:100%; height:1px; background:color-mix(in srgb,var(--text-primary) 35%,transparent); }
  .clp-feature-item p { margin:0; color:var(--text-secondary); font-family:'Red Hat Text',sans-serif; font-size:clamp(.92rem,.95vw,1rem); font-weight:300; line-height:1.6; }
  .clp-screen { margin:0; }
  .clp-screen :global(.project-screen) { display:block; width:100%; height:auto; box-shadow:0 12px 32px rgba(0,0,0,.08); }
  .clp-screen figcaption { max-width:48rem; margin-top:.65rem; color:var(--text-secondary); font-family:'Red Hat Text',sans-serif; font-size:.82rem; font-weight:300; line-height:1.5; }
  @media(min-width:768px){ .clp-card-inner { padding-right:clamp(.5rem,1.5vw,1.5rem); } }
  @media(max-width:1100px){ .clp-layout { grid-template-columns:minmax(17rem,.8fr) minmax(0,1.2fr); gap:clamp(1.5rem,3vw,3rem); } .clp-title { font-size:clamp(2.25rem,5vw,4.6rem); } }
  @media(max-width:860px){ .clp-layout { grid-template-columns:1fr; } .clp-sticky { position:static; } .clp-card-inner { padding-right:0; } .clp-title { max-width:14ch; font-size:clamp(2.6rem,13vw,4.6rem); } }
  @media(max-width:560px){ .clp-project { padding-inline:1rem; } .clp-feature-panel { padding:1.25rem; } .clp-feature-list { grid-template-columns:1fr; } }
</style>
