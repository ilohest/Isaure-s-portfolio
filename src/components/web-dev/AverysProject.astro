---
import ProjectSheet from '../v2/ProjectSheet.astro';
import type { SheetBlock } from './case-study';

import type { ImageMetadata } from 'astro';

const images = import.meta.glob<ImageMetadata>(
  '/src/assets/media-src/projects/web-dev/averys/*.png',
  { eager: true, import: 'default' },
);
const pic = (base: string): ImageMetadata =>
  images[`/src/assets/media-src/projects/web-dev/averys/${base}.png`];

const swatches = [
  { hex: '#2E261F', rgb: '46, 38, 31', cmyk: '0, 17, 33, 82', textColor: '#F8F5F2' },
  { hex: '#4A403A', rgb: '74, 64, 58', cmyk: '0, 14, 22, 71', textColor: '#F8F5F2' },
  { hex: '#8E7D6F', rgb: '142, 125, 111', cmyk: '0, 12, 22, 44', textColor: '#F8F5F2' },
  { hex: '#D8CCC0', rgb: '216, 204, 192', cmyk: '0, 6, 11, 15', textColor: '#2E261F' },
  { hex: '#F8F5F2', rgb: '248, 245, 242', cmyk: '0, 1, 2, 3', textColor: '#2E261F' },
];

const img = (base: string, alt: string): SheetBlock => ({ type: 'image', src: pic(base), alt });
const vid = (n: number): SheetBlock => ({
  type: 'video',
  src: `/media/videos/averys-video${n}.mp4`,
  alt: `Averys motion sequence ${n}`,
});

const projectParagraphs = [
  'For Averys, I designed and developed an editorial website with a refined and immersive visual language. The approach focused on creating a strong sense of atmosphere through warm tones, expressive typography, generous spacing, and a carefully paced layout.',
  'The website was conceived as a visual system for curated event experiences: polished enough to feel premium, but flexible enough to support changing content, invitations, and presentation moments.',
];

const interactionParagraphs = [
  'I paid particular attention to motion and interaction design, using subtle reveals, layered animations, and fluid transitions to give the site depth and rhythm.',
  'The logo and visual details were designed alongside the interface, helping shape a cohesive identity across the full digital experience.',
  'The result is a polished and distinctive website that feels both elegant and contemporary, with a strong emphasis on visual composition, movement, and front-end detail.',
];

const blocks: SheetBlock[] = [
  img('group-32', 'Averys — editorial event branding cover'),
  img('group-36', 'A curated editorial homepage for Averys'),
  img('averys mockup2', 'Averys desktop mockup 2'),
  img('group-38', 'Averys — editorial branding composition'),
  img('group-35', 'Averys — visual identity composition'),
  img('logo2', 'Averys logo exploration 2'),
  { type: 'text', title: 'Project', paragraphs: projectParagraphs },
  { type: 'palette', swatches, label: 'Averys color palette' },
  vid(2),
  { type: 'text', title: 'Motion & identity', paragraphs: interactionParagraphs },
  vid(1),
  img('averys2', 'Averys interface detail 2'),
  vid(3),
  img('averys4', 'Averys interface detail 4'),
  vid(4),
  img('averys5', 'Averys interface detail 5'),
  vid(5),
  img('averys6', 'Averys interface detail 6'),
  vid(6),
];

const { year = '', others = [] } = Astro.props;
---

<ProjectSheet
  year={year}
  others={others}
  title="Averys"
  sector="Curated events"
  country="Belgium"
  format="Logo & Editorial website"
  tags={['Web design', 'Front-end', 'Editorial identity']}
  url={{ href: 'https://averys.app', label: 'averys.app' }}
  projectParagraphs={[projectParagraphs[0]]}
  responsibilities="Art direction - Logo design - Web design - UX/UI design - Front-end development - Animation design"
  blocks={blocks}
  showContext={false}
/>
