---
import ProjectSheet from '../v2/ProjectSheet.astro';
import type { SheetBlock } from './case-study';
import type { ImageMetadata } from 'astro';

const images = import.meta.glob<ImageMetadata>('/src/assets/media-src/projects/web-dev/boda-lis-pavlos/*.webp', {
  eager: true,
  import: 'default',
});
const pic = (base: string): ImageMetadata =>
  images[`/src/assets/media-src/projects/web-dev/boda-lis-pavlos/${base}.webp`];

const blocks: SheetBlock[] = [
  { type: 'image', src: pic('blp-phones-hero'), alt: 'Boda Lis & Pavlos — three-phone mockup' },
  { type: 'image', src: pic('blp-screen-1'), alt: 'Boda Lis & Pavlos — screen 1' },
  { type: 'video', src: '/media/videos/boda-lis-pavlos-admin.mp4', alt: 'Boda Lis & Pavlos — administration page' },
  { type: 'image', src: pic('blp-screen-2'), alt: 'Boda Lis & Pavlos — screen 2' },
  { type: 'image', src: pic('blp-screen-3'), alt: 'Boda Lis & Pavlos — screen 3' },
  { type: 'text', title: 'Credits', paragraphs: ['Client: Lis & Pavlos', 'Illustrations by La Invitación de Liana'] },
];

const responsibilities =
  'HTML, CSS, JavaScript development — server-side setup — custom illustration integration — hosting and domain configuration — website launch — post-launch support.';

const { year = '', others = [] } = Astro.props;
---

<ProjectSheet
  year={year}
  others={others}
  title="Boda Lis & Pavlos"
  sector="Weddings & events"
  format="Custom wedding website"
  tags={['Bespoke', 'Custom dev', 'RSVP']}
  url={{ href: 'https://pavlosandlis.com/', label: 'pavlosandlis.com' }}
  projectParagraphs={[
    "For this collaboration with La Invitación de Liana, I created a wedding website that celebrates both craftsmanship and digital elegance. Designed around the couple's vision, the site features a rich blend of soft animations and personalized illustrations, adding charm and personality to every section. Guests can explore the wedding details in an aesthetically balanced layout. A secure password-protected access ensures the privacy of all information, making the experience both intimate and exclusive. A private administration page for the couple includes tools to manage guest responses, export RSVP data to Excel format, and track total attendance.",
  ]}
  responsibilities={responsibilities}
  solutions={responsibilities.replace(/\.$/, '').split(/\s+—\s+/)}
  blocks={blocks}
/>
