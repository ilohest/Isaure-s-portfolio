---
const M = '/assets/media/projects/web-dev/boda-lis-pavlos';

type ShowcaseItem =
  | { type: 'image'; src: string; alt: string }
  | { type: 'video'; src: string; alt: string };

const showcaseItems: ShowcaseItem[] = [
  { type: 'image', src: `${M}/blp-screen-1.webp`, alt: 'Boda Lis & Pavlos — screen 1' },
  { type: 'video', src: '/media/videos/boda-lis-pavlos-admin.mp4', alt: 'Boda Lis & Pavlos — administration page' },
  { type: 'image', src: `${M}/blp-screen-2.webp`, alt: 'Boda Lis & Pavlos — screen 2' },
  { type: 'image', src: `${M}/blp-screen-3.webp`, alt: 'Boda Lis & Pavlos — screen 3' },
];
---

<section class="blp-project relative flex flex-col">
  <div class="blp-intro-layout">
    <aside class="blp-sticky">
      <header class="blp-headline">
        <h1 class="project-title-reveal font-display m-0 uppercase">
          <span class="project-title-reveal__inner">Boda Lis &amp; Pavlos</span>
        </h1>
        <ul class="blp-tags" aria-label="Project tags">
          <li>Bespoke</li>
          <li>Custom dev</li>
          <li>RSVP</li>
        </ul>
        <div class="blp-meta" aria-label="Project details">
          <p><i>Client: </i>Lis &amp; Pavlos</p>
          <p><i>Sector: </i>Events / wedding</p>
          <p><i>Format: </i>Custom wedding website</p>
          <p>
            <i>URL: </i>
            <a href="https://pavlosandlis.com/" target="_blank" rel="noopener noreferrer">
              pavlosandlis.com
            </a>
          </p>
          <p><i>Credits: </i>Illustrations by La Invitación de Liana</p>
        </div>
      </header>
    </aside>

    <div class="blp-main-flow">
      <figure class="blp-hero">
        <img
          src={`${M}/blp-phones-hero.webp`}
          alt="Boda Lis & Pavlos — three-phone mockup"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </figure>

      <div class="blp-study">
        <div class="blp-study-card masonry-reveal" style="--reveal-delay: 0ms">
          <article class="blp-block">
            <h2 class="blp-block__title">The project</h2>
            <hr class="blp-block__rule" />
            <div class="blp-block__body">
              <p>
                For this collaboration with La Invitación de Liana, I created a wedding website that
                celebrates both craftsmanship and digital elegance. Designed around the couple's vision, the
                site features a rich blend of soft animations and personalized illustrations, adding charm
                and personality to every section. Guests can explore the wedding details in an aesthetically
                balanced layout. A secure password-protected access ensures the privacy of all information,
                making the experience both intimate and exclusive. A private administration page for the
                couple includes tools to manage guest responses, export RSVP data to Excel format, and track
                total attendance.
              </p>
            </div>
          </article>

          <article class="blp-block">
            <h2 class="blp-block__title">Responsibilities</h2>
            <hr class="blp-block__rule" />
            <div class="blp-block__body">
              <p>
                HTML, CSS, JavaScript development — server-side setup — custom illustration integration —
                hosting and domain configuration — website launch — post-launch support.
              </p>
            </div>
          </article>
        </div>
      </div>

      <section class="blp-showcase" aria-label="Boda Lis & Pavlos website screens">
        <div class="blp-showcase__media">
          {showcaseItems.map((item, i) =>
            item.type === 'image' ? (
              <figure class="masonry-reveal" style={`--reveal-delay: ${i * 70}ms`}>
                <img
                  src={item.src}
                  alt={item.alt}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            ) : (
              <figure class="masonry-reveal" style={`--reveal-delay: ${i * 70}ms`}>
                <video
                  src={item.src}
                  aria-label={item.alt}
                  autoplay
                  loop
                  muted
                  playsinline
                  preload="metadata"
                />
              </figure>
            )
          )}
        </div>
      </section>
    </div>
  </div>
</section>

<script>
  import '../../scripts/masonry-reveal.ts';
</script>

<style>
  :global(.project-detail-page) > .blp-project {
    width: 100%;
    max-width: min(100%, 1680px);
    margin-inline: auto;
    padding-inline: 20px;
    gap: clamp(2.5rem, 7vw, 5.5rem);
  }

  .blp-intro-layout {
    display: grid;
    grid-template-columns: minmax(18rem, 0.72fr) minmax(0, 1.58fr);
    gap: clamp(2rem, 4vw, 5rem);
    align-items: start;
  }

  .blp-sticky {
    position: sticky;
    top: clamp(1rem, 3vw, 2.5rem);
    min-width: 0;
  }

  .blp-headline {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .blp-headline h1 {
    max-width: 10ch;
    color: var(--text-primary);
    font-size: clamp(2.8rem, 8vw, 7.4rem);
    line-height: 0.9;
  }

  .blp-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .blp-tags li {
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 0.42rem 0.7rem;
    color: var(--text-primary);
    font-family: var(--font-family-display);
    font-size: 0.78rem;
    line-height: 1;
    text-transform: uppercase;
  }

  .blp-meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    max-width: 31ch;
    color: var(--text-secondary);
    font-family: var(--font-family-body);
    font-size: 0.95rem;
    font-weight: 300;
    line-height: 1.45;
  }

  .blp-meta p {
    margin: 0;
  }

  .blp-meta i {
    color: var(--text-primary);
    font-style: italic;
    text-transform: uppercase;
  }

  .blp-meta a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .blp-main-flow {
    --blp-study-gap: clamp(2.4rem, 6vw, 4.5rem);

    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: var(--blp-study-gap);
  }

  .blp-hero {
    margin: 0;
    overflow: hidden;
    border-radius: var(--project-card-radius);
  }

  .blp-hero img {
    display: block;
    width: 100%;
    height: auto;
  }

  .blp-study {
    display: flex;
    flex-direction: column;
    gap: var(--blp-study-gap);
  }

  .blp-study-card {
    display: flex;
    flex-direction: column;
    gap: clamp(2.4rem, 6vw, 4.5rem);
    padding: clamp(1.4rem, 2.8vw, 2.4rem);
    background: var(--palette-white);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
  }

  .blp-block__title {
    margin: 0;
    color: var(--text-primary);
    font-family: var(--font-family-display);
    font-size: clamp(1.1rem, 1.9vw, 1.7rem);
    font-weight: 400;
    letter-spacing: 0.04em;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .blp-block__rule {
    width: 100%;
    height: 0;
    margin: clamp(0.8rem, 1.6vw, 1.2rem) 0 clamp(1.2rem, 2.6vw, 2rem);
    border: 0;
    border-top: 1px solid color-mix(in srgb, var(--text-primary) 26%, transparent);
  }

  .blp-block__body {
    display: flex;
    width: min(100%, 62ch);
    margin-left: auto;
    flex-direction: column;
    gap: 1rem;
    color: var(--text-secondary);
    font-family: var(--font-family-body);
    font-weight: 300;
  }

  .blp-block__body p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.65;
  }

  .blp-showcase {
    width: 100%;
  }

  .blp-showcase__media {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: var(--blp-study-gap);
  }

  .blp-showcase__media figure {
    margin: 0;
    overflow: hidden;
    border-radius: var(--project-card-radius);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
  }

  .blp-showcase__media img,
  .blp-showcase__media video {
    display: block;
    width: 100%;
    height: auto;
  }

  .blp-showcase__media video {
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  @media (max-width: 960px) {
    .blp-intro-layout {
      grid-template-columns: 1fr;
      gap: clamp(1.5rem, 5vw, 3rem);
    }

    .blp-sticky {
      position: static;
    }

    .blp-headline h1 {
      max-width: none;
      font-size: clamp(2.7rem, 15vw, 4.8rem);
    }

    .blp-block__body {
      width: 100%;
      margin-left: 0;
    }
  }
</style>
