---
const M = '/assets/media/projects/web-dev/bellelachaise';

type ShowcaseItem =
  | { type?: 'image'; src: string; srcset: string; alt: string }
  | { type: 'video'; src: string; alt: string };

const avifSrcset = (base: string) =>
  `${M}/${base}-640.avif 640w, ${M}/${base}-960.avif 960w, ${M}/${base}-1280.avif 1280w, ${M}/${base}-1920.avif 1920w`;

const landscapeItems: ShowcaseItem[] = [
  { src: `${M}/blc-screen-home.png`, srcset: '', alt: 'Bellelachaise desktop — homepage' },
  { src: `${M}/blc-screen-shop.png`,         srcset: '',                                alt: 'Bellelachaise — shop listing' },
  { src: `${M}/blc-screen-about.png`,        srcset: '',                                alt: 'Bellelachaise — about page' },
  { type: 'video', src: '/media/videos/bellelachaise-shop-web.mp4',                     alt: 'Bellelachaise — shop browsing' },
  { src: `${M}/blc-desktop-image2-960.avif`, srcset: avifSrcset('blc-desktop-image2'), alt: 'Bellelachaise desktop — product listing' },
  { src: `${M}/blc-desktop-image3-960.avif`, srcset: avifSrcset('blc-desktop-image3'), alt: 'Bellelachaise desktop — product detail' },
  { src: `${M}/blc-desktop-image4-960.avif`, srcset: avifSrcset('blc-desktop-image4'), alt: 'Bellelachaise desktop — collection' },
  { src: `${M}/blc-screen-about2.png`,      srcset: '', alt: 'Bellelachaise desktop — about' },
  { src: `${M}/blc-screen-collection.png`, srcset: '', alt: 'Bellelachaise desktop — collection' },
  { src: `${M}/blc-desktop-image6-960.avif`, srcset: avifSrcset('blc-desktop-image6'), alt: 'Bellelachaise desktop — footer' },
];

---

<section class="blcw-project relative flex flex-col">
  <div class="blcw-intro-layout">
    <aside class="blcw-sticky">
      <header class="blcw-headline">
        <h1 class="project-title-reveal font-display m-0 uppercase">
          <span class="project-title-reveal__inner">Bellelachaise</span>
        </h1>
        <ul class="blcw-tags" aria-label="Project tags">
          <li>Shopify</li>
          <li>E-commerce</li>
          <li>Trilingual</li>
        </ul>
        <div class="blcw-meta" aria-label="Project details">
          <p><i>Client: </i>Hakim — Bellelachaise</p>
          <p><i>Sector: </i>Home décor &amp; Vintage furniture</p>
          <p><i>Country: </i>Belgium</p>
          <p><i>Format: </i>Shopify e-commerce</p>
          <p>
            <i>URL: </i>
            <a href="https://bellelachaise.be/" target="_blank" rel="noopener noreferrer">
              bellelachaise.be
            </a>
          </p>
        </div>
      </header>
    </aside>

    <div class="blcw-main-flow">
      <figure class="blcw-hero">
        <img src={`${M}/blc-screen-home.png`} alt="Bellelachaise desktop — homepage" loading="eager" fetchpriority="high" decoding="async" />
      </figure>

      <div class="blcw-study">
        <div class="blcw-study-card masonry-reveal" style="--reveal-delay: 0ms">
          <article class="blcw-block">
            <h2 class="blcw-block__title">The project</h2>
            <hr class="blcw-block__rule" />
            <div class="blcw-block__body">
              <p>
                Bellelachaise, under the passionate guidance of founder Hakim, is a minimalist trilingual
                e-commerce platform that brings carefully curated vintage furniture to life through a serene
                Japandi-inspired design. I conceived and built the site using Shopify, crafting an intuitive
                shopping journey with secure checkout, seamless inventory management and SEO-optimized
                performance. The site is fully trilingual, offering content in English, French and Dutch to
                reach a broader audience. The result is a refined digital boutique where every piece tells
                its own story and browsing feels effortlessly elegant.
              </p>
            </div>
          </article>

          <article class="blcw-block">
            <h2 class="blcw-block__title">Responsibilities</h2>
            <hr class="blcw-block__rule" />
            <div class="blcw-block__body">
              <p>
                Web design personalization — Shopify setup — site development and features personalization —
                website launch — client training on back-office management.
              </p>
            </div>
          </article>
        </div>
      </div>

      <section class="blcw-showcase" aria-label="Bellelachaise storefront media">
        <div class="blcw-showcase__landscape">
          {landscapeItems.slice(1).map((item, i) => (
            <figure class="masonry-reveal" style={`--reveal-delay: ${i * 70}ms`}>
              {item.type === 'video' ? (
                <video src={item.src} aria-label={item.alt} autoplay loop muted playsinline preload="metadata" />
              ) : item.srcset ? (
                <picture>
                  <source type="image/avif" srcset={item.srcset} sizes="(min-width: 1280px) 64vw, (min-width: 970px) calc(100vw - 24rem), calc(100vw - 2rem)" />
                  <img src={item.src} alt={item.alt} loading="lazy" decoding="async" />
                </picture>
              ) : (
                <img src={item.src} alt={item.alt} loading="lazy" decoding="async" />
              )}
            </figure>
          ))}
        </div>
      </section>
    </div>
  </div>
</section>

<script>
  import '../../scripts/masonry-reveal.ts';
</script>

<style>
  :global(.project-detail-page) > .blcw-project {
    width: 100%;
    max-width: min(100%, 1680px);
    margin-inline: auto;
    padding-inline: 20px;
    gap: clamp(2.5rem, 7vw, 5.5rem);
  }

  .blcw-intro-layout {
    display: grid;
    grid-template-columns: minmax(18rem, 0.72fr) minmax(0, 1.58fr);
    gap: clamp(2rem, 4vw, 5rem);
    align-items: start;
  }

  .blcw-sticky {
    position: sticky;
    top: clamp(4rem, 7vw, 5.5rem);
    min-width: 0;
  }

  .blcw-headline {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .blcw-headline h1 {
    color: var(--text-primary);
    font-size: clamp(1.5rem, 2.4vw, 2.4rem);
    line-height: 0.95;
  }

  .blcw-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .blcw-tags li {
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 0.42rem 0.7rem;
    color: var(--text-primary);
    font-family: var(--font-family-display);
    font-size: 0.78rem;
    line-height: 1;
    text-transform: uppercase;
  }

  .blcw-meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    max-width: 31ch;
    color: var(--text-secondary);
    font-family: var(--font-family-body);
    font-size: 0.95rem;
    font-weight: 300;
    line-height: 1.45;
  }

  .blcw-meta p {
    margin: 0;
  }

  .blcw-meta i {
    color: var(--text-primary);
    font-style: italic;
    text-transform: uppercase;
  }

  .blcw-meta a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .blcw-main-flow {
    --blcw-study-gap: clamp(2.4rem, 6vw, 4.5rem);

    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: var(--blcw-study-gap);
  }

  .blcw-hero {
    margin: 0;
    overflow: hidden;
    border-radius: var(--project-card-radius);
  }

  .blcw-hero picture,
  .blcw-hero img {
    display: block;
    width: 100%;
    height: auto;
  }

  .blcw-study {
    display: flex;
    flex-direction: column;
    gap: var(--blcw-study-gap);
  }

  .blcw-study-card {
    display: flex;
    flex-direction: column;
    gap: clamp(2.4rem, 6vw, 4.5rem);
    padding: clamp(1.4rem, 2.8vw, 2.4rem);
    background: var(--palette-white);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
  }

  .blcw-block__title {
    margin: 0;
    color: var(--text-primary);
    font-family: var(--font-family-display);
    font-size: clamp(1.1rem, 1.9vw, 1.7rem);
    font-weight: 400;
    letter-spacing: 0.04em;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .blcw-block__rule {
    width: 100%;
    height: 0;
    margin: clamp(0.8rem, 1.6vw, 1.2rem) 0 clamp(1.2rem, 2.6vw, 2rem);
    border: 0;
    border-top: 1px solid color-mix(in srgb, var(--text-primary) 26%, transparent);
  }

  .blcw-block__body {
    display: flex;
    width: min(100%, 62ch);
    margin-left: auto;
    flex-direction: column;
    gap: 1rem;
    color: var(--text-secondary);
    font-family: var(--font-family-body);
    font-weight: 300;
  }

  .blcw-block__body p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.65;
  }

  .blcw-showcase {
    width: 100%;
  }

  .blcw-showcase__landscape {
    display: flex;
    flex-direction: column;
    gap: var(--blcw-study-gap);
  }

  .blcw-showcase__landscape figure {
    margin: 0;
    overflow: hidden;
    border-radius: var(--project-card-radius);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
  }

  .blcw-showcase__landscape picture,
  .blcw-showcase__landscape img {
    display: block;
    width: 100%;
    height: auto;
  }

  .blcw-showcase__landscape video {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 960px) {
    .blcw-intro-layout {
      grid-template-columns: 1fr;
      gap: clamp(1.5rem, 5vw, 3rem);
    }

    .blcw-sticky {
      position: static;
    }

    .blcw-headline h1 {
      font-size: clamp(1.8rem, 10vw, 3rem);
    }

    .blcw-block__body {
      width: 100%;
      margin-left: 0;
    }
  }
</style>
