---
import ProjectSheet from '../v2/ProjectSheet.astro';
import type { SheetBlock } from './case-study';

import type { ImageMetadata } from 'astro';

const images = import.meta.glob<ImageMetadata>(
  '/src/assets/media-src/projects/web-dev/bellelachaise/*.{png,avif}',
  { eager: true, import: 'default' },
);
const pic = (file: string): ImageMetadata =>
  images[`/src/assets/media-src/projects/web-dev/bellelachaise/${file}`];

const blocks: SheetBlock[] = [
  { type: 'image', src: pic('blc-screen-home.png'), alt: 'Bellelachaise desktop — homepage' },
  { type: 'image', src: pic('blc-screen-shop.png'), alt: 'Bellelachaise — shop listing' },
  { type: 'image', src: pic('blc-screen-about.png'), alt: 'Bellelachaise — about page' },
  { type: 'video', src: '/media/videos/bellelachaise-shop-web.mp4', alt: 'Bellelachaise — shop browsing' },
  { type: 'image', src: pic('blc-desktop-image2-1920.avif'), alt: 'Bellelachaise desktop — product listing' },
  { type: 'image', src: pic('blc-desktop-image3-1920.avif'), alt: 'Bellelachaise desktop — product detail' },
  { type: 'image', src: pic('blc-desktop-image4-1920.avif'), alt: 'Bellelachaise desktop — collection' },
  { type: 'image', src: pic('blc-screen-about2.png'), alt: 'Bellelachaise desktop — about' },
  { type: 'image', src: pic('blc-screen-collection.png'), alt: 'Bellelachaise desktop — collection' },
  { type: 'image', src: pic('blc-desktop-image6-1920.avif'), alt: 'Bellelachaise desktop — footer' },
];

const { year = '', others = [] } = Astro.props;
---

<ProjectSheet
  year={year}
  others={others}
  title="Bellelachaise"
  sector="Home décor & Vintage furniture"
  country="Belgium"
  format="Shopify e-commerce"
  tags={['Shopify', 'E-commerce', 'Trilingual']}
  url={{ href: 'https://bellelachaise.be/', label: 'bellelachaise.be' }}
  projectParagraphs={[
    'Bellelachaise, under the passionate guidance of founder Hakim, is a minimalist trilingual e-commerce platform that brings carefully curated vintage furniture to life through a serene Japandi-inspired design. I conceived and built the site using Shopify, crafting an intuitive shopping journey with secure checkout, seamless inventory management and SEO-optimized performance. The site is fully trilingual, offering content in English, French and Dutch to reach a broader audience. The result is a refined digital boutique where every piece tells its own story and browsing feels effortlessly elegant.',
  ]}
  responsibilities="Web design personalization — Shopify setup — site development and features personalization — website launch — client training on back-office management."
  blocks={blocks}
  showContext={true}
/>
