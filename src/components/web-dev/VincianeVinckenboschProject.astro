---
import ProjectSheet from '../v2/ProjectSheet.astro';
import type { SheetBlock } from './case-study';
import type { ImageMetadata } from 'astro';

const images = import.meta.glob<ImageMetadata>(
  '/src/assets/media-src/projects/web-dev/vinciane-vinckenbosch/*.png',
  { eager: true, import: 'default' },
);
const pic = (base: string): ImageMetadata =>
  images[`/src/assets/media-src/projects/web-dev/vinciane-vinckenbosch/${base}.png`];

const cover = '/assets/media/projects/web-dev/vinciane-vinckenbosch/vinciane-vinckenbosch-cover.webp';

const paletteSwatches = [
  { hex: '#232323', rgb: '35, 35, 35', cmyk: '0, 0, 0, 86', textColor: '#F7F5F3' },
  { hex: '#F7F5F3', rgb: '247, 245, 243', cmyk: '0, 1, 2, 3', textColor: '#232323' },
  { hex: '#DA7F52', rgb: '218, 127, 82', cmyk: '0, 42, 62, 15', textColor: '#232323' },
  { hex: '#BCB7A9', rgb: '188, 183, 169', cmyk: '0, 3, 10, 26', textColor: '#232323' },
  { hex: '#E6E3DB', rgb: '230, 227, 219', cmyk: '0, 1, 5, 10', textColor: '#232323' },
];

const img = (base: string, alt: string): SheetBlock => ({ type: 'image', src: pic(base), alt });

const blocks: SheetBlock[] = [
  {
    type: 'video',
    src: '/media/videos/vinciane-vinckenbosch-preview.mp4',
    poster: cover,
    alt: 'Vinciane Vinckenbosch website motion preview',
  },
  {
    type: 'palette',
    swatches: paletteSwatches,
    label: 'Vinciane Vinckenbosch color palette',
    note: 'The black of a concert hall at night. An audience held in silence, in shadow. A single white light finds the stage — sharp, absolute — the soloist at its centre. And the warm amber of the palette echoes the viola itself: ancient wood, resonant grain, the body of sound.',
  },
  img('vinciane-mockup-a', 'Vinciane Vinckenbosch website MacBook scrolling mockup'),
  img('vinciane-mockup-b', 'Vinciane Vinckenbosch website alternate MacBook mockup'),
  img('vinciane-mockup-chair', 'Vinciane Vinckenbosch website studio MacBook mockup'),
  img('vinciane-screen-01', 'Vinciane Vinckenbosch multilingual website homepage'),
  img('vinciane-screen-02', 'Vinciane Vinckenbosch artist biography screen'),
  img('vinciane-screen-03', 'Vinciane Vinckenbosch performance and agenda screen'),
  img('vinciane-screen-04', 'Vinciane Vinckenbosch media management screen'),
  img('vinciane-screen-05', 'Vinciane Vinckenbosch translated content screen'),
  img('vinciane-screen-06', 'Vinciane Vinckenbosch press documents screen'),
  img('vinciane-screen-07', 'Vinciane Vinckenbosch responsive website screen'),
];

const { year = '', others = [] } = Astro.props;
---

<ProjectSheet
  year={year}
  others={others}
  title="Vinciane Vinckenbosch"
  sector="Classical music"
  country="Germany"
  format="Multilingual website & admin studio"
  tags={['Astro', 'Sanity CMS', 'Multilingual']}
  url={{ href: 'https://www.vincianevinckenbosch.com', label: 'vincianevinckenbosch.com' }}
  projectParagraphs={[
    'A multilingual website project for violist Vinciane Vinckenbosch, combining an elegant public showcase with an administration studio for managing content, media, concerts, translated texts, and press materials.',
    'The build brings together a performance-focused Astro front end, Vue interaction layers, Sanity content modelling, responsive media handling, and Vercel deployment for a polished multilingual artist platform.',
    'The interface is designed to feel refined and precise, while the CMS structure keeps the editorial workflow clear across French, English, and German.',
  ]}
  responsibilities="Web design personalization - Multilingual frontend development - Sanity CMS setup - Media gallery integration - Responsive optimization - Domain &amp; Vercel deployment - Website launch"
  blocks={blocks}
  showContext={true}
/>
