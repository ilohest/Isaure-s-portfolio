---
import ResponsiveImage from '../media/ResponsiveImage.astro';

import type { ImageMetadata } from 'astro';

const images = import.meta.glob<ImageMetadata>(
  '/src/assets/media-src/projects/web-dev/vinciane-vinckenbosch/*.png',
  { eager: true, import: 'default' },
);

const pic = (base: string): ImageMetadata =>
  images[`/src/assets/media-src/projects/web-dev/vinciane-vinckenbosch/${base}.png`];

const screens = [
  { base: 'vinciane-screen-01', alt: 'Vinciane Vinckenbosch multilingual website homepage' },
  { base: 'vinciane-screen-02', alt: 'Vinciane Vinckenbosch artist biography screen' },
  { base: 'vinciane-screen-03', alt: 'Vinciane Vinckenbosch performance and agenda screen' },
  { base: 'vinciane-screen-04', alt: 'Vinciane Vinckenbosch media management screen' },
  { base: 'vinciane-screen-05', alt: 'Vinciane Vinckenbosch translated content screen' },
  { base: 'vinciane-screen-06', alt: 'Vinciane Vinckenbosch press documents screen' },
  { base: 'vinciane-screen-07', alt: 'Vinciane Vinckenbosch responsive website screen' },
];

const mockups = [
  { base: 'vinciane-mockup-a', alt: 'Vinciane Vinckenbosch website MacBook scrolling mockup' },
  { base: 'vinciane-mockup-b', alt: 'Vinciane Vinckenbosch website alternate MacBook mockup' },
  { base: 'vinciane-mockup-chair', alt: 'Vinciane Vinckenbosch website studio MacBook mockup' },
];

const paletteSwatches = [
  { hex: '#232323', rgb: '35, 35, 35', cmyk: '0, 0, 0, 86', textColor: '#F7F5F3' },
  { hex: '#F7F5F3', rgb: '247, 245, 243', cmyk: '0, 1, 2, 3', textColor: '#232323' },
  { hex: '#DA7F52', rgb: '218, 127, 82', cmyk: '0, 42, 62, 15', textColor: '#232323' },
  { hex: '#BCB7A9', rgb: '188, 183, 169', cmyk: '0, 3, 10, 26', textColor: '#232323' },
  { hex: '#E6E3DB', rgb: '230, 227, 219', cmyk: '0, 1, 5, 10', textColor: '#232323' },
];

---

<section class="vv-project relative mx-auto px-4 py-4">
  <div class="vv-layout">
    <aside class="vv-sticky">
      <div class="vv-intro">
        <h1 class="project-title-reveal vv-title font-display m-0 uppercase">
          <span class="project-title-reveal__inner">
            Vinciane
            <span class="vv-title-sub">Vinckenbosch</span>
          </span>
        </h1>

        <ul class="vv-tags" aria-label="Project tags">
          <li>Astro</li>
          <li>Sanity CMS</li>
          <li>Multilingual</li>
        </ul>

        <div class="vv-meta" aria-label="Project details">
          <p><i>Client: </i>Vinciane Vinckenbosch</p>
          <p><i>Sector: </i>Classical music</p>
          <p><i>Country: </i>Germany</p>
          <p><i>Format: </i>Multilingual website & admin studio</p>
          <p>
            <i>URL: </i>
            <a href="https://www.vincianevinckenbosch.com" target="_blank" rel="noopener noreferrer">
              vincianevinckenbosch.com
            </a>
          </p>
        </div>
      </div>
    </aside>

    <div class="vv-flow">
      <figure class="vv-hero">
        <video
          src="/media/videos/vinciane-vinckenbosch-preview.mp4"
          class="vv-hero-video"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-label="Vinciane Vinckenbosch website motion preview"
        ></video>
      </figure>

      <div class="vv-study-card">
        <article class="vv-block">
          <h2 class="vv-block__title">The Project</h2>
          <hr class="vv-block__rule" />
          <div class="vv-block__body">
            <p>
              A multilingual website project for violist Vinciane Vinckenbosch, combining an elegant
              public showcase with an administration studio for managing content, media, concerts,
              translated texts, and press materials.
            </p>
            <p>
              The build brings together a performance-focused Astro front end, Vue interaction
              layers, Sanity content modelling, responsive media handling, and Vercel deployment for
              a polished multilingual artist platform.
            </p>
            <p>
              The interface is designed to feel refined and precise, while the CMS structure keeps
              the editorial workflow clear across French, English, and German.
            </p>
          </div>
        </article>

        <article class="vv-block">
          <h2 class="vv-block__title">Responsibilities</h2>
          <hr class="vv-block__rule" />
          <div class="vv-block__body">
            <p>
              Web design personalization - Multilingual frontend development - Sanity CMS setup -
              Media gallery integration - Responsive optimization - Domain &amp; Vercel deployment -
              Website launch
            </p>
          </div>
        </article>
      </div>

      <div class="vv-palette-card" role="group" aria-label="Vinciane Vinckenbosch color palette">
        <div class="vv-palette-grid">
          {
            paletteSwatches.map((sw) => (
              <div class="vv-palette-swatch" style={`background-color:${sw.hex};color:${sw.textColor}`}>
                <div class="vv-palette-label">
                  <p class="vv-palette-line">HEX {sw.hex}</p>
                  <p class="vv-palette-line">RGB {sw.rgb}</p>
                  <p class="vv-palette-line">CMYK {sw.cmyk}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="vv-palette-note">
        <p>The black of a concert hall at night. An audience held in silence, in shadow. A single white light finds the stage — sharp, absolute — the soloist at its centre. And the warm amber of the palette echoes the viola itself: ancient wood, resonant grain, the body of sound.</p>
      </div>

      {mockups.map((item) => (
        <ResponsiveImage
          src={pic(item.base)}
          alt={item.alt}
          sizes="(min-width: 1280px) 64vw, (min-width: 970px) calc(100vw - 24rem), calc(100vw - 2rem)"
          loading="lazy"
          imgClass="vv-screen"
          class="vv-picture"
        />
      ))}

      <div class="vv-screen-grid">
        {screens.map((item) => (
          <ResponsiveImage
            src={pic(item.base)}
            alt={item.alt}
            sizes="(min-width: 1280px) 64vw, (min-width: 970px) calc(100vw - 24rem), calc(100vw - 2rem)"
            loading="lazy"
            imgClass="vv-screen"
            class="vv-picture"
          />
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .vv-project {
    width: min(100%, 1680px);
    max-width: min(100%, 1680px);
  }

  :global(.project-detail-page) > .vv-project {
    max-width: min(100%, 1680px);
  }

  .vv-layout {
    display: grid;
    grid-template-columns: minmax(18rem, 0.72fr) minmax(0, 1.58fr);
    gap: clamp(2rem, 4vw, 5rem);
    align-items: start;
  }

  .vv-sticky {
    position: sticky;
    top: clamp(4rem, 7vw, 5.5rem);
    min-width: 0;
  }

  .vv-intro {
    display: flex;
    flex-direction: column;
    gap: clamp(0.95rem, 1.4vw, 1.25rem);
    padding: clamp(0.35rem, 1.2vw, 1rem) 0;
  }

  .vv-title {
    color: var(--text-primary);
    font-size: clamp(2.5rem, 4.5vw, 5rem);
    line-height: 0.94;
    letter-spacing: 0.02em;
  }

  .vv-title-sub {
    display: block;
    font-size: clamp(1.1rem, 2.2vw, 2.3rem);
    line-height: 1.2;
    margin-top: 0.32em;
    letter-spacing: 0.04em;
  }

  .vv-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .vv-tags li {
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 0.42rem 0.7rem;
    color: var(--text-primary);
    font-family: var(--font-family-display);
    font-size: 0.78rem;
    line-height: 1;
    text-transform: uppercase;
  }

  .vv-meta,
  .vv-block__body {
    color: var(--text-secondary);
    font-family: 'Red Hat Text', sans-serif;
    font-size: clamp(0.92rem, 0.95vw, 1rem);
    font-weight: 300;
    line-height: 1.6;
  }

  .vv-meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    max-width: 33ch;
  }

  .vv-meta p,
  .vv-block__body p {
    margin: 0;
  }

  .vv-meta i {
    color: var(--text-primary);
    font-style: italic;
    text-transform: uppercase;
  }

  .vv-meta a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .vv-flow {
    display: grid;
    gap: clamp(2.4rem, 6vw, 4.5rem);
    min-width: 0;
  }

  .vv-hero {
    margin: 0;
  }

  .vv-hero-video {
    display: block;
    width: 100%;
    height: auto;
    background: #111;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
  }

  .vv-study-card {
    display: flex;
    flex-direction: column;
    gap: clamp(2.4rem, 6vw, 4.5rem);
    padding: clamp(1.4rem, 2.8vw, 2.4rem);
    background: var(--palette-white);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
  }

  .vv-block__title {
    margin: 0;
    color: var(--text-primary);
    font-family: var(--font-family-display);
    font-size: clamp(1.1rem, 1.9vw, 1.7rem);
    font-weight: 400;
    letter-spacing: 0.04em;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .vv-block__rule {
    width: 100%;
    height: 0;
    margin: clamp(0.8rem, 1.6vw, 1.2rem) 0 clamp(1.2rem, 2.6vw, 2rem);
    border: 0;
    border-top: 1px solid color-mix(in srgb, var(--text-primary) 26%, transparent);
  }

  .vv-block__body {
    display: flex;
    width: min(100%, 62ch);
    margin-left: auto;
    flex-direction: column;
    gap: 1rem;
  }

  .vv-block__body p {
    font-size: 1rem;
    line-height: 1.65;
  }

  .vv-palette-card {
    overflow: hidden;
    border-radius: var(--project-card-radius);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
  }

  .vv-palette-grid {
    display: flex;
    width: 100%;
    min-height: clamp(300px, 34vw, 520px);
    flex-direction: row;
  }

  .vv-palette-swatch {
    position: relative;
    display: flex;
    min-width: 0;
    min-height: 100%;
    flex: 1 1 0;
    align-items: flex-end;
    transition:
      flex-grow 260ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 260ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 260ms ease;
  }

  .vv-palette-label {
    min-width: 0;
    padding: clamp(0.75rem, 1.4vw, 1rem) clamp(0.7rem, 1.6vw, 1.25rem);
    line-height: 1.25;
    letter-spacing: 0.01em;
    transition:
      padding 260ms cubic-bezier(0.22, 1, 0.36, 1),
      letter-spacing 260ms ease,
      transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .vv-palette-line {
    margin: 0;
    overflow-wrap: anywhere;
    font-size: clamp(0.68rem, 1.45vw, 0.9rem);
    font-weight: 300;
  }

  .vv-palette-swatch:hover {
    z-index: 1;
    flex-grow: 1.18;
    filter: saturate(1.08) brightness(1.02);
    transform: scale(1.035);
  }

  .vv-palette-swatch:hover .vv-palette-label {
    padding-block: 1.2rem;
    letter-spacing: 0.06em;
    transform: translateY(-2px);
  }

  .vv-palette-note {
    padding: clamp(1.4rem, 2.8vw, 2.4rem);
    background: var(--palette-white);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
  }

  .vv-palette-note p {
    margin: 0;
    color: var(--text-secondary);
    font-family: 'Red Hat Text', sans-serif;
    font-size: clamp(0.95rem, 1.1vw, 1.05rem);
    font-style: italic;
    font-weight: 300;
    line-height: 1.7;
  }

  .vv-screen-grid {
    display: grid;
    gap: clamp(2.4rem, 6vw, 4.5rem);
  }

  .vv-flow :global(.vv-picture) {
    display: block;
    overflow: hidden;
    border-radius: var(--project-card-radius);
    border: 1px solid var(--surface-muted);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
  }

  .vv-flow :global(.vv-screen) {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 980px) {
    .vv-layout {
      grid-template-columns: 1fr;
    }

    .vv-sticky {
      position: static;
    }

    .vv-title {
      font-size: clamp(2.7rem, 15vw, 4.8rem);
    }

    .vv-title-sub {
      font-size: clamp(0.95rem, 4vw, 1.6rem);
    }

    .vv-block__body {
      width: 100%;
      margin-left: 0;
    }

    .vv-palette-grid {
      min-height: auto;
      flex-direction: column;
    }

    .vv-palette-swatch {
      min-height: clamp(82px, 16vw, 120px);
    }

    .vv-palette-label {
      padding: 1rem 1.25rem;
    }

    .vv-palette-line {
      font-size: 0.9rem;
    }
  }

  @media (max-width: 620px) {
    .vv-project {
      padding-inline: 1rem;
    }

  }
</style>
