---
import ProjectSheet from '../v2/ProjectSheet.astro';
import type { SheetBlock } from './case-study';
import type { ImageMetadata } from 'astro';

// Sources copiées depuis public/ vers src/assets (le gabarit attend des ImageMetadata).
const images = import.meta.glob<ImageMetadata>(
  '/src/assets/media-src/projects/web-dev/private-events-dashboard/*.{avif,webp,jpg}',
  { eager: true, import: 'default' },
);
const pic = (file: string): ImageMetadata =>
  images[`/src/assets/media-src/projects/web-dev/private-events-dashboard/${file}`];

const projectParagraphs = [
  "I designed and built an elegant, private wedding invitation website showcasing hand‑drawn illustrations, with subtle animations, all key event details, and a dedicated RSVP experience for guests to confirm attendance, plus‑ones, dietary needs, and notes. To protect guests' privacy, access is secured with a shared password.",
  'Behind the scenes, the back office is a full operations dashboard built to run the wedding end‑to‑end. It centralizes guest responses and dietary requirements, and provides tools to plan seating arrangements and generate printable exports for vendors and on‑site coordination. Organizers can manage a structured timeline/agenda, track budget items, curate a shared playlist, and publish updates through a lightweight blog. The dashboard also includes email tooling, role‑based access, and an AI assistant, with a super‑admin area to manage users, permissions, and invitation links.',
];

const features: { img: string; alt: string; title: string; text: string }[] = [
  { img: `admin-dashboard-1920.webp`, alt: 'Admin dashboard overview', title: 'Dashboard & Metrics', text: 'Track RSVPs, attendance totals, and key planning metrics at a glance — so you can spot changes quickly and stay on top of what matters most.' },
  { img: `admin-rsvp-1920.webp`, alt: 'RSVP management screen', title: 'RSVP Management', text: 'Review guest responses, plus‑ones, messages, statistics — without chasing spreadsheets.' },
  { img: `admin-diets-1920.webp`, alt: 'Dietary requirements management', title: 'Dietary Requirements', text: 'Collect allergies and preferences, then export clean summaries for vendors.' },
  { img: `admin-seating-1920.webp`, alt: 'Seating plan editor', title: 'Seating Plan', text: 'Build table assignments and generate print‑ready seating outputs.' },
  { img: `admin-playlist-1920.webp`, alt: 'Playlist management', title: 'Playlist Curation', text: 'Gather song requests and curate the soundtrack in one place.' },
  { img: `admin-blog-1920.webp`, alt: 'Blog administration', title: 'Blog / Updates', text: 'Publish guest‑facing updates through a lightweight blog feed.' },
  { img: `admin-email-1920.webp`, alt: 'Email tooling screen', title: 'Email Center', text: 'Send targeted messages and review delivery history when needed.' },
  { img: `admin-weddingplanner-1920.webp`, alt: 'Wedding planner workspace', title: 'Wedding Planner', text: 'Turn ideas into actionable tasks with built‑in assistance to speed up planning.' },
  { img: `admin-rsvp-form-1920.webp`, alt: 'RSVP form preview', title: 'Guest RSVP Experience', text: 'A guided and personalized RSVP flow for guests (attendance, plus‑ones, dietary needs, notes).' },
  { img: `admin-budget-1920.webp`, alt: 'Budget tracking dashboard', title: 'Budget Tracking', text: 'Track expenses, categories, and payments to keep the budget under control.' },
  { img: `admin-agenda-1920.webp`, alt: 'Agenda and timeline editor', title: 'Agenda / Timeline', text: 'Organize the wedding day step by step, define schedules, assign responsibilities, and visualize the entire planning at a glance.' },
];

const ctas = [
  { file: 'cta-couple-960.jpg', alt: 'Wedding editorial portrait', q: 'Are you planning a wedding or event and want a digital invitation that actually saves you time?', t: 'Get a bespoke illustrated invitation site plus a private operations dashboard to handle RSVPs, seating, emails, and planning — smoothly and securely.', label: 'Request a demo', icon: 'pi-envelope' },
  { file: 'cta-agency-960.jpg', alt: 'Ocean spray with rainbow', q: 'Are you a design studio or stationery brand looking to offer more than printed invitations?', t: 'Bring your custom illustrations into my platform and deliver a premium bundle: a stunning invitation website paired with a full guest‑management dashboard.', label: "Let’s talk partnership", icon: 'pi-send' },
];


const blocks: SheetBlock[] = [
  { type: 'image', src: pic('bodanm-desktop1-1920.avif'), alt: 'Wedding invitation website — desktop' },
  { type: 'text', title: 'Project', paragraphs: [projectParagraphs[1]] },
  { type: 'image', src: pic('bodanm-desktop6-1920.avif'), alt: 'Wedding website — desktop view' },
  { type: 'image', src: pic('bodanm-mockup1-1920.avif'), alt: 'Wedding website — phone mockup' },
  {
    type: 'text',
    title: 'The platform highlights',
    paragraphs: ['A quick tour of the tools used to run a private wedding end‑to‑end.'],
  },
  { type: 'video', src: '/media/videos/private-events-dashboard-home.mp4', alt: 'Digital invitation experience' },
  {
    type: 'text',
    title: 'Digital invitation experience',
    paragraphs: ["An elegant private invitation website designed around bespoke, hand‑drawn illustrations to match each couple's world."],
  },
  ...features.flatMap((f): SheetBlock[] => [
    { type: 'image', src: pic(f.img), alt: f.alt },
    { type: 'text', title: f.title, paragraphs: [f.text] },
  ]),
  ...ctas.flatMap((c): SheetBlock[] => [
    { type: 'image', src: pic(c.file), alt: c.alt },
    { type: 'text', title: c.q, paragraphs: [c.t, c.label] },
  ]),
];

const { year = '', others = [] } = Astro.props;
---

<ProjectSheet
  year={year}
  others={others}
  title="Private event operations dashboard"
  subtitle="Wedding Edition"
  sector="Weddings & events"
  format="Invitation site + operations dashboard"
  url={{ href: 'https://www.natalia-y-mauricio.com/', label: 'natalia-y-mauricio.com' }}
  tags={['Product design', 'Full-stack dev', 'UX/UI']}
  responsibilities="Product design & technical architecture - Front-end development - Back-end/API development - Database & authentication - Custom illustration integration - UI/UX - Security & access control - Deployment & server setup - Launch & post-launch support"
  projectParagraphs={[projectParagraphs[0]]}
  blocks={blocks}
  showContext={false}
/>
