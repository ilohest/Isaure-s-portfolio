---
import ProjectSheet from '../v2/ProjectSheet.astro';
import type { SheetBlock } from './case-study';
import type { ImageMetadata } from 'astro';

const images = import.meta.glob<ImageMetadata>(
  '/src/assets/media-src/projects/web-dev/goa-kombucha-flow/*.webp',
  { eager: true, import: 'default' },
);
const pic = (base: string): ImageMetadata =>
  images[`/src/assets/media-src/projects/web-dev/goa-kombucha-flow/${base}.webp`];

const screens: [string, string][] = [
  ['goa-kombucha-flow-01-dashboard', 'Goa Kombucha lot history'],
  ['goa-kombucha-flow-03-production-detail', 'Goa Kombucha stock item settings'],
  ['goa-kombucha-flow-04-lot-history', 'Goa Kombucha stock overview'],
  ['goa-kombucha-flow-05-lot-export', 'Goa Kombucha completed lot details'],
  ['goa-kombucha-flow-06-deliveries', 'Goa Kombucha deliveries screen'],
  ['goa-kombucha-flow-07-stock', 'Goa Kombucha production details'],
  ['goa-kombucha-flow-08-stock-item', 'Goa Kombucha mobile dashboard'],
  ['goa-kombucha-flow-09-pdf', 'Goa Kombucha recipe library'],
  ['goa-kombucha-flow-02-recipes', 'Goa Kombucha PDF recipe export'],
];
const shots = (from: number, to: number): SheetBlock[] =>
  screens.slice(from, to).map(([base, alt]) => ({ type: 'image', src: pic(base), alt }));

const overviewParagraphs = [
  "Goa Kombucha Flow is a mobile-first production platform created to migrate the client's operational spreadsheets into a practical web app that can be used directly from a phone in the production area.",
  'The goal was to make recipe management, batch tracking, stock control, and production decisions easier to handle on the floor: fewer scattered files, less back-and-forth, and a clearer workflow for preparing, following, duplicating, and documenting batches.',
  'The app centralizes product formulas, active productions, lot history, ingredient stock, deliveries, and PDF exports in one interface designed around the constraints of real production use: quick checks, readable screens, and reliable access from a mobile device.',
  'Because the platform handles confidential recipes, quantities, prices, and supplier information, the case-study screens shown here are intentionally anonymized while preserving the structure and workflow of the interface.',
];
const features = [
  'Mobile production dashboard with active batches, status steps, and stock alerts',
  'Recipe library with product versions, ingredient logic, and batch calculations',
  'Lot creation, duplication, history, notes, and production PDF export',
  'Inventory views for ingredients, critical thresholds, deliveries, and order needs',
  'Operational tracking for measurements, starter, water, filtration, and bottling',
];

const blocks: SheetBlock[] = [
  ...shots(0, 3),
  { type: 'text', title: 'Project', paragraphs: overviewParagraphs.slice(1) },
  ...shots(3, 6),
  { type: 'text', title: 'Key features', paragraphs: features },
  ...shots(6, 9),
];

const { year = '', others = [] } = Astro.props;
---

<ProjectSheet
  year={year}
  others={others}
  title="Goa Kombucha Flow"
  sector="Food & Beverage"
  country="France"
  format="Operational web app"
  tags={['Custom platform', 'Production workflow', 'Mobile-first']}
  projectParagraphs={[overviewParagraphs[0]]}
  blocks={blocks}
  showContext={false}
/>
