---
import ProjectSheet from '../v2/ProjectSheet.astro';
import type { SheetBlock } from './case-study';
import type { ImageMetadata } from 'astro';

const images = import.meta.glob<ImageMetadata>('/src/assets/media-src/projects/web-dev/didacmania/*.avif', {
  eager: true,
  import: 'default',
});
const pic = (base: string): ImageMetadata =>
  images[`/src/assets/media-src/projects/web-dev/didacmania/didacmania-${base}.avif`];

const desktopAlt = 'Didacmanía shop desktop view';
const mobileAlt = 'Didacmanía mobile view';

const blocks: SheetBlock[] = [
  {
    type: 'text',
    paragraphs: [
      'The online store of the Didacmanía project is meticulously designed to enhance user shopping experience, seamlessly integrating the capability to explore nearly 4,000 products through a variety of criteria or utilizing a convenient sliding sidebar cart feature on the right side of the screen, allowing users to effortlessly review and adjust their selections at any point in their shopping journey.',
    ],
  },
  {
    type: 'video',
    src: '/media/videos/video-didacmania.mp4',
    poster: '/assets/media/projects/web-dev/didacmania/didacmania-placeholder-960.avif',
    alt: 'Didacmanía online store video',
  },
  {
    type: 'text',
    paragraphs: [
      "Users can navigate the extensive toy catalog by filtering options such as categories, age groups, brands, and price ranges, ensuring they find exactly what they're looking for with ease. Highlighting new arrivals and special deals, the shop utilizes cute icons to draw client's attention. This comprehensive approach to online retail ensures a user-friendly, efficient, and enjoyable shopping journey for all visitors.",
    ],
  },
  { type: 'image', src: pic('desktop4'), alt: desktopAlt },
  { type: 'image', src: pic('desktop3'), alt: desktopAlt },
  {
    type: 'text',
    paragraphs: [
      'Home page on desktop view. The aesthetic of the Didacmanía online store features a playful, child-friendly design, adorned with charming and cute illustrations creating a whimsical and inviting atmosphere for shoppers.',
    ],
  },
  { type: 'image', src: pic('desktop2'), alt: desktopAlt },
  { type: 'image', src: pic('desktop1'), alt: desktopAlt },
  {
    type: 'text',
    paragraphs: [
      'Designed with a responsive layout, the Didacmanía online store ensures an optimal viewing experience across all devices, allowing users to seamlessly browse and purchase their favorite toys whether they are on a desktop, tablet, or smartphone.',
    ],
  },
  ...[1, 2, 3, 4, 5, 6, 7, 8].map((n) => ({ type: 'image' as const, src: pic(`mobile${n}`), alt: mobileAlt })),
];

const { year = '', others = [] } = Astro.props;
---

<ProjectSheet
  year={year}
  others={others}
  title="Didacmanía"
  projectParagraphs={[
    "The Didacmanía project involved developing a sleek and interactive online store for a Barcelona-based toy brand. Leveraging WordPress for its user-friendly and intuitive management, this website provides an optimized online shopping experience, showcasing the brand's wide range of high-quality toys.",
  ]}
  responsibilities="Web design personalization, WordPress installation and database setup, Site development, E-Commerce integration, Secure payment gateway, SEO optimization for improved visibility, Website launch, Client training on back-office management, Client collaboration with continuous communication and feedback integration throughout the project lifecycle."
  blocks={blocks}
  showContext={false}
/>
