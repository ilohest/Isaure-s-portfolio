---
import CaseStudyProject from './CaseStudyProject.astro';
import type { CaseStudyMedia } from './case-study';

import type { ImageMetadata } from 'astro';

const images = import.meta.glob<ImageMetadata>(
  '/src/assets/media-src/projects/web-dev/academie-cle-do-re/*.png',
  { eager: true, import: 'default' },
);
const pic = (base: string): ImageMetadata =>
  images[`/src/assets/media-src/projects/web-dev/academie-cle-do-re/${base}.png`];

const media: CaseStudyMedia[] = [
  { type: 'image', src: pic('academie-cle-do-re-hero'), alt: 'Académie Clé Do Ré homepage hero section' },
  { type: 'image', src: pic('academie-cle-do-re-programme'), alt: 'Académie Clé Do Ré program section' },
  {
    type: 'video',
    src: '/media/videos/academie-cle-do-re-scroll-2.mp4',
    poster: '/assets/media/projects/web-dev/academie-cle-do-re/academie-cle-do-re-melodie-1920.webp',
    alt: 'Académie Clé Do Ré website scrolling preview',
  },
  { type: 'image', src: pic('academie-cle-do-re-melodie'), alt: 'Académie Clé Do Ré melody section' },
  { type: 'image', src: pic('academie-cle-do-re-nouveaute'), alt: 'Académie Clé Do Ré news section' },
  { type: 'image', src: pic('academie-cle-do-re-reductions'), alt: 'Académie Clé Do Ré reductions section' },
  { type: 'image', src: pic('academie-cle-do-re-adresses'), alt: 'Académie Clé Do Ré addresses section' },
];

const palette = [
  { hex: '#F2A92E', rgb: '242, 169, 46', cmyk: '0, 30, 81, 5', textColor: '#353535' },
  { hex: '#353535', rgb: '53, 53, 53', cmyk: '0, 0, 0, 79', textColor: '#FFFFFF' },
  { hex: '#FAE6D8', rgb: '250, 230, 216', cmyk: '0, 8, 14, 2', textColor: '#353535' },
  { hex: '#F4F4F2', rgb: '244, 244, 242', cmyk: '0, 0, 1, 4', textColor: '#353535' },
  { hex: '#FFFFFF', rgb: '255, 255, 255', cmyk: '0, 0, 0, 0', textColor: '#353535' },
];
---

<CaseStudyProject
  title="Académie"
  subtitle="Clé Do Ré"
  tags={['Squarespace', 'Web design', 'Education']}
  meta={[
    { label: 'Client', value: 'Académie Clé Do Ré' },
    { label: 'Sector', value: 'Music education' },
    { label: 'Country', value: 'France' },
    { label: 'Format', value: 'Showcase website' },
  ]}
  url={{ href: 'https://academiecledore.fr/', label: 'academiecledore.fr' }}
  heroVideo="/media/videos/academie-cle-do-re-scroll-1.mp4"
  heroPoster="/assets/media/projects/web-dev/academie-cle-do-re/academie-cle-do-re-hero-1920.webp"
  heroAlt="Académie Clé Do Ré website motion preview"
  projectParagraphs={[
    'A charming, minimalist website for a music academy in Toulouse run by Bérangère, offering piano, guitar, singing and music theory lessons for children and adults from the age of three.',
    'A light palette complements the academy’s logo, lifted by playful yellow and black accents, delightful animations and whimsical illustrations of little characters making music.',
    'The interface makes it effortless to browse lessons, locations, prices and discounts — an engaging, light-hearted experience for visitors of all ages.',
  ]}
  responsibilities="Web design personalization - Squarespace setup - Site development - Website launch"
  palette={palette}
  paletteLabel="Académie Clé Do Ré color palette"
  paletteNote="The warm yellow of a brass trumpet catching the light, the black and white of piano keys, and the soft peach of a practice room in the afternoon — a playful, welcoming palette that sounds like a first lesson."
  media={media}
/>
