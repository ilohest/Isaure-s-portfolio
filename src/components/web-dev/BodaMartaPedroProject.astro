---
import ProjectSheet from '../v2/ProjectSheet.astro';
import type { SheetBlock } from './case-study';
import type { ImageMetadata } from 'astro';

const images = import.meta.glob<ImageMetadata>('/src/assets/media-src/projects/web-dev/boda-marta-y-pedro/*.png', {
  eager: true,
  import: 'default',
});
const pic = (base: string): ImageMetadata =>
  images[`/src/assets/media-src/projects/web-dev/boda-marta-y-pedro/${base}.png`];

const blocks: SheetBlock[] = [
  { type: 'image', src: pic('boda-marta-y-pedro-phones-hero'), alt: 'Boda Marta and Pedro three-phone mockup' },
  { type: 'image', src: pic('boda-marta-y-pedro-devices-mockup'), alt: 'Boda Marta and Pedro multi-device mockup' },
  { type: 'image', src: pic('boda-marta-y-pedro-phone-mockup'), alt: 'Boda Marta and Pedro mobile mockup' },
  { type: 'video', src: '/media/videos/boda-marta-y-pedro-scroll-2.mp4', alt: 'Boda Marta and Pedro website preview video 2' },
  { type: 'image', src: pic('boda-marta-y-pedro-rsvp'), alt: 'Boda Marta and Pedro RSVP section' },
  { type: 'video', src: '/media/videos/boda-marta-y-pedro-scroll-3.mp4', alt: 'Boda Marta and Pedro website preview video 3' },
  { type: 'image', src: pic('boda-marta-y-pedro-accommodation'), alt: 'Boda Marta and Pedro accommodation section' },
  { type: 'text', title: 'Credits', paragraphs: ['Illustrations by HUECO Studio'] },
];

const { year = '', others = [] } = Astro.props;
---

<ProjectSheet
  year={year}
  others={others}
  title="Boda Marta & Pedro"
  projectParagraphs={[
    "In collaboration with HUECO Studio, renowned for their handcrafted illustrations, I developed a bespoke wedding invitation website for Marta and Pedro. The site showcases a clean, airy design with light color palettes and handwritten typefaces, reflecting the personal and intimate nature of their special day. HUECO Studio contributed exquisite manual illustrations that complement the site's aesthetic, adding a unique, artistic touch. This digital invitation provides essential information about the wedding and features a contact form, allowing guests to conveniently RSVP and interact with the event details online. The result is a beautifully simple yet functional website that enhances the wedding experience for every guest.",
  ]}
  responsibilities="Web design personalization, Squarespace setup, Site development, Website launch."
  blocks={blocks}
/>
