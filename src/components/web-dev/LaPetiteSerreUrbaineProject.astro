---
import ProjectSheet from '../v2/ProjectSheet.astro';
import type { SheetBlock } from './case-study';
import type { ImageMetadata } from 'astro';

const images = import.meta.glob<ImageMetadata>(
  '/src/assets/media-src/projects/web-dev/la-petite-serre-urbaine/*.png',
  { eager: true, import: 'default' },
);
const pic = (base: string): ImageMetadata =>
  images[`/src/assets/media-src/projects/web-dev/la-petite-serre-urbaine/${base}.png`];

const blocks: SheetBlock[] = [
  { type: 'video', src: '/media/videos/la-petite-serre-urbaine-scroll-1.mp4', alt: 'La Petite Serre Urbaine website preview video' },
  { type: 'image', src: pic('la-petite-serre-urbaine-home-1'), alt: 'La Petite Serre Urbaine homepage screen 1' },
  { type: 'image', src: pic('la-petite-serre-urbaine-home-2'), alt: 'La Petite Serre Urbaine homepage screen 2' },
  { type: 'image', src: pic('la-petite-serre-urbaine-home-3'), alt: 'La Petite Serre Urbaine homepage screen 3' },
  { type: 'image', src: pic('la-petite-serre-urbaine-evenements'), alt: 'La Petite Serre Urbaine events and decorations section' },
  { type: 'image', src: pic('la-petite-serre-urbaine-abonnements'), alt: 'La Petite Serre Urbaine floral subscriptions section' },
  { type: 'image', src: pic('la-petite-serre-urbaine-livraison'), alt: 'La Petite Serre Urbaine bouquet delivery section' },
  { type: 'image', src: pic('la-petite-serre-urbaine-ateliers'), alt: 'La Petite Serre Urbaine workshops and classes section' },
  { type: 'image', src: pic('la-petite-serre-urbaine-contact'), alt: 'La Petite Serre Urbaine contact section' },
];

const { year = '', others = [] } = Astro.props;
---

<ProjectSheet
  year={year}
  others={others}
  title="La petite serre urbaine"
  url={{ href: 'https://readymag.website/u2550487877/la-petite-serre-urbaine', label: 'readymag.website/u2550487877/la-petite-serre-urbaine' }}
  responsibilities="Web design personalization, Readymag setup, Site development, Website launch."
  projectParagraphs={[
    'Discover the essence of sustainable beauty at La Petite Serre Urbaine, a responsible florist based in Brussels. Our newly designed website mirrors the fresh and minimalist style that defines their boutique. Experience the simplicity and elegance of our user-friendly interface, where you can easily browse the services, and visualize a gallery of their creations.',
  ]}
  blocks={blocks}
  showContext
/>
