---
import ProjectSheet from '../v2/ProjectSheet.astro';
import type { SheetBlock } from './case-study';

import type { ImageMetadata } from 'astro';

const images = import.meta.glob<ImageMetadata>(
  '/src/assets/media-src/projects/web-dev/alyssa-coleman-back-of-house/*.png',
  { eager: true, import: 'default' },
);
const pad = (n: number) => String(n).padStart(2, '0');
const pic = (name: string): ImageMetadata =>
  images[`/src/assets/media-src/projects/web-dev/alyssa-coleman-back-of-house/alyssa-coleman-back-of-house-${name}.png`];

const swatches = [
  { hex: '#000000', rgb: '0, 0, 0', cmyk: '0, 0, 0, 100', textColor: '#FFFFFF' },
  { hex: '#380D0F', rgb: '56, 13, 15', cmyk: '0, 77, 73, 78', textColor: '#FFFFFF' },
  { hex: '#93B9D3', rgb: '147, 185, 211', cmyk: '30, 12, 0, 17', textColor: '#000000' },
  { hex: '#FCFAF5', rgb: '252, 250, 245', cmyk: '0, 1, 3, 1', textColor: '#000000' },
  { hex: '#E0DACE', rgb: '224, 218, 206', cmyk: '0, 3, 8, 12', textColor: '#000000' },
  { hex: '#59463A', rgb: '89, 70, 58', cmyk: '0, 21, 35, 65', textColor: '#FFFFFF' },
];

const still = (n: number): SheetBlock => ({
  type: 'image',
  src: pic(`still-${pad(n)}`),
  alt: `Back of House screen still ${pad(n)}`,
});
const motion = (n: number): SheetBlock => ({
  type: 'video',
  src: `/media/videos/alyssa-coleman-back-of-house-motion-${pad(n)}.mp4`,
  alt: `Back of House motion ${pad(n)}`,
});

const challenge =
  'Alyssa Coleman came to me with an existing Showit site that had grown organically over the years — and it showed. Pages felt disconnected, the visual hierarchy unclear, the layout lacking the intentional structure a personal brand at her level deserved. Meanwhile, Alyssa was pivoting entirely: new positioning, new audience, new energy — slow marketing and soft systems for creative entrepreneurs. The brand direction and visual identity were handled by Lara González. My job was to take that new brand and build a site that finally matched where she was going — from scratch, pushing Showit well beyond its defaults.';

const blocks: SheetBlock[] = [
  { type: 'image', src: pic('still-11'), alt: 'Back of House — redesigned site, full screen still' },
  { type: 'text', title: 'The challenge', paragraphs: [challenge] },
  {
    type: 'text',
    title: 'What we built',
    paragraphs: [
      'Translating a brand into a site — Lara\'s branding set the tone: cozy, intentional, soft. My role was to make the site feel exactly that way: every layout decision, spacing choice, and interaction designed to match the energy of the new positioning, not just apply the colors.',
      'A new content architecture — the pivot came with a new core offer: Back of House. I redesigned the entire site structure around it: new page hierarchy, new navigation logic, new user journey from first visit to conversion.',
      'Showit, pushed further — Showit has limits. I worked around them: customizing functionality, building interactions, and personalizing features well beyond what the platform offers out of the box.',
    ],
  },
  { type: 'palette', swatches, label: 'Alyssa Coleman color palette' },
  {
    type: 'text',
    title: 'Before',
    paragraphs: [
      'Scattered starting point',
      'A small sample of the previous site mood: uneven pacing, unclear hierarchy, and a visual language that no longer matched Alyssa\'s direction.',
    ],
  },
  ...[1, 2, 3, 4, 5, 6, 7].map((n): SheetBlock => ({
    type: 'image',
    src: pic(`before-${pad(n)}`),
    alt: `Alyssa Coleman site before redesign ${pad(n)}`,
  })),
  {
    type: 'text',
    title: 'After',
    paragraphs: [
      'Softened visual system',
      'A matching edit of final screens showing the new tone: warmer, clearer, softer, and built around the Back of House experience.',
    ],
  },
  ...[12, 14, 2, 9, 13].map(still),
  motion(1),
  still(7),
  motion(5),
  still(1),
  motion(4),
  motion(6),
];

const { year = '', others = [] } = Astro.props;
---

<ProjectSheet
  year={year}
  others={others}
  title="Alyssa Coleman"
  subtitle="Back of House"
  sector="Coaching for creatives"
  country="Canada"
  format="Showit website"
  tags={['Showit', 'Content architecture', 'Web redesign']}
  url={{ href: 'https://alyssa-coleman-3.showit.site/', label: 'alyssacoleman.ca' }}
  projectParagraphs={[challenge]}
  responsibilities="Showit full redesign - Content architecture - Page hierarchy &amp; navigation - Custom functionality &amp; interactions - Collaboration with brand designer Lara González - Launch"
  blocks={blocks}
  showContext={false}
/>
