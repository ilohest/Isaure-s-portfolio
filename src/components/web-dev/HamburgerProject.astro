---
import ProjectSheet from '../v2/ProjectSheet.astro';
import type { SheetBlock } from './case-study';
import type { ImageMetadata } from 'astro';

const images = import.meta.glob<ImageMetadata>(
  '/src/assets/media-src/projects/web-dev/hamburger/*.png',
  { eager: true, import: 'default' },
);
const pic = (base: string): ImageMetadata =>
  images[`/src/assets/media-src/projects/web-dev/hamburger/${base}.png`];

const SITE = 'http://the-perfect-hamburger.tilda.ws/';

const blocks: SheetBlock[] = [
  { type: 'video', src: '/media/videos/video-the-perfect-burger.mp4', alt: 'The perfect hamburger animated homepage preview' },
  { type: 'image', src: pic('hamburger-intro'), alt: 'The perfect hamburger intro section' },
  { type: 'image', src: pic('hamburger-signature-burger'), alt: 'The perfect hamburger signature burger section' },
  { type: 'image', src: pic('hamburger-ingredients'), alt: 'The perfect hamburger ingredients section' },
  { type: 'image', src: pic('hamburger-eco-responsibility'), alt: 'The perfect hamburger eco responsibility section' },
  { type: 'image', src: pic('hamburger-social-wall'), alt: 'The perfect hamburger social wall section' },
  { type: 'image', src: pic('hamburger-organic-local'), alt: 'The perfect hamburger organic and local sourcing section' },
];

const { year = '', others = [] } = Astro.props;
---

<ProjectSheet
  year={year}
  others={others}
  title="The perfect hamburger"
  url={{ href: SITE, label: 'the-perfect-hamburger.tilda.ws' }}
  responsibilities="Web design personalization, Tilda setup, Site development, Website launch."
  projectParagraphs={[
    `Discover the ultimate burger experience with our website for "The perfect hamburger". Each animation brings the flavors to life, making you almost taste the savory, juicy burgers through your screen. The seamless navigation with subtle animations guide you through the restaurant's story and menu. The parallax scrolling and dynamic effects create a delightful journey from start to finish. Feast your eyes on our high-definition, animated displays of "The perfect Hamburger's" signature burgers. Enjoy exploring this site, where each click unveils a new layer of the gourmet burger world!`,
  ]}
  blocks={blocks}
  showContext
/>
