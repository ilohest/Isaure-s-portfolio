---
const M = '/assets/media/projects/branding/bellelachaise';

const avifSrcset = (base: string) =>
  `${M}/${base}-640.avif 640w, ${M}/${base}-960.avif 960w, ${M}/${base}-1280.avif 1280w, ${M}/${base}-1920.avif 1920w`;

type MasonryItem =
  | { type?: 'image'; base: string; alt: string }
  | { type: 'palette' };

const masonryItems: MasonryItem[] = [
  { base: 'blc-desktop-image2', alt: 'Bellelachaise desktop screenshot' },
  { base: 'blc4',               alt: 'Bellelachaise 4' },
  { base: 'blc3',               alt: 'Bellelachaise 3' },
  { base: 'blc2',               alt: 'Bellelachaise 2' },
  { base: 'blc10',              alt: 'Bellelachaise 10' },
  { base: 'blc13',              alt: 'Bellelachaise 13' },
  { base: 'blc-vitrine1',       alt: 'Bellelachaise vitrine' },
  { type: 'palette' },
  { base: 'blc12',              alt: 'Bellelachaise 12' },
  { base: 'blc6',               alt: 'Bellelachaise 6' },
  { base: 'blc9',               alt: 'Bellelachaise 9' },
  { base: 'blc11',              alt: 'Bellelachaise 11' },
  { base: 'blc14',              alt: 'Bellelachaise 14' },
];

const swatches = [
  { hex: '#352e38', rgb: '53, 46, 56',    cmyk: '5, 18, 0, 78',  textColor: '#fbfaf6' },
  { hex: '#a47764', rgb: '164, 119, 100', cmyk: '0, 27, 39, 36', textColor: '#fbfaf6' },
  { hex: '#cd9b8c', rgb: '205, 155, 140', cmyk: '0, 24, 32, 20', textColor: '#352e38' },
  { hex: '#e1dcd6', rgb: '225, 220, 214', cmyk: '0, 2, 5, 12',   textColor: '#352e38' },
  { hex: '#fbfaf6', rgb: '251, 250, 246', cmyk: '0, 0, 2, 2',    textColor: '#352e38' },
];

const masonrySizes = '(min-width: 970px) 28vw, (min-width: 628px) 44vw, 92vw';
const delay = (i: number) => `${Math.min(i * 32, 420)}ms`;

const projectParagraphs = [
  'This project brings iconic 1970s–80s vintage furniture through a minimalist lens. Each piece — carefully selected for its era-defining form and quality — is refined to its essence: clean lines, natural materials, and a muted palette that blends simplicity with warmth.',
  'The result is a cohesive collection that honors the bold silhouettes of the past while delivering a serene, contemporary aesthetic. Perfectly balanced between nostalgia and modern restraint, this curated lineup brings timeless character and effortless sophistication to any living space.',
];

const brandingParagraphs = [
  'This logo takes the clean outline of a classic mid-century chair and distills it into a single, uninterrupted line — an abstract "Pantone silhouette" that immediately suggests both design precision and timeless comfort. The slender serifs and high-contrast strokes lend a timeless, upscale feel with a modern, approachable touch.',
  'Rendered in a deep, muted charcoal, the palette hints at sophistication and pairs beautifully with the color palette. The palette draws directly from Pantone\'s 2024 selection evoking a sense of contemporary sophistication. Together, type and icon form a cohesive logo that speaks directly to the brand\'s promise: carefully curated, design-forward vintage furnishings brought to life in a minimalist, boutique setting.',
];
---

<section class="blcb-project relative flex flex-col">
  <div class="blcb-layout">
    <aside class="blcb-sticky">
      <header class="blcb-headline">
        <p class="project-title-reveal blcb-title font-display m-0 uppercase" aria-hidden="true">
          <span class="project-title-reveal__inner">Bellelachaise</span>
        </p>
        <ul class="blcb-tags" aria-label="Project tags">
          <li>Branding</li>
          <li>Art direction</li>
          <li>Visual identity</li>
        </ul>
        <div class="blcb-meta" aria-label="Project details">
          <p><i>Client: </i>Bellelachaise</p>
          <p><i>Sector: </i>Home décor &amp; Vintage furniture</p>
          <p><i>Country: </i>Belgium</p>
          <p>
            <i>Instagram: </i>
            <a href="https://www.instagram.com/bellelachaise/" target="_blank" rel="noopener noreferrer">@bellelachaise</a>
          </p>
        </div>
      </header>
    </aside>

    <div class="blcb-main-flow">
      <figure class="blcb-hero">
        <img
          src={`${M}/blc1-960.avif`}
          srcset={avifSrcset('blc1')}
          sizes="(min-width: 1280px) 64vw, (min-width: 970px) calc(100vw - 24rem), calc(100vw - 2rem)"
          alt="Bellelachaise — brand identity"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </figure>

      <section class="blcb-study-card masonry-reveal" aria-label="Bellelachaise case study">
        <article class="blcb-block">
          <h2 class="blcb-block__title">Project</h2>
          <hr class="blcb-block__rule" />
          <div class="blcb-block__body">
            {projectParagraphs.map((p) => <p>{p}</p>)}
          </div>
        </article>

        <article class="blcb-block">
          <h2 class="blcb-block__title">Branding</h2>
          <hr class="blcb-block__rule" />
          <div class="blcb-block__body">
            {brandingParagraphs.map((p) => <p>{p}</p>)}
          </div>
        </article>

        <article class="blcb-block">
          <h2 class="blcb-block__title">Responsibilities</h2>
          <hr class="blcb-block__rule" />
          <div class="blcb-block__body">
            <p>Visual identity — Art direction</p>
          </div>
        </article>
      </section>

      <figure class="blcb-feature masonry-reveal">
        <img
          src={`${M}/blc8-960.avif`}
          srcset={avifSrcset('blc8')}
          sizes="(min-width: 1280px) 30vw, (min-width: 970px) 20vw, 50vw"
          alt="Bellelachaise — logo on terracotta background"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <section
        class="blcb-masonry"
        data-masonry
        data-cols-desktop="3"
        data-cols-tablet="2"
        data-cols-mobile="1"
        aria-label="Bellelachaise visual identity gallery"
      >
        {
          masonryItems.map((item, i) => (
            <article class="masonry-item masonry-reveal" style={`--reveal-delay: ${delay(i)}`}>
              {item.type === 'palette' ? (
                <div class="palette-card" role="group" aria-label="Bellelachaise color palette">
                  <div class="palette-grid">
                    {swatches.map((sw) => (
                      <div class="palette-swatch" style={`background-color:${sw.hex};color:${sw.textColor}`}>
                        <div class="palette-label">
                          <p class="palette-line">HEX {sw.hex.toUpperCase()}</p>
                          <p class="palette-line">RGB {sw.rgb}</p>
                          <p class="palette-line">CMYK {sw.cmyk}</p>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              ) : (
                <img
                  src={`${M}/${item.base}-960.avif`}
                  srcset={avifSrcset(item.base)}
                  sizes={masonrySizes}
                  alt={item.alt}
                  loading="lazy"
                  decoding="async"
                  class="blcb-masonry-media"
                />
              )}
            </article>
          ))
        }
      </section>

      <figure class="blcb-final masonry-reveal">
        <img
          src={`${M}/blc7-960.avif`}
          srcset={avifSrcset('blc7')}
          sizes="(min-width: 1280px) 64vw, (min-width: 970px) calc(100vw - 24rem), calc(100vw - 2rem)"
          alt="Bellelachaise — closing visual"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </div>
</section>

<script>
  import '../../scripts/masonry-columns.ts';
  import '../../scripts/masonry-reveal.ts';
</script>

<style>
  :global(.project-detail-page) > .blcb-project {
    width: 100%;
    max-width: min(100%, 1680px);
    margin-inline: auto;
    padding-inline: 20px;
    padding-block: clamp(0.5rem, 2vw, 1.5rem);
  }

  .blcb-layout {
    display: grid;
    grid-template-columns: minmax(18rem, 0.72fr) minmax(0, 1.58fr);
    gap: clamp(2rem, 4vw, 5rem);
    align-items: start;
  }

  .blcb-sticky {
    position: sticky;
    top: clamp(4rem, 7vw, 5.5rem);
    min-width: 0;
  }

  .blcb-headline {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .blcb-title {
    max-width: none;
    color: var(--text-primary);
    font-size: clamp(2rem, 3.8vw, 3.8rem);
    line-height: 0.92;
  }

  .blcb-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .blcb-tags li {
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 0.42rem 0.7rem;
    color: var(--text-primary);
    font-family: var(--font-family-display);
    font-size: 0.78rem;
    line-height: 1;
    text-transform: uppercase;
  }

  .blcb-meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    max-width: 31ch;
    color: var(--text-secondary);
    font-family: var(--font-family-body);
    font-size: 0.95rem;
    font-weight: 300;
    line-height: 1.45;
  }

  .blcb-meta p {
    margin: 0;
  }

  .blcb-meta i {
    color: var(--text-primary);
    font-style: italic;
    text-transform: uppercase;
  }

  .blcb-meta a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.16em;
  }

  .blcb-main-flow {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: clamp(2.4rem, 6vw, 4.5rem);
  }

  .blcb-hero {
    overflow: hidden;
    width: 100%;
    margin: 0;
    border-radius: var(--project-card-radius);
    background: #f5f0eb;
    box-shadow:
      0 18px 42px rgba(35, 35, 35, 0.12),
      0 4px 12px rgba(35, 35, 35, 0.07);
  }

  .blcb-hero img {
    display: block;
    width: 100%;
    height: auto;
  }

  .blcb-study-card {
    display: flex;
    width: 100%;
    flex-direction: column;
    gap: clamp(2.4rem, 6vw, 4.5rem);
    padding: clamp(1.4rem, 2.8vw, 2.4rem);
    margin-block: clamp(0.4rem, 1.6vw, 1.4rem);
    background: var(--palette-white);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
  }

  .blcb-block__title {
    margin: 0;
    color: var(--text-primary);
    font-family: var(--font-family-display);
    font-size: clamp(1.1rem, 1.9vw, 1.7rem);
    font-weight: 400;
    letter-spacing: 0.04em;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .blcb-block__rule {
    width: 100%;
    height: 0;
    margin: clamp(0.8rem, 1.6vw, 1.2rem) 0 clamp(1.2rem, 2.6vw, 2rem);
    border: 0;
    border-top: 1px solid color-mix(in srgb, var(--text-primary) 26%, transparent);
  }

  .blcb-block__body {
    display: flex;
    width: min(100%, 62ch);
    margin-left: auto;
    flex-direction: column;
    gap: 1rem;
    color: var(--text-secondary);
    font-family: var(--font-family-body);
    font-weight: 300;
  }

  .blcb-block__body p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.65;
  }

  .blcb-feature {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    overflow: hidden;
    border-radius: var(--project-card-radius);
    background: #a47764;
    padding-block: clamp(6rem, 14vw, 12rem);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
  }

  .blcb-feature img {
    display: block;
    width: min(50%, 370px);
    height: auto;
  }

  .blcb-masonry {
    display: flex;
    gap: clamp(0.75rem, 1.8vw, 1rem);
    align-items: flex-start;
    border-radius: var(--project-card-radius);
  }

  .blcb-masonry :global(.masonry-col) {
    flex: 1 1 0;
    min-width: 0;
  }

  .palette-card {
    overflow: hidden;
    width: 100%;
    border-radius: var(--project-card-radius);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
  }

  .palette-grid {
    display: flex;
    width: 100%;
    flex-direction: column;
  }

  .palette-swatch {
    flex: 1 1 0;
    min-width: 0;
    min-height: 90px;
    display: flex;
    align-items: flex-end;
    transition:
      flex-grow 260ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 260ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 260ms ease;
  }

  .palette-label {
    padding: 1rem;
    line-height: 1.25;
    letter-spacing: 0.01em;
    transition:
      padding 260ms cubic-bezier(0.22, 1, 0.36, 1),
      letter-spacing 260ms ease;
  }

  .palette-line {
    margin: 0;
    white-space: nowrap;
    font-size: 0.9rem;
    font-family: var(--font-family-body);
    font-weight: 300;
  }

  .palette-swatch:hover {
    flex-grow: 1.18;
    transform: scale(1.035);
    filter: saturate(1.08) brightness(1.02);
    z-index: 1;
  }

  .palette-swatch:hover .palette-label {
    padding: 1.2rem;
    letter-spacing: 0.06em;
  }

  .blcb-masonry-media {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--project-card-radius);
    background: #f5f0eb;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
  }

  .blcb-final {
    margin: 0;
    overflow: hidden;
    width: 100%;
    border-radius: var(--project-card-radius);
    background: #f5f0eb;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
  }

  .blcb-final img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 960px) {
    .blcb-layout {
      grid-template-columns: 1fr;
      gap: clamp(1.5rem, 5vw, 3rem);
    }

    .blcb-sticky {
      position: static;
    }

    .blcb-title {
      max-width: none;
      font-size: clamp(1.8rem, 8vw, 3.2rem);
    }

    .blcb-meta,
    .blcb-block__body {
      max-width: none;
      width: 100%;
      margin-left: 0;
    }
  }

  @media (max-width: 628px) {
    .blcb-masonry {
      flex-direction: column;
      gap: 0.75rem;
    }

    .blcb-study-card {
      gap: 2rem;
    }
  }
</style>
