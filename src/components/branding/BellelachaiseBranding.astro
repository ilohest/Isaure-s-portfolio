---
import ProjectSheet from '../v2/ProjectSheet.astro';
import type { SheetBlock } from '../web-dev/case-study';
import type { ImageMetadata } from 'astro';

const images = import.meta.glob<ImageMetadata>('/src/assets/media-src/projects/branding/bellelachaise/*.avif', {
  eager: true,
  import: 'default',
});
const pic = (base: string): ImageMetadata =>
  images[`/src/assets/media-src/projects/branding/bellelachaise/${base}.avif`];

const { year = '', others = [] } = Astro.props;

const swatches = [
  { hex: '#352e38', rgb: '53, 46, 56', cmyk: '5, 18, 0, 78', textColor: '#fbfaf6' },
  { hex: '#a47764', rgb: '164, 119, 100', cmyk: '0, 27, 39, 36', textColor: '#fbfaf6' },
  { hex: '#cd9b8c', rgb: '205, 155, 140', cmyk: '0, 24, 32, 20', textColor: '#352e38' },
  { hex: '#e1dcd6', rgb: '225, 220, 214', cmyk: '0, 2, 5, 12', textColor: '#352e38' },
  { hex: '#fbfaf6', rgb: '251, 250, 246', cmyk: '0, 0, 2, 2', textColor: '#352e38' },
];

const projectParagraphs = [
  'This project brings iconic 1970s–80s vintage furniture through a minimalist lens. Each piece — carefully selected for its era-defining form and quality — is refined to its essence: clean lines, natural materials, and a muted palette that blends simplicity with warmth.',
  'The result is a cohesive collection that honors the bold silhouettes of the past while delivering a serene, contemporary aesthetic. Perfectly balanced between nostalgia and modern restraint, this curated lineup brings timeless character and effortless sophistication to any living space.',
];

const brandingParagraphs = [
  'This logo takes the clean outline of a classic mid-century chair and distills it into a single, uninterrupted line — an abstract "Pantone silhouette" that immediately suggests both design precision and timeless comfort. The slender serifs and high-contrast strokes lend a timeless, upscale feel with a modern, approachable touch.',
  'Rendered in a deep, muted charcoal, the palette hints at sophistication and pairs beautifully with the color palette. The palette draws directly from Pantone\'s 2024 selection evoking a sense of contemporary sophistication. Together, type and icon form a cohesive logo that speaks directly to the brand\'s promise: carefully curated, design-forward vintage furnishings brought to life in a minimalist, boutique setting.',
];

const img = (base: string, alt: string): SheetBlock => ({ type: 'image', src: pic(base), alt });

const blocks: SheetBlock[] = [
  img('blc1', 'Bellelachaise — brand identity'),
  { type: 'text', title: 'Project', paragraphs: projectParagraphs },
  { type: 'text', title: 'Branding', paragraphs: brandingParagraphs },
  img('blc8', 'Bellelachaise — logo on terracotta background'),
  img('blc-desktop-image2', 'Bellelachaise desktop screenshot'),
  img('blc4', 'Bellelachaise 4'),
  img('blc3', 'Bellelachaise 3'),
  img('blc2', 'Bellelachaise 2'),
  img('blc10', 'Bellelachaise 10'),
  img('blc13', 'Bellelachaise 13'),
  img('blc-vitrine1', 'Bellelachaise vitrine'),
  { type: 'palette', swatches, label: 'Bellelachaise color palette' },
  img('blc12', 'Bellelachaise 12'),
  img('blc6', 'Bellelachaise 6'),
  img('blc9', 'Bellelachaise 9'),
  img('blc11', 'Bellelachaise 11'),
  img('blc14', 'Bellelachaise 14'),
  img('blc7', 'Bellelachaise — closing visual'),
];
---

<ProjectSheet
  year={year}
  others={others}
  title="Bellelachaise"
  sector="Home décor & Vintage furniture"
  country="Belgium"
  url={{ href: 'https://www.instagram.com/bellelachaise/', label: '@bellelachaise' }}
  tags={['Branding', 'Art direction', 'Visual identity']}
  responsibilities="Visual identity — Art direction"
  projectParagraphs={[projectParagraphs[0]]}
  blocks={blocks}
  showContext={false}
/>
