---
import ResponsiveImage from '../media/ResponsiveImage.astro';
import type { ImageMetadata } from 'astro';

const images = import.meta.glob<ImageMetadata>(
  '/src/assets/media-src/projects/branding/elinor/*.png',
  { eager: true, import: 'default' },
);
const pic = (base: string): ImageMetadata =>
  images[`/src/assets/media-src/projects/branding/elinor/${base}.png`];

const galleryItems: { base: string; alt: string }[] = [
  { base: 'elinor-hands-campaign', alt: 'Elinor hands campaign visual' },
  { base: 'elinor-cover-photo', alt: 'Elinor social cover image' },
  { base: 'elinor-logo-light', alt: 'Elinor van de Werve light logo composition' },
  { base: 'elinor-business-cards', alt: 'Elinor business cards mockup' },
  { base: 'elinor-icon-blue', alt: 'Elinor icon on blue background' },
  { base: 'elinor-instagram-profile', alt: 'Elinor Instagram profile overview' },
  { base: 'elinor-post-01', alt: 'Elinor Instagram post 1' },
  { base: 'elinor-instagram-main', alt: 'Elinor Instagram main feed view' },
  { base: 'elinor-post-02', alt: 'Elinor Instagram post 2' },
  { base: 'elinor-instagram-search-picks', alt: 'Elinor Instagram search picks view' },
  { base: 'elinor-post-03', alt: 'Elinor Instagram post 3' },
  { base: 'elinor-story-08', alt: 'Elinor Instagram story design 8' },
  { base: 'elinor-post-05', alt: 'Elinor Instagram post 5' },
  { base: 'elinor-instagram-story-ui', alt: 'Elinor Instagram story interface view' },
  { base: 'elinor-post-07', alt: 'Elinor Instagram post 7' },
  { base: 'elinor-post-08', alt: 'Elinor Instagram post 8' },
  { base: 'elinor-brandbook-spread-08', alt: 'Elinor brandbook spread 8' },
  { base: 'elinor-brandbook-spread-05', alt: 'Elinor brandbook spread 5' },
  { base: 'elinor-post-09', alt: 'Elinor Instagram post 9' },
  { base: 'elinor-post-10', alt: 'Elinor Instagram post 10' },
  { base: 'elinor-post-11', alt: 'Elinor Instagram post 11' },
  { base: 'elinor-post-12', alt: 'Elinor Instagram post 12' },
  { base: 'elinor-brandbook-spread-22', alt: 'Elinor brandbook spread 22' },
];

const masonrySizes = '(min-width: 970px) 28vw, (min-width: 628px) 44vw, 92vw';
const delay = (i: number) => `${Math.min(i * 32, 420)}ms`;
---

<section class="elinor-project relative flex flex-col">
  <div class="elinor-layout">
    <aside class="elinor-sticky">
      <header class="elinor-headline">
        <p class="project-title-reveal elinor-title font-display m-0 uppercase" aria-hidden="true">
          <span class="project-title-reveal__inner">Elinor</span>
        </p>
        <ul class="elinor-tags" aria-label="Project tags">
          <li>Branding</li>
          <li>Art direction</li>
          <li>Social media</li>
        </ul>
        <div class="elinor-meta" aria-label="Project details">
          <p><i>Client: </i>Elinor kinésiologie</p>
          <p><i>Sector: </i>Health &amp; wellness</p>
          <p><i>Country: </i>Belgium</p>
          <p><i>Format: </i>Visual identity</p>
        </div>
      </header>
    </aside>

    <div class="elinor-main-flow">
      <figure class="elinor-hero">
        <ResponsiveImage
          src={pic('elinor-logo-blue')}
          alt="Elinor van de Werve blue logo composition"
          sizes="(min-width: 1280px) 64vw, (min-width: 970px) calc(100vw - 24rem), calc(100vw - 2rem)"
          loading="eager"
          fetchpriority="high"
          class="elinor-hero-picture"
          imgClass="elinor-hero-img"
        />
      </figure>

      <section class="elinor-study-card masonry-reveal" aria-label="Elinor case study">
        <article class="elinor-block">
          <h2 class="elinor-block__title">Project</h2>
          <hr class="elinor-block__rule" />
          <div class="elinor-block__body">
            <p>
              Elinor Kinesiology offers personalized holistic care that gently balances body and mind
              through expert muscle-response testing and tailored energy techniques. Elinor creates a
              nurturing environment for expectant mothers, alleviating stress, easing tension, and
              promoting optimal well-being for both mother and baby. Elinor's compassionate approach
              adapts the unique needs of the patients, guiding them toward a more harmonious, energized,
              and empowered journey.
            </p>
          </div>
        </article>

        <article class="elinor-block">
          <h2 class="elinor-block__title">Branding</h2>
          <hr class="elinor-block__rule" />
          <div class="elinor-block__body">
            <p>
              This logo is built on a continuous, flowing line that forms an infinity loop, an
              intentional nod to the unending cycle of energy in the body. Its shape subtly echoes the
              therapist's hands in motion, listening and responding to the body's own signals. By
              bridging earth and sky, the logo embodies restored balance and the seamless connection
              between physical sensation and emotional well-being. With its clean, organic form, it
              communicates professionalism, trust, and the core kinesiological promise of guiding clients
              back to their natural state of harmony. The typography uses slender, elegant typefaces with
              generous letter-spacing, projecting both precision and refinement. The color palette is
              built from soft pastels, muted tones that work together to soothe the senses and reinforce
              the brand's promise of balanced, restorative care.
            </p>
          </div>
        </article>

        <article class="elinor-block">
          <h2 class="elinor-block__title">Responsibilities</h2>
          <hr class="elinor-block__rule" />
          <div class="elinor-block__body">
            <p>Visual identity — Art direction — Social network templates</p>
          </div>
        </article>
      </section>

      <section
        class="elinor-masonry"
        data-masonry
        data-cols-desktop="3"
        data-cols-tablet="2"
        data-cols-mobile="1"
        aria-label="Elinor visual identity gallery"
      >
        {
          galleryItems.map((item, i) => (
            <article class="masonry-item masonry-reveal" style={`--reveal-delay: ${delay(i)}`}>
              <ResponsiveImage
                src={pic(item.base)}
                alt={item.alt}
                sizes={masonrySizes}
                loading="lazy"
                fetchpriority="low"
                imgClass="elinor-masonry-media"
              />
            </article>
          ))
        }
      </section>
    </div>
  </div>
</section>

<script>
  import '../../scripts/masonry-columns.ts';
  import '../../scripts/masonry-reveal.ts';
</script>

<style>
  :global(.project-detail-page) > .elinor-project {
    width: 100%;
    max-width: min(100%, 1680px);
    margin-inline: auto;
    padding-inline: 20px;
    padding-block: clamp(0.5rem, 2vw, 1.5rem);
  }

  .elinor-layout {
    display: grid;
    grid-template-columns: minmax(18rem, 0.72fr) minmax(0, 1.58fr);
    gap: clamp(2rem, 4vw, 5rem);
    align-items: start;
  }

  .elinor-sticky {
    position: sticky;
    top: clamp(1rem, 3vw, 2.5rem);
    min-width: 0;
  }

  .elinor-headline {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .elinor-title {
    max-width: 8ch;
    color: var(--text-primary);
    font-size: clamp(2.8rem, 6vw, 5.2rem);
    line-height: 0.92;
  }

  .elinor-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .elinor-tags li {
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 0.42rem 0.7rem;
    color: var(--text-primary);
    font-family: var(--font-family-display);
    font-size: 0.78rem;
    line-height: 1;
    text-transform: uppercase;
  }

  .elinor-meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    max-width: 31ch;
    color: var(--text-secondary);
    font-family: var(--font-family-body);
    font-size: 0.95rem;
    font-weight: 300;
    line-height: 1.45;
  }

  .elinor-meta p {
    margin: 0;
  }

  .elinor-meta i {
    color: var(--text-primary);
    font-style: italic;
    text-transform: uppercase;
  }

  .elinor-main-flow {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: clamp(2.4rem, 6vw, 4.5rem);
  }

  .elinor-hero {
    overflow: hidden;
    width: 100%;
    margin: 0;
    border-radius: var(--project-card-radius);
    background: #f7efe4;
    box-shadow:
      0 18px 42px rgba(35, 35, 35, 0.12),
      0 4px 12px rgba(35, 35, 35, 0.07);
  }

  .elinor-hero :global(.elinor-hero-picture) {
    display: block;
  }

  .elinor-hero :global(.elinor-hero-img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0;
  }

  .elinor-study-card {
    display: flex;
    width: 100%;
    flex-direction: column;
    gap: clamp(2.4rem, 6vw, 4.5rem);
    padding: clamp(1.4rem, 2.8vw, 2.4rem);
    margin-block: clamp(0.4rem, 1.6vw, 1.4rem);
    background: var(--palette-white);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
  }

  .elinor-block__title {
    margin: 0;
    color: var(--text-primary);
    font-family: var(--font-family-display);
    font-size: clamp(1.1rem, 1.9vw, 1.7rem);
    font-weight: 400;
    letter-spacing: 0.04em;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .elinor-block__rule {
    width: 100%;
    height: 0;
    margin: clamp(0.8rem, 1.6vw, 1.2rem) 0 clamp(1.2rem, 2.6vw, 2rem);
    border: 0;
    border-top: 1px solid color-mix(in srgb, var(--text-primary) 26%, transparent);
  }

  .elinor-block__body {
    display: flex;
    width: min(100%, 62ch);
    margin-left: auto;
    flex-direction: column;
    gap: 1rem;
    color: var(--text-secondary);
    font-family: var(--font-family-body);
    font-weight: 300;
  }

  .elinor-block__body p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.65;
  }

  .elinor-masonry {
    display: flex;
    gap: clamp(0.75rem, 1.8vw, 1rem);
    align-items: flex-start;
    border-radius: var(--project-card-radius);
  }

  .elinor-masonry :global(.masonry-col) {
    flex: 1 1 0;
    min-width: 0;
  }

  .elinor-masonry :global(.elinor-masonry-media) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--project-card-radius);
    background: #f7efe4;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
  }

  @media (max-width: 960px) {
    .elinor-layout {
      grid-template-columns: 1fr;
      gap: clamp(1.5rem, 5vw, 3rem);
    }

    .elinor-sticky {
      position: static;
    }

    .elinor-title {
      max-width: none;
      font-size: clamp(2.7rem, 15vw, 4.8rem);
    }

    .elinor-meta,
    .elinor-block__body {
      width: 100%;
      max-width: none;
      margin-left: 0;
    }
  }

  @media (max-width: 628px) {
    .elinor-masonry {
      flex-direction: column;
      gap: 0.75rem;
    }

    .elinor-study-card {
      gap: 2rem;
    }
  }
</style>
