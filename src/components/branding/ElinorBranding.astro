---
import ProjectSheet from '../v2/ProjectSheet.astro';
import type { SheetBlock } from '../web-dev/case-study';
import type { ImageMetadata } from 'astro';

const images = import.meta.glob<ImageMetadata>('/src/assets/media-src/projects/branding/elinor/*.png', {
  eager: true,
  import: 'default',
});
const pic = (base: string): ImageMetadata =>
  images[`/src/assets/media-src/projects/branding/elinor/${base}.png`];

const { year = '', others = [] } = Astro.props;

type GalleryItem =
  | { type?: 'image'; base: string; alt: string }
  | { type: 'palette'; swatches: { hex: string; rgb: string; cmyk: string; textColor: string }[] };

const galleryItems: GalleryItem[] = [
  { base: 'elinor-hands-campaign', alt: 'Elinor hands campaign visual' },
  { base: 'elinor-cover-photo', alt: 'Elinor social cover image' },
  { base: 'elinor-logo-light', alt: 'Elinor van de Werve light logo composition' },
  { base: 'elinor-business-cards', alt: 'Elinor business cards mockup' },
  { type: 'palette', swatches: [
    { hex: '#FFFFFF', rgb: '255, 255, 255', cmyk: '0, 0, 0, 0', textColor: '#222B34' },
    { hex: '#C7B39A', rgb: '199, 179, 154', cmyk: '0, 10, 23, 22', textColor: '#222B34' },
    { hex: '#F7EFE4', rgb: '247, 239, 228', cmyk: '0, 3, 8, 3',    textColor: '#222B34' },
    { hex: '#FCDFCD', rgb: '252, 223, 205', cmyk: '0, 12, 19, 1', textColor: '#222B34' },
    { hex: '#DCB2A2', rgb: '220, 178, 162', cmyk: '0, 19, 26, 14', textColor: '#222B34' },
    { hex: '#5F758B', rgb: '95, 117, 139',  cmyk: '32, 16, 0, 45', textColor: '#FFFFFF' },
    { hex: '#222B34', rgb: '34, 43, 52',    cmyk: '35, 17, 0, 80', textColor: '#FFFFFF' },
  ] },
  { base: 'elinor-icon-blue', alt: 'Elinor icon on blue background' },
  { base: 'elinor-instagram-profile', alt: 'Elinor Instagram profile overview' },
  { base: 'elinor-post-01', alt: 'Elinor Instagram post 1' },
  { base: 'elinor-instagram-main', alt: 'Elinor Instagram main feed view' },
  { base: 'elinor-post-02', alt: 'Elinor Instagram post 2' },
  { base: 'elinor-instagram-search-picks', alt: 'Elinor Instagram search picks view' },
  { base: 'elinor-post-03', alt: 'Elinor Instagram post 3' },
  { base: 'elinor-story-08', alt: 'Elinor Instagram story design 8' },
  { base: 'elinor-post-05', alt: 'Elinor Instagram post 5' },
  { base: 'elinor-instagram-story-ui', alt: 'Elinor Instagram story interface view' },
  { base: 'elinor-post-07', alt: 'Elinor Instagram post 7' },
  { base: 'elinor-post-08', alt: 'Elinor Instagram post 8' },
  { base: 'elinor-brandbook-spread-08', alt: 'Elinor brandbook spread 8' },
  { base: 'elinor-brandbook-spread-05', alt: 'Elinor brandbook spread 5' },
  { base: 'elinor-post-09', alt: 'Elinor Instagram post 9' },
  { base: 'elinor-post-10', alt: 'Elinor Instagram post 10' },
  { base: 'elinor-post-11', alt: 'Elinor Instagram post 11' },
  { base: 'elinor-post-12', alt: 'Elinor Instagram post 12' },
  { base: 'elinor-brandbook-spread-22', alt: 'Elinor brandbook spread 22' },
];

const projectParagraphs = [
  "Elinor Kinesiology offers personalized holistic care that gently balances body and mind through expert muscle-response testing and tailored energy techniques. Elinor creates a nurturing environment for expectant mothers, alleviating stress, easing tension, and promoting optimal well-being for both mother and baby. Elinor's compassionate approach adapts the unique needs of the patients, guiding them toward a more harmonious, energized, and empowered journey.",
];
const brandingParagraphs = [
  "This logo is built on a continuous, flowing line that forms an infinity loop, an intentional nod to the unending cycle of energy in the body. Its shape subtly echoes the therapist's hands in motion, listening and responding to the body's own signals. By bridging earth and sky, the logo embodies restored balance and the seamless connection between physical sensation and emotional well-being. With its clean, organic form, it communicates professionalism, trust, and the core kinesiological promise of guiding clients back to their natural state of harmony. The typography uses slender, elegant typefaces with generous letter-spacing, projecting both precision and refinement. The color palette is built from soft pastels, muted tones that work together to soothe the senses and reinforce the brand's promise of balanced, restorative care.",
];

const blocks: SheetBlock[] = [
  { type: 'image', src: pic('elinor-logo-blue'), alt: 'Elinor van de Werve blue logo composition' },
  { type: 'text', title: 'Project', paragraphs: projectParagraphs },
  { type: 'text', title: 'Branding', paragraphs: brandingParagraphs },
  ...galleryItems.map((item): SheetBlock =>
    item.type === 'palette'
      ? { type: 'palette', swatches: item.swatches, label: 'Elinor color palette' }
      : { type: 'image', src: pic(item.base), alt: item.alt },
  ),
];
---

<ProjectSheet
  year={year}
  others={others}
  title="Elinor"
  subtitle="kinésiologie"
  sector="Health & wellness"
  country="Belgium"
  format="Visual identity"
  tags={['Branding', 'Art direction', 'Social media']}
  responsibilities="Visual identity — Art direction — Social network templates"
  projectParagraphs={projectParagraphs}
  blocks={blocks}
  showContext={false}
/>
