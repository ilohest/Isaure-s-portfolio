---
import ProjectSheet from '../v2/ProjectSheet.astro';
import type { SheetBlock } from '../web-dev/case-study';
import type { ImageMetadata } from 'astro';

const pngs = import.meta.glob<ImageMetadata>('/src/assets/media-src/projects/branding/canpruna-accomodation/*.png', {
  eager: true,
  import: 'default',
});
const avifs = import.meta.glob<ImageMetadata>('/src/assets/media-src/projects/branding/canpruna-accomodation/*.avif', {
  eager: true,
  import: 'default',
});
const D = '/src/assets/media-src/projects/branding/canpruna-accomodation';
const pic = (base: string): ImageMetadata => pngs[`${D}/${base}.png`] ?? avifs[`${D}/${base}.avif`];

const { year = '', others = [] } = Astro.props;

const img = (base: string, alt: string): SheetBlock => ({ type: 'image', src: pic(base), alt });

const projectParagraphs = [
  'Can Pruna is a rural accommodation in Catalonia, surrounded by dry stone, olive tones, and the quiet rhythm of the Montseny landscape.',
  'The identity distills that atmosphere into a calm visual story anchored by earth, olive, stone, and warm white tones drawn from the site.',
  'Hand-sketched elements bring an artisanal touch, while generous spacing gives the photography and line art room to breathe.',
  'I also photographed and retouched the site imagery so the visual world feels quiet, hospitable, and directly connected to the Masia.',
];

// Les noms de couleurs d'origine (Charcoal, Forest, Olive, Stone, Warm white, White) ne sont pas affichables ; RGB/CMYK calculés depuis le hex.
const swatches = [
  { hex: '#1B1816', rgb: '27, 24, 22', cmyk: '0, 11, 19, 89', textColor: '#F6F3EE' },
  { hex: '#272C1F', rgb: '39, 44, 31', cmyk: '11, 0, 30, 83', textColor: '#F6F3EE' },
  { hex: '#ADB49E', rgb: '173, 180, 158', cmyk: '4, 0, 12, 29', textColor: '#1B1816' },
  { hex: '#EBE3DB', rgb: '235, 227, 219', cmyk: '0, 3, 7, 8', textColor: '#1B1816' },
  { hex: '#F6F3EE', rgb: '246, 243, 238', cmyk: '0, 1, 3, 4', textColor: '#1B1816' },
  { hex: '#FFFFFF', rgb: '255, 255, 255', cmyk: '0, 0, 0, 0', textColor: '#1B1816' },
];

const blocks: SheetBlock[] = [
  img('Group 1000001787', 'Can Pruna accommodation visual identity'),
  { type: 'text', title: 'Project', paragraphs: projectParagraphs },
  img('Group 1000001798', 'Can Pruna brand emblem application'),
  {
    type: 'text',
    title: 'Branding',
    paragraphs: [
      'The logo features three stylized cypress trees set in subtle perspective.',
      'In Mediterranean lore, one cypress offers a drink, two promise food and drink, and three signal full accommodation: drink, a meal, and a bed for the night.',
      'That symbolism became the heart of the brand: a gracious welcome under the Montseny sky.',
    ],
  },
  {
    type: 'palette',
    swatches,
    label: 'Can Pruna color palette',
    note: [
      'The color system balances deep natural anchors with soft mineral neutrals.',
      'Charcoal and forest green bring structure and depth, olive adds a vegetal note, and the two pale tones keep the identity breathable and luminous.',
    ],
  },
  img('Business_Card_Mockup_1', 'Can Pruna business card mockup'),
  img('Posters_Mockup', 'Can Pruna posters mockup'),
  img('Group 1000001785', 'Can Pruna brand composition'),
  img('DSCF3669-1', 'Can Pruna accommodation exterior detail'),
  img('Group 1000001794', 'Can Pruna brand application layout'),
  {
    type: 'text',
    title: 'Applications',
    paragraphs: [
      'The system was designed to move easily between print, signage, digital touchpoints, and the slower rhythm of the place itself.',
      'Mockups keep the identity tangible: from arrival signage and posters to business cards and guest-facing visual material.',
    ],
  },
  img('MDU069_Billboard_Mockup', 'Can Pruna billboard mockup'),
  img('DSCF9614-1', 'Can Pruna accommodation textile detail'),
  img('Group 1000001795', 'Can Pruna vertical brand application'),
  img('DSCF3622-1', 'Can Pruna accommodation terrace detail'),
  img('Free Tall Stand with Construction Mockup', 'Can Pruna tall stand mockup'),
  img('DSCF9439-1', 'Can Pruna accommodation natural detail'),
  img('Group 1000001797', 'Can Pruna printed brand material'),
  img('DSCF3659-1', 'Can Pruna accommodation landscape detail'),
  img('Group 1000001801', 'Can Pruna tall branded layout'),
  img('DSCF3662-1', 'Can Pruna accommodation garden detail'),
  img('DSCF9586-1', 'Can Pruna accommodation bedroom detail'),
  img('Signbaord_Mockup', 'Can Pruna signboard mockup'),
  img('Group 1000001804', 'Can Pruna brand touchpoint'),
  img('Group 1000001789', 'Can Pruna logo detail'),
  {
    type: 'text',
    paragraphs: ['A grounded identity system for hospitality, built to feel welcoming before the guest even arrives.'],
  },
];
---

<ProjectSheet
  year={year}
  others={others}
  title="Can Pruna"
  sector="Hospitality & tourism"
  country="Catalonia, Spain"
  format="Visual identity"
  tags={['Branding', 'Photography', 'Hospitality']}
  responsibilities="Visual identity - Web design - Photography - Art direction"
  projectParagraphs={[projectParagraphs[0]]}
  blocks={blocks}
  showContext={false}
/>
