---
import ResponsiveImage from '../media/ResponsiveImage.astro';
import canprunaHero from '/src/assets/media-src/projects/branding/canpruna-accomodation/Group 1000001787.png';
import type { ImageMetadata } from 'astro';

const images = import.meta.glob<ImageMetadata>(
  '/src/assets/media-src/projects/branding/canpruna-accomodation/*.png',
  { eager: true, import: 'default' },
);
const pic = (base: string): ImageMetadata =>
  images[`/src/assets/media-src/projects/branding/canpruna-accomodation/${base}.png`];

const PUBLIC_DIR = '/assets/media/projects/branding/canpruna-accomodation';
const avifSrcset = (base: string) =>
  `${PUBLIC_DIR}/${base}-640.avif 640w, ${PUBLIC_DIR}/${base}-960.avif 960w, ${PUBLIC_DIR}/${base}-1280.avif 1280w`;

type Swatch = { hex: string; name: string; textColor: string };
type Item =
  | { type: 'card'; title?: string; intro?: boolean; paragraphs: string[] }
  | { type: 'palette'; swatches: Swatch[] }
  | { type: 'image'; base: string; alt: string; generated?: boolean };

const items: Item[] = [
  { type: 'image', generated: true, base: 'Group 1000001798', alt: 'Can Pruna brand emblem application' },
  { type: 'card', title: 'Branding', paragraphs: [
    'The logo features three stylized cypress trees set in subtle perspective.',
    'In Mediterranean lore, one cypress offers a drink, two promise food and drink, and three signal full accommodation: drink, a meal, and a bed for the night.',
    'That symbolism became the heart of the brand: a gracious welcome under the Montseny sky.',
  ] },
  { type: 'palette', swatches: [
    { hex: '#1B1816', name: 'Charcoal', textColor: '#F6F3EE' },
    { hex: '#272C1F', name: 'Forest', textColor: '#F6F3EE' },
    { hex: '#ADB49E', name: 'Olive', textColor: '#1B1816' },
    { hex: '#EBE3DB', name: 'Stone', textColor: '#1B1816' },
    { hex: '#F6F3EE', name: 'Warm white', textColor: '#1B1816' },
    { hex: '#FFFFFF', name: 'White', textColor: '#1B1816' },
  ] },
  { type: 'card', title: 'Palette', paragraphs: [
    'The color system balances deep natural anchors with soft mineral neutrals.',
    'Charcoal and forest green bring structure and depth, olive adds a vegetal note, and the two pale tones keep the identity breathable and luminous.',
  ] },
  { type: 'image', generated: true, base: 'Business_Card_Mockup_1', alt: 'Can Pruna business card mockup' },
  { type: 'image', generated: true, base: 'Posters_Mockup', alt: 'Can Pruna posters mockup' },
  { type: 'image', generated: true, base: 'Group 1000001785', alt: 'Can Pruna brand composition' },
  { type: 'image', base: 'DSCF3669-1', alt: 'Can Pruna accommodation exterior detail' },
  { type: 'image', generated: true, base: 'Group 1000001794', alt: 'Can Pruna brand application layout' },
  { type: 'card', title: 'Applications', paragraphs: [
    'The system was designed to move easily between print, signage, digital touchpoints, and the slower rhythm of the place itself.',
    'Mockups keep the identity tangible: from arrival signage and posters to business cards and guest-facing visual material.',
  ] },
  { type: 'image', generated: true, base: 'MDU069_Billboard_Mockup', alt: 'Can Pruna billboard mockup' },
  { type: 'image', base: 'DSCF9614-1', alt: 'Can Pruna accommodation textile detail' },
  { type: 'image', generated: true, base: 'Group 1000001795', alt: 'Can Pruna vertical brand application' },
  { type: 'image', base: 'DSCF3622-1', alt: 'Can Pruna accommodation terrace detail' },
  { type: 'image', generated: true, base: 'Free Tall Stand with Construction Mockup', alt: 'Can Pruna tall stand mockup' },
  { type: 'image', base: 'DSCF9439-1', alt: 'Can Pruna accommodation natural detail' },
  { type: 'image', generated: true, base: 'Group 1000001797', alt: 'Can Pruna printed brand material' },
  { type: 'image', base: 'DSCF3659-1', alt: 'Can Pruna accommodation landscape detail' },
  { type: 'image', generated: true, base: 'Group 1000001801', alt: 'Can Pruna tall branded layout' },
  { type: 'image', base: 'DSCF3662-1', alt: 'Can Pruna accommodation garden detail' },
  { type: 'image', base: 'DSCF9586-1', alt: 'Can Pruna accommodation bedroom detail' },
  { type: 'image', generated: true, base: 'Signbaord_Mockup', alt: 'Can Pruna signboard mockup' },
  { type: 'image', generated: true, base: 'Group 1000001804', alt: 'Can Pruna brand touchpoint' },
  { type: 'image', generated: true, base: 'Group 1000001789', alt: 'Can Pruna logo detail' },
  { type: 'card', paragraphs: ['A grounded identity system for hospitality, built to feel welcoming before the guest even arrives.'] },
];

const projectParagraphs = [
  'Can Pruna is a rural accommodation in Catalonia, surrounded by dry stone, olive tones, and the quiet rhythm of the Montseny landscape.',
  'The identity distills that atmosphere into a calm visual story anchored by earth, olive, stone, and warm white tones drawn from the site.',
  'Hand-sketched elements bring an artisanal touch, while generous spacing gives the photography and line art room to breathe.',
  'I also photographed and retouched the site imagery so the visual world feels quiet, hospitable, and directly connected to the Masia.',
];

const masonrySizes = '(min-width: 970px) 28vw, (min-width: 628px) 44vw, 92vw';
const delay = (i: number) => `${Math.min(i * 32, 420)}ms`;
---

<section class="canpruna-project relative flex flex-col">
  <div class="canpruna-layout">
    <aside class="canpruna-sticky">
      <header class="canpruna-headline">
        <p class="project-title-reveal canpruna-title font-display m-0 uppercase" aria-hidden="true">
          <span class="project-title-reveal__inner">Can Pruna</span>
        </p>
        <ul class="canpruna-tags" aria-label="Project tags">
          <li>Branding</li>
          <li>Photography</li>
          <li>Hospitality</li>
        </ul>
        <div class="canpruna-meta" aria-label="Project details">
          <p><i>Client: </i>Can Pruna</p>
          <p><i>Sector: </i>Hospitality &amp; tourism</p>
          <p><i>Country: </i>Catalonia, Spain</p>
          <p><i>Format: </i>Visual identity</p>
        </div>
      </header>
    </aside>

    <div class="canpruna-main-flow">
      <figure class="canpruna-hero">
        <ResponsiveImage
          src={canprunaHero}
          alt="Can Pruna accommodation visual identity"
          sizes="(min-width: 1280px) 64vw, (min-width: 970px) calc(100vw - 24rem), calc(100vw - 2rem)"
          loading="eager"
          fetchpriority="high"
          class="canpruna-hero-picture"
          imgClass="canpruna-hero-img"
        />
      </figure>

      <section class="canpruna-study-card masonry-reveal" aria-label="Can Pruna case study">
        <article class="canpruna-block">
          <h2 class="canpruna-block__title">Project</h2>
          <hr class="canpruna-block__rule" />
          <div class="canpruna-block__body">
            {projectParagraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </article>

        <article class="canpruna-block">
          <h2 class="canpruna-block__title">Responsibilities</h2>
          <hr class="canpruna-block__rule" />
          <div class="canpruna-block__body">
            <p>Visual identity - Web design - Photography - Art direction</p>
          </div>
        </article>
      </section>

      <section
        class="canpruna-masonry"
        data-masonry
        data-cols-desktop="3"
        data-cols-tablet="2"
        data-cols-mobile="1"
        aria-label="Can Pruna visual identity gallery"
      >
        {
          items.map((item, i) => (
            <article class="masonry-item masonry-reveal" style={`--reveal-delay: ${delay(i)}`}>
              {item.type === 'image' && item.generated && (
                <ResponsiveImage src={pic(item.base)} alt={item.alt} sizes={masonrySizes} loading="lazy" fetchpriority="low" imgClass="canpruna-masonry-media" />
              )}

              {item.type === 'image' && !item.generated && (
                <picture>
                  <source type="image/avif" srcset={avifSrcset(item.base)} sizes={masonrySizes} />
                  <img class="canpruna-masonry-media" src={`${PUBLIC_DIR}/${item.base}-960.avif`} alt={item.alt} loading="lazy" decoding="async" />
                </picture>
              )}

              {item.type === 'palette' && (
                <div class="palette-card" role="group" aria-label="Can Pruna color palette">
                  <div class="palette-grid">
                    {item.swatches.map((sw) => (
                      <div class="palette-swatch" style={`background-color:${sw.hex};color:${sw.textColor}`}>
                        <div class="palette-label">
                          <p class="palette-line">{sw.hex.replace('#', '')}</p>
                          <p class="palette-name">{sw.name}</p>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              {item.type === 'card' && (
                <div class="canpruna-note-card">
                  {item.title && item.title.trim() && <h3>{item.title}</h3>}
                  {item.title && item.title.trim() && <hr class="canpruna-note-card__rule" />}
                  <div class="canpruna-note-card__body">
                    {item.paragraphs.map((p) => (
                      <p class={item.intro ? 'canpruna-intro' : ''}>{p}</p>
                    ))}
                  </div>
                </div>
              )}
            </article>
          ))
        }
      </section>
    </div>
  </div>
</section>

<script>
  import '../../scripts/masonry-columns.ts';
  import '../../scripts/masonry-reveal.ts';
</script>

<style>
  :global(.project-detail-page) > .canpruna-project {
    width: 100%;
    max-width: min(100%, 1680px);
    margin-inline: auto;
    padding-inline: 20px;
    padding-block: clamp(0.5rem, 2vw, 1.5rem);
  }

  .canpruna-layout {
    display: grid;
    grid-template-columns: minmax(18rem, 0.72fr) minmax(0, 1.58fr);
    gap: clamp(2rem, 4vw, 5rem);
    align-items: start;
  }

  .canpruna-sticky {
    position: sticky;
    top: clamp(1rem, 3vw, 2.5rem);
    min-width: 0;
  }

  .canpruna-headline {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .canpruna-title {
    max-width: 8ch;
    color: var(--text-primary);
    font-size: clamp(2.8rem, 6vw, 5.2rem);
    line-height: 0.92;
  }

  .canpruna-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .canpruna-tags li {
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 0.42rem 0.7rem;
    color: var(--text-primary);
    font-family: var(--font-family-display);
    font-size: 0.78rem;
    line-height: 1;
    text-transform: uppercase;
  }

  .canpruna-meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    max-width: 31ch;
    color: var(--text-secondary);
    font-family: var(--font-family-body);
    font-size: 0.95rem;
    font-weight: 300;
    line-height: 1.45;
  }

  .canpruna-meta p {
    margin: 0;
  }

  .canpruna-meta i {
    color: var(--text-primary);
    font-style: italic;
    text-transform: uppercase;
  }

  .canpruna-main-flow {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: clamp(2.4rem, 6vw, 4.5rem);
  }

  .canpruna-hero {
    overflow: hidden;
    width: 100%;
    margin: 0;
    border-radius: var(--project-card-radius);
    background: #fff;
    box-shadow:
      0 18px 42px rgba(35, 35, 35, 0.12),
      0 4px 12px rgba(35, 35, 35, 0.07);
  }

  .canpruna-hero :global(.canpruna-hero-picture) {
    display: block;
  }

  .canpruna-hero :global(.canpruna-hero-img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0;
    background: #fff;
  }

  .canpruna-study-card {
    display: flex;
    width: 100%;
    flex-direction: column;
    gap: clamp(2.4rem, 6vw, 4.5rem);
    padding: clamp(1.4rem, 2.8vw, 2.4rem);
    margin-block: clamp(0.4rem, 1.6vw, 1.4rem);
    background: var(--palette-white);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
  }

  .canpruna-block__title {
    margin: 0;
    color: var(--text-primary);
    font-family: var(--font-family-display);
    font-size: clamp(1.1rem, 1.9vw, 1.7rem);
    font-weight: 400;
    letter-spacing: 0.04em;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .canpruna-block__rule {
    width: 100%;
    height: 0;
    margin: clamp(0.8rem, 1.6vw, 1.2rem) 0 clamp(1.2rem, 2.6vw, 2rem);
    border: 0;
    border-top: 1px solid color-mix(in srgb, var(--text-primary) 26%, transparent);
  }

  .canpruna-block__body {
    display: flex;
    width: min(100%, 62ch);
    margin-left: auto;
    flex-direction: column;
    gap: 1rem;
    color: var(--text-secondary);
    font-family: var(--font-family-body);
    font-weight: 300;
  }

  .canpruna-block__body p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.65;
  }

  .canpruna-masonry {
    display: flex;
    gap: clamp(0.75rem, 1.8vw, 1rem);
    align-items: flex-start;
    border-radius: var(--project-card-radius);
  }

  .canpruna-masonry :global(.masonry-col) {
    flex: 1 1 0;
    min-width: 0;
  }

  .canpruna-masonry :global(.canpruna-masonry-media),
  .canpruna-masonry .palette-card,
  .canpruna-note-card {
    width: 100%;
    border-radius: var(--project-card-radius);
  }

  .canpruna-masonry :global(.canpruna-masonry-media) {
    display: block;
    height: auto;
    background: #fff;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
  }

  .canpruna-note-card {
    padding: clamp(1.4rem, 2.8vw, 2.4rem);
    background: var(--palette-white);
    color: var(--text-secondary);
    font-family: var(--font-family-body);
    font-weight: 300;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
  }

  .canpruna-note-card h3 {
    margin: 0;
    color: var(--text-primary);
    font-family: var(--font-family-display);
    font-size: clamp(1.1rem, 1.9vw, 1.7rem);
    font-weight: 400;
    letter-spacing: 0.04em;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .canpruna-note-card__rule {
    width: 100%;
    height: 0;
    margin: clamp(0.8rem, 1.6vw, 1.2rem) 0 clamp(1.2rem, 2.6vw, 2rem);
    border: 0;
    border-top: 1px solid color-mix(in srgb, var(--text-primary) 26%, transparent);
  }

  .canpruna-note-card__body {
    display: flex;
    width: min(100%, 62ch);
    margin-left: auto;
    flex-direction: column;
    gap: 1rem;
  }

  .canpruna-note-card p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.65;
  }

  .canpruna-intro {
    font-size: clamp(1.25rem, 1.9vw, 1.6rem);
    line-height: 1.15;
    text-transform: uppercase;
    transition: letter-spacing 220ms ease;
  }

  .masonry-item:hover .canpruna-intro {
    letter-spacing: 0.08em;
  }

  .palette-card {
    overflow: hidden;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
  }

  .palette-grid {
    display: flex;
    width: 100%;
    flex-direction: column;
  }

  .palette-swatch {
    position: relative;
    display: flex;
    min-width: 0;
    min-height: 86px;
    flex: 1 1 0;
    align-items: flex-end;
    transition:
      flex-grow 260ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 260ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 260ms ease;
  }

  .palette-label {
    padding: 1rem;
    line-height: 1.2;
    transition:
      padding 260ms cubic-bezier(0.22, 1, 0.36, 1),
      letter-spacing 260ms ease,
      transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .palette-line {
    margin: 0;
    font-size: 1rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .palette-name {
    margin: 0.2rem 0 0;
    font-size: 0.78rem;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .palette-swatch:hover {
    z-index: 1;
    flex-grow: 1.18;
    filter: saturate(1.08) brightness(1.02);
    transform: scale(1.035);
  }

  .palette-swatch:hover .palette-label {
    padding: 1.2rem;
    letter-spacing: 0.06em;
    transform: translateY(-2px);
  }

  @media (max-width: 960px) {
    .canpruna-layout {
      grid-template-columns: 1fr;
      gap: clamp(1.5rem, 5vw, 3rem);
    }

    .canpruna-sticky {
      position: static;
    }

    .canpruna-title {
      max-width: none;
      font-size: clamp(2.7rem, 15vw, 4.8rem);
    }

    .canpruna-meta,
    .canpruna-block__body {
      width: 100%;
      max-width: none;
      margin-left: 0;
    }
  }

  @media (max-width: 628px) {
    .canpruna-masonry {
      flex-direction: column;
      gap: 0.75rem;
    }

    .palette-swatch {
      min-height: 80px;
    }

    .canpruna-study-card {
      gap: 2rem;
    }
  }
</style>
