---
interface Props {
  eyebrow?: string;
  title: string;
  updated?: string;
}

const { eyebrow = 'Legal', title, updated } = Astro.props;
---

<main class="page legal">
  <header class="legal__head">
    <p class="label">{eyebrow}</p>
    <h1 class="legal__title display" set:html={title} />
    {updated && <p class="legal__updated">Last updated: {updated}</p>}
  </header>

  <div class="legal__content">
    <slot />
  </div>
</main>

<style is:global>
  .legal {
    max-width: 1100px;
  }
  .legal__head {
    --space: clamp(60px, 11vh, 130px);
    padding: var(--space) 0;
  }
  .legal__head .label {
    margin: 0 0 20px;
    color: #85847e;
  }
  .legal__title {
    margin: 0;
    font-size: clamp(40px, 6.4vw, 96px);
    line-height: 0.95;
    text-transform: lowercase;
  }
  .legal__updated {
    margin: 22px 0 0;
    font-size: 14px;
    font-style: italic;
    color: var(--ink-soft);
  }

  .legal__content {
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 72%, transparent);
    margin-bottom: clamp(60px, 12vh, 130px);
  }
  .legal-section {
    display: grid;
    grid-template-columns: minmax(11rem, 0.36fr) minmax(0, 1fr);
    gap: clamp(1rem, 4vw, 4rem);
    padding: clamp(24px, 3.2vw, 40px) 0;
    border-top: 1px solid color-mix(in srgb, var(--ink) 72%, transparent);
  }
  .legal-section h2 {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.08em;
    line-height: 1.5;
    text-transform: uppercase;
  }
  .legal-copy {
    display: grid;
    gap: 0.9rem;
    max-width: 44rem;
  }
  .legal-copy p,
  .legal-copy li {
    margin: 0;
    font-size: clamp(15px, 1.15vw, 17px);
    line-height: 1.55;
  }
  .legal-copy ul {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding-left: 1.1rem;
    list-style: disc outside;
  }
  .legal-copy li {
    display: list-item;
  }
  .legal-copy a {
    color: #25417f;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .legal-copy strong {
    font-weight: 500;
  }
  .legal-note {
    color: var(--ink-soft);
  }

  @media (max-width: 760px) {
    .legal-section {
      grid-template-columns: 1fr;
    }
  }
</style>
