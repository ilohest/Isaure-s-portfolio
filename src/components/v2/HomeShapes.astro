---
import { getDict, localePath } from '../../i18n';
import type { Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = getDict(lang);

type Color = 'red' | 'blue' | 'green' | 'yellow' | 'pink';
type Radii = [number, number, number, number]; // tl, tr, br, bl (en fraction du plus petit côté)
interface Tile {
  x: number;
  y: number;
  w: number;
  h: number;
  color: Color;
  r: Radii;
  link?: 'work' | 'services' | 'contact' | 'process' | 'about' | 'ai';
}

const FULL = 0.5;
const SOFT = 0.28;
const SQ = 0.04;

// Paysage : grille 12 × 7 (1 unité = 100). Les cases sont un pavage complet.
const landscape: Tile[] = [
  { x: 0, y: 0, w: 3, h: 4, color: 'red', r: [SOFT, SOFT, SOFT, FULL], link: 'work' },
  { x: 3, y: 0, w: 3, h: 2, color: 'blue', r: [SOFT, SQ, FULL, SQ] },
  { x: 6, y: 0, w: 2, h: 2, color: 'yellow', r: [FULL, FULL, FULL, FULL], link: 'ai' },
  { x: 8, y: 0, w: 4, h: 2, color: 'green', r: [SQ, SOFT, SOFT, FULL], link: 'services' },
  { x: 3, y: 2, w: 2, h: 2, color: 'pink', r: [FULL, FULL, FULL, FULL] },
  { x: 5, y: 2, w: 3, h: 2, color: 'blue', r: [FULL, SQ, SOFT, FULL], link: 'process' },
  { x: 8, y: 2, w: 2, h: 2, color: 'yellow', r: [SQ, FULL, SQ, FULL] },
  { x: 10, y: 2, w: 2, h: 2, color: 'pink', r: [FULL, SOFT, FULL, SQ] },
  { x: 0, y: 4, w: 4, h: 3, color: 'green', r: [FULL, SOFT, SQ, SOFT], link: 'about' },
  { x: 4, y: 4, w: 2, h: 3, color: 'blue', r: [SOFT, FULL, FULL, SQ] },
  { x: 6, y: 4, w: 3, h: 3, color: 'red', r: [SOFT, FULL, SOFT, FULL], link: 'contact' },
  { x: 9, y: 4, w: 3, h: 3, color: 'yellow', r: [FULL, SQ, SOFT, SOFT] },
];

// Portrait : grille 6 × 9.
const portrait: Tile[] = [
  { x: 0, y: 0, w: 3, h: 4, color: 'red', r: [SOFT, SOFT, SOFT, FULL], link: 'work' },
  { x: 3, y: 0, w: 3, h: 2, color: 'blue', r: [SOFT, SQ, FULL, SQ], link: 'process' },
  { x: 3, y: 2, w: 2, h: 2, color: 'yellow', r: [FULL, FULL, FULL, FULL], link: 'ai' },
  { x: 5, y: 2, w: 1, h: 2, color: 'pink', r: [FULL, FULL, FULL, FULL] },
  { x: 0, y: 4, w: 2, h: 3, color: 'green', r: [FULL, SOFT, SQ, SOFT], link: 'about' },
  { x: 2, y: 4, w: 4, h: 2, color: 'blue', r: [SOFT, FULL, SOFT, FULL], link: 'services' },
  { x: 0, y: 7, w: 2, h: 2, color: 'yellow', r: [FULL, FULL, FULL, FULL] },
  { x: 2, y: 6, w: 2, h: 2, color: 'pink', r: [FULL, SQ, FULL, SOFT] },
  { x: 4, y: 6, w: 2, h: 3, color: 'red', r: [SOFT, SOFT, FULL, SOFT], link: 'contact' },
  { x: 2, y: 8, w: 2, h: 1, color: 'green', r: [FULL, FULL, FULL, FULL] },
];

const U = 100;
const GAP = 9;

const roundedPath = (t: Tile) => {
  const x = t.x * U + GAP;
  const y = t.y * U + GAP;
  const w = t.w * U - GAP * 2;
  const h = t.h * U - GAP * 2;
  const m = Math.min(w, h);
  const [tl, tr, br, bl] = t.r.map((f) => Math.min(f * m, m / 2));
  return [
    `M${x + tl},${y}`,
    `H${x + w - tr}`,
    `A${tr},${tr} 0 0 1 ${x + w},${y + tr}`,
    `V${y + h - br}`,
    `A${br},${br} 0 0 1 ${x + w - br},${y + h}`,
    `H${x + bl}`,
    `A${bl},${bl} 0 0 1 ${x},${y + h - bl}`,
    `V${y + tl}`,
    `A${tl},${tl} 0 0 1 ${x + tl},${y}`,
    'Z',
  ].join(' ');
};

const hrefFor = (key: NonNullable<Tile['link']>) =>
  key === 'ai' ? 'https://ai.isaure-lohest.com/' : localePath(`/${key}`, lang);

const variants = [
  { id: 'landscape', tiles: landscape, vb: `0 0 ${12 * U} ${7 * U}` },
  { id: 'portrait', tiles: portrait, vb: `0 0 ${6 * U} ${9 * U}` },
];
---

<div class="poster">
  {
    variants.map((v) => (
      <svg
        class={`poster__svg poster__svg--${v.id}`}
        viewBox={v.vb}
        xmlns="http://www.w3.org/2000/svg"
        role="group"
        aria-label={d.home.tagline}
      >
        <defs>
          <filter id={`glow-${v.id}`} x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="7" />
          </filter>
          <filter id={`soft-${v.id}`} x="-5%" y="-5%" width="110%" height="110%">
            <feGaussianBlur stdDeviation="1.7" />
          </filter>
        </defs>
        {v.tiles.map((t, i) => {
          const path = roundedPath(t);
          const inner = (
            <>
              <path class="tile__fill" d={path} />
              <path class="tile__glow" d={path} pathLength="1" filter={`url(#glow-${v.id})`} />
              <path class="tile__line" d={path} pathLength="1" filter={`url(#soft-${v.id})`} />
              {t.link && (
                <text
                  class="tile__label"
                  x={t.x * U + GAP + 30}
                  y={t.y * U + GAP + 46}
                >
                  {d.home.shapes[t.link]}
                </text>
              )}
            </>
          );
          return t.link ? (
            <a
              href={hrefFor(t.link)}
              class={`tile tile--${t.color} tile--link`}
              style={`--i:${i}`}
              target={t.link === 'ai' ? '_blank' : undefined}
              rel={t.link === 'ai' ? 'noopener noreferrer' : undefined}
              aria-label={d.home.shapes[t.link]}
            >
              {inner}
            </a>
          ) : (
            <g class={`tile tile--${t.color}`} style={`--i:${i}`} aria-hidden="true">
              {inner}
            </g>
          );
        })}
      </svg>
    ))
  }
</div>

<style is:global>
  .poster {
    width: 100%;
    display: grid;
    place-items: center;
  }
  .poster__svg {
    display: block;
    overflow: visible;
    height: auto;
  }
  .poster__svg--landscape {
    width: min(100%, calc((100svh - 190px) * 12 / 7));
  }
  .poster__svg--portrait {
    display: none;
    width: min(100%, calc((100svh - 200px) * 6 / 9));
  }
  @media (max-width: 760px), (max-aspect-ratio: 9/10) {
    .poster__svg--landscape {
      display: none;
    }
    .poster__svg--portrait {
      display: block;
    }
  }

  .tile {
    --c: var(--red);
    color: var(--c);
    transform-box: fill-box;
    transform-origin: center;
    animation: tile-float 11s ease-in-out infinite alternate;
    animation-delay: calc(var(--i) * -1.3s);
    cursor: default;
  }
  .tile--link {
    cursor: pointer;
  }
  .tile--red {
    --c: var(--red);
  }
  .tile--blue {
    --c: var(--blue);
  }
  .tile--green {
    --c: var(--green);
  }
  .tile--yellow {
    --c: var(--yellow);
  }
  .tile--pink {
    --c: var(--pink);
  }

  .tile path {
    fill: none;
    stroke: var(--c);
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .tile__fill {
    fill: var(--c) !important;
    stroke: none !important;
    opacity: 0;
    transition: opacity 0.6s var(--ease);
  }
  .tile__glow {
    stroke-width: 15;
    opacity: 0.5;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: tile-draw 2.2s var(--ease) forwards;
    animation-delay: calc(var(--i) * 110ms + 150ms);
  }
  .tile__line {
    stroke-width: 7;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: tile-draw 2.2s var(--ease) forwards;
    animation-delay: calc(var(--i) * 110ms + 150ms);
  }
  .tile__label {
    fill: var(--ink);
    font-family: var(--font-sans);
    font-size: 17px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0;
    animation: tile-fade 1.2s var(--ease) forwards;
    animation-delay: calc(var(--i) * 110ms + 1400ms);
    transition: letter-spacing 0.5s var(--ease);
  }
  .poster__svg--portrait .tile__label {
    font-size: 21px;
  }

  @keyframes tile-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes tile-fade {
    to {
      opacity: 1;
    }
  }
  @keyframes tile-float {
    from {
      transform: translate(0, 0) scale(1);
    }
    to {
      transform: translate(2px, -3px) scale(1.006);
    }
  }

  /* survol : la forme se teinte, les autres s'effacent */
  .poster__svg:has(.tile--link:hover) .tile:not(:hover),
  .poster__svg:has(.tile--link:focus-visible) .tile:not(:focus-visible) {
    opacity: 0.38;
    transition: opacity 0.5s var(--ease);
  }
  .tile {
    transition: opacity 0.5s var(--ease);
  }
  .tile--link:hover .tile__fill,
  .tile--link:focus-visible .tile__fill {
    opacity: 0.16;
  }
  .tile--link:hover .tile__label {
    letter-spacing: 0.2em;
  }
  .tile--link:hover .tile__line {
    stroke-width: 9;
  }
  .tile__line {
    transition: stroke-width 0.5s var(--ease);
  }

  @media (prefers-reduced-motion: reduce) {
    .tile,
    .tile__glow,
    .tile__line,
    .tile__label {
      animation: none;
    }
    .tile__glow,
    .tile__line {
      stroke-dashoffset: 0;
    }
    .tile__label {
      opacity: 1;
    }
  }
</style>
