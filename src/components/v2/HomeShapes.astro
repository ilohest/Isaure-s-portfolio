---
import { getDict, localePath } from '../../i18n';
import type { Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = getDict(lang);

const hrefs = {
  work: localePath('/work', lang),
  services: localePath('/services', lang),
  contact: localePath('/contact', lang),
  about: localePath('/about', lang),
  process: localePath('/process', lang),
  ai: 'https://ai.isaure-lohest.com/',
};
---

<div
  class="poster"
  data-poster
  data-labels={JSON.stringify(d.home.shapes)}
  data-hrefs={JSON.stringify(hrefs)}
  data-title={d.home.tagline}
>
</div>
<noscript>
  <ul class="poster__fallback">
    {Object.entries(hrefs).map(([k, href]) => <li><a href={href}>{d.home.shapes[k as keyof typeof d.home.shapes]}</a></li>)}
  </ul>
</noscript>

<script>
  import '../../scripts/poster';
</script>

<style is:global>
  .poster {
    position: relative;
    width: 100%;
    height: calc(100svh - var(--nav-h));
  }
  .poster__svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .poster__fallback {
    display: flex;
    gap: 18px;
    list-style: none;
    padding: 24px var(--gutter);
  }

  /* grain analogique : bruit monochrome multiplié sur les couleurs */
  .poster::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='240' height='240'><filter id='g' x='0' y='0' width='100%' height='100%'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' seed='7' stitchTiles='stitch'/><feColorMatrix values='.33 .33 .33 0 0  .33 .33 .33 0 0  .33 .33 .33 0 0  0 0 0 0 1'/><feComponentTransfer><feFuncR type='linear' slope='1' intercept='.46'/><feFuncG type='linear' slope='1' intercept='.46'/><feFuncB type='linear' slope='1' intercept='.46'/></feComponentTransfer></filter><rect width='240' height='240' filter='url(%23g)'/></svg>");
    background-size: 240px 240px;
    mix-blend-mode: multiply;
    opacity: 0.7;
  }

  .overlay {
    pointer-events: none;
  }
  .overlay path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .poster__svg.is-static *,
  .poster__svg.is-static .r-label {
    animation-duration: 0.001s !important;
    animation-delay: 0s !important;
  }

  .region {
    cursor: default;
    transition: opacity 0.6s var(--ease);
  }
  .region--link {
    cursor: pointer;
  }
  .region path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .r-fill {
    fill-opacity: 0;
    pointer-events: all;
    transition: fill-opacity 0.7s var(--ease);
  }
  .region--link:hover .r-fill,
  .region--link:focus-visible .r-fill {
    fill-opacity: 0.13;
  }

  /* diffusion vers l'intérieur seulement (clip), ligne extérieure nette et fine */
  .r-wide {
    stroke-width: 24;
    opacity: 0;
    animation: glow-in 2.2s var(--ease) forwards, breathe 9s ease-in-out infinite alternate;
    animation-delay: calc(var(--delay) + 500ms), calc(var(--delay) + 3s);
  }
  .r-mid {
    stroke-width: 9;
    opacity: 0;
    animation: glow-in 2s var(--ease) forwards;
    animation-delay: calc(var(--delay) + 350ms);
  }
  .r-line {
    stroke-width: 2.2;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 2.4s var(--ease) forwards;
    animation-delay: var(--delay);
  }
  .r-label {
    fill: var(--ink);
    font-family: var(--font-sans);
    font-size: var(--label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0;
    animation: fade-in 1.4s var(--ease) forwards;
    animation-delay: calc(var(--delay) + 1500ms);
    transition: letter-spacing 0.6s var(--ease);
  }

  .poster__svg:has(.region--link:hover) .region:not(:hover),
  .poster__svg:has(.region--link:focus-visible) .region:not(:focus-visible) {
    opacity: 0.4;
  }
  .region--link:hover .r-label {
    letter-spacing: 0.2em;
  }
  .region--link:hover .r-mid {
    stroke-width: 15;
    transition: stroke-width 0.6s var(--ease);
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes glow-in {
    to {
      opacity: 0.6;
    }
  }
  @keyframes breathe {
    from {
      stroke-width: 24;
    }
    to {
      stroke-width: 30;
    }
  }
  @keyframes fade-in {
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .r-wide,
    .r-mid,
    .r-line,
    .r-label {
      animation: none;
    }
    .r-wide,
    .r-mid {
      opacity: 0.7;
    }
    .r-line {
      stroke-dashoffset: 0;
    }
    .r-label {
      opacity: 1;
    }
  }
</style>
