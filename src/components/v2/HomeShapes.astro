---
import { getDict, localePath } from '../../i18n';
import type { Lang } from '../../i18n';
import { generatePoster } from '../../lib/poster';
import type { LinkKey } from '../../lib/poster';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = getDict(lang);

const LINKS: LinkKey[] = ['work', 'services', 'contact', 'about', 'process', 'ai'];

const variants = [
  { id: 'landscape', cols: 14, rows: 8, labelSize: 11 },
  { id: 'square', cols: 9, rows: 8, labelSize: 13 },
  { id: 'portrait', cols: 6, rows: 12, labelSize: 17 },
].map((v) => ({ ...v, poster: generatePoster({ cols: v.cols, rows: v.rows, labelSize: v.labelSize, links: LINKS }) }));

const hrefFor = (key: LinkKey) => (key === 'ai' ? 'https://ai.isaure-lohest.com/' : localePath(`/${key}`, lang));
---

<div class="poster">
  {
    variants.map(({ id, poster, labelSize }) => (
      <svg
        class={`poster__svg poster__svg--${id}`}
        viewBox={`${-poster.pad} ${-poster.pad} ${poster.width + poster.pad * 2} ${poster.height + poster.pad * 2}`}
        preserveAspectRatio="xMidYMid meet"
        xmlns="http://www.w3.org/2000/svg"
        role="group"
        aria-label={d.home.tagline}
        style={`--label:${labelSize}px`}
      >
        <defs>
          <filter id={`wide-${id}`} x="-25%" y="-25%" width="150%" height="150%">
            <feGaussianBlur stdDeviation="6" />
          </filter>
          <filter id={`mid-${id}`} x="-25%" y="-25%" width="150%" height="150%">
            <feGaussianBlur stdDeviation="1.5" />
          </filter>
          {poster.regions.map((r) => (
            <>
              <linearGradient id={`g-${id}-${r.id}`} x1={r.grad.x1} y1={r.grad.y1} x2={r.grad.x2} y2={r.grad.y2}>
                <stop offset="0" style={`stop-color:var(--${r.color})`} />
                <stop offset="1" style={`stop-color:var(--${r.color2})`} />
              </linearGradient>
              <clipPath id={`c-${id}-${r.id}`}>
                <path d={r.path} />
              </clipPath>
            </>
          ))}
        </defs>

        {poster.regions.map((r) => {
          const inner = (
            <>
              <path class="r-fill" d={r.path} fill={`url(#g-${id}-${r.id})`} />
              <g clip-path={`url(#c-${id}-${r.id})`} class="r-glow">
                <path class="r-wide" d={r.path} stroke={`url(#g-${id}-${r.id})`} filter={`url(#wide-${id})`} />
                <path class="r-mid" d={r.path} stroke={`url(#g-${id}-${r.id})`} filter={`url(#mid-${id})`} />
              </g>
              <path class="r-line" d={r.path} pathLength="1" stroke={`url(#g-${id}-${r.id})`} />
              {r.label && (
                <text class="r-label" x={r.label.x} y={r.label.y}>
                  {d.home.shapes[r.label.link]}
                </text>
              )}
            </>
          );
          return r.link ? (
            <a
              href={hrefFor(r.link)}
              class="region region--link"
              style={`--delay:${r.delay}ms`}
              target={r.link === 'ai' ? '_blank' : undefined}
              rel={r.link === 'ai' ? 'noopener noreferrer' : undefined}
              aria-label={d.home.shapes[r.link]}
            >
              {inner}
            </a>
          ) : (
            <g class="region" style={`--delay:${r.delay}ms`} aria-hidden="true">
              {inner}
            </g>
          );
        })}
      </svg>
    ))
  }
</div>

<style is:global>
  .poster {
    width: 100%;
    display: grid;
    place-items: center;
  }
  .poster__svg {
    display: none;
    width: 100%;
    height: calc(100svh - var(--nav-h) - 6px);
    overflow: hidden;
  }
  /* un seul poster visible, choisi selon le ratio de l'écran */
  @media (min-aspect-ratio: 27/20) {
    .poster__svg--landscape {
      display: block;
    }
  }
  @media (max-aspect-ratio: 27/20) and (min-aspect-ratio: 17/20) {
    .poster__svg--square {
      display: block;
    }
  }
  @media (max-aspect-ratio: 17/20) {
    .poster__svg--portrait {
      display: block;
    }
  }

  .region {
    cursor: default;
    transition: opacity 0.6s var(--ease);
  }
  .region--link {
    cursor: pointer;
  }
  .region path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .r-fill {
    fill-opacity: 0;
    pointer-events: all;
    transition: fill-opacity 0.7s var(--ease);
  }
  .region--link:hover .r-fill,
  .region--link:focus-visible .r-fill {
    fill-opacity: 0.13;
  }

  /* diffusion vers l'intérieur seulement (clip), ligne extérieure nette et fine */
  .r-wide {
    stroke-width: 30;
    opacity: 0;
    animation: glow-in 2.2s var(--ease) forwards, breathe 9s ease-in-out infinite alternate;
    animation-delay: calc(var(--delay) + 500ms), calc(var(--delay) + 3s);
  }
  .r-mid {
    stroke-width: 9;
    opacity: 0;
    animation: glow-in 2s var(--ease) forwards;
    animation-delay: calc(var(--delay) + 350ms);
  }
  .r-line {
    stroke-width: 2.2;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 2.4s var(--ease) forwards;
    animation-delay: var(--delay);
  }
  .r-label {
    fill: var(--ink);
    font-family: var(--font-sans);
    font-size: var(--label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0;
    animation: fade-in 1.4s var(--ease) forwards;
    animation-delay: calc(var(--delay) + 1500ms);
    transition: letter-spacing 0.6s var(--ease);
  }

  .poster__svg:has(.region--link:hover) .region:not(:hover),
  .poster__svg:has(.region--link:focus-visible) .region:not(:focus-visible) {
    opacity: 0.4;
  }
  .region--link:hover .r-label {
    letter-spacing: 0.2em;
  }
  .region--link:hover .r-mid {
    stroke-width: 15;
    transition: stroke-width 0.6s var(--ease);
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes glow-in {
    to {
      opacity: 0.7;
    }
  }
  @keyframes breathe {
    from {
      stroke-width: 30;
    }
    to {
      stroke-width: 38;
    }
  }
  @keyframes fade-in {
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .r-wide,
    .r-mid,
    .r-line,
    .r-label {
      animation: none;
    }
    .r-wide,
    .r-mid {
      opacity: 0.7;
    }
    .r-line {
      stroke-dashoffset: 0;
    }
    .r-label {
      opacity: 1;
    }
  }
</style>
