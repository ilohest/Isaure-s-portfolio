---
import { getDict, localePath, alternatePath, stripLang } from '../../i18n';
import type { Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = getDict(lang);
const current = stripLang(Astro.url.pathname);
const other = alternatePath(Astro.url.pathname, lang);
const isHome = current === '/';
const links = [
  { path: '/work', label: d.nav.work },
  { path: '/services', label: d.nav.services },
  { path: '/contact', label: d.nav.contact },
];
---

<header class="nav">
  <a href={localePath('/', lang)} class="nav__brand" aria-label={d.nav.home}>
    <svg class="nav__mark" viewBox="0 0 62 40" aria-hidden="true">
      <path d="M31,2 L52,18 L31,18 Z" />
      <path d="M28,7 L10,18 L28,18 Z" class="b" />
      <path d="M3,19 L58,19 L48,32 L13,32 Z" />
      <path d="M4,37 Q9,34.5 14,37 T24,37 T34,37 T44,37 T54,37" class="w" />
    </svg>
    <span>Isaure Lohest</span>
  </a>
  <nav aria-label="Main">
    <ul class="nav__links">
      {
        !isHome &&
        links.map((l) => (
          <li>
            <a
              href={localePath(l.path, lang)}
              aria-current={current === l.path || current.startsWith(`${l.path}/`) ? 'page' : undefined}
            >
              {l.label}
            </a>
          </li>
        ))
      }
      <li>
        <div class="lang" role="group" aria-label="Language / Langue">
          {
            (['fr', 'en'] as const).map((code) =>
              code === lang ? (
                <span class="lang__item is-active" lang={code} aria-current="true">{code}</span>
              ) : (
                <a class="lang__item" href={other} lang={code} hreflang={code} aria-label={d.nav.switchLabel}>{code}</a>
              ),
            )
          }
        </div>
      </li>
    </ul>
  </nav>
</header>
