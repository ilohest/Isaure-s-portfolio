---
import { getDict, localePath } from '../../i18n';
import type { Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = getDict(lang);
const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;');
const bio = esc(d.footer.bio).replace(/\*\*(.+?)\*\*/g, '<b>$1</b>');

const links = [
  { href: localePath('/work', lang), label: d.nav.work },
  { href: localePath('/services', lang), label: d.nav.services },
  { href: localePath('/process', lang), label: d.footer.process },
  { href: localePath('/about', lang), label: d.footer.about },
  { href: localePath('/faq', lang), label: d.footer.faq },
  { href: localePath('/contact', lang), label: d.nav.contact },
];
---

<footer class="foot">
  <div class="foot__main">
    <p class="foot__bio">
      <img class="foot__heart" src="/assets/media/common/heart.png" width="240" height="237" alt="" aria-hidden="true" decoding="async" /><Fragment set:html={bio} />
    </p>

    <nav class="foot__nav" aria-label="Footer">
      <ul class="foot__links">
        {links.map((l, i) => (
          <li>
            <a href={l.href}>
              <span class="foot__n">{String(i + 1).padStart(2, '0')}</span>
              <span class="foot__l">{l.label}</span>
            </a>
            <span class="foot__rule" data-rule aria-hidden="true"></span>
          </li>
        ))}
      </ul>
      <ul class="foot__small">
        <li><a href="https://ai.isaure-lohest.com/" target="_blank" rel="noopener noreferrer">{d.footer.ai} ↗</a></li>
        <li><a href="/legal-information">{d.footer.legal}</a></li>
        <li><a href="/privacy-policy">{d.footer.privacy}</a></li>
      </ul>
    </nav>
  </div>

  <a class="foot__mail" href="mailto:hello@isaure-lohest.com">hello@isaure-lohest.com</a>
</footer>

<script>
  import { drawInkRules } from '../../scripts/ink';

  // lignes tracées à la main sous chaque lien : une seule, fine, discrète ; elles se dessinent à l'arrivée
  const rules = [...document.querySelectorAll<HTMLElement>('.foot [data-rule]')];
  const draw = () => drawInkRules(rules, 211);
  draw();
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('is-seen');
            io.unobserve(e.target);
          }
        }),
      { threshold: 0.4 },
    );
    rules.forEach((r) => io.observe(r));
  } else rules.forEach((r) => r.classList.add('is-seen'));
  let rt = 0;
  window.addEventListener('resize', () => {
    window.clearTimeout(rt);
    rt = window.setTimeout(draw, 150);
  });
</script>
