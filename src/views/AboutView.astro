---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getDict, localePath } from '../i18n';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = getDict(lang);
const portrait = '/assets/media/pages/home/photo_2024-03-21_10-25-00-960.webp';

// la phrase d'ouverture : deux passages soulignés à la main
const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;');
let statement = esc(d.about.statement);
for (const phrase of d.about.underline) {
  statement = statement.replace(esc(phrase), `<span class="ink-u">${esc(phrase)}<i class="ink-u__line" aria-hidden="true"></i></span>`);
}

// l'enseignement : une phrase forte, soulignée à la main sur le passage clé
let quote = esc(d.about.learn.quote);
quote = quote.replace(
  esc(d.about.learn.mark),
  `<span class="ink-u">${esc(d.about.learn.mark)}<i class="ink-u__line" aria-hidden="true"></i></span>`,
);
---

<SiteLayout lang={lang} title={d.about.title} description={d.about.description}>
  <main class="page about">

    <header class="about__hero">
      <h1 class="about__statement display reveal" set:html={statement} />
      <div class="about__aside reveal">
        <div class="about__aside-col">
          <div class="about__term" aria-hidden="true" data-console data-lines="3" data-phrases={JSON.stringify(d.footer.console)}></div>
          <p>{d.about.paragraphs[0]}</p>
        </div>
      </div>
    </header>

    <div class="about__grid">
      <figure class="about__photo reveal">
        <div class="about__arch">
          <img src={portrait} alt={d.about.photoAlt} width="640" height="800" loading="eager" decoding="async" />
          <span class="about__line" aria-hidden="true"></span>
        </div>
      </figure>

      <div class="about__text">
        {d.about.paragraphs.slice(1).map((p) => <p class="reveal">{p}</p>)}
        <div class="about__links reveal">
          <a class="pill-link" href={localePath('/contact', lang)}>{d.about.cta}</a>
          <a class="about__manifesto label" href="/2026-inspo">{d.about.manifesto} →</a>
        </div>
      </div>

      <div class="about__pair reveal">
        <figure class="about__small about__small--a">
          <img src="/assets/media/pages/home/about-building.webp" alt={d.about.altBuilding} loading="lazy" decoding="async" />
          <span class="about__line" aria-hidden="true"></span>
        </figure>
        <figure class="about__small about__small--b">
          <img src="/assets/media/pages/home/about-spoons.webp" alt={d.about.altSpoons} loading="lazy" decoding="async" />
          <span class="about__line" aria-hidden="true"></span>
        </figure>
      </div>
    </div>

    <section class="about__learn">
      <p class="label reveal">{d.about.learn.label}</p>
      <blockquote class="about__quote display reveal" set:html={quote} />
      <div class="about__learn-text">
        <div class="about__learn-cols">
          {d.about.learn.paragraphs.map((p) => <p class="reveal">{p}</p>)}
        </div>
      </div>
    </section>
  </main>
</SiteLayout>

<script>
  import '../scripts/console';
</script>

<script>
  import { drawInkRules } from '../scripts/ink';

  const lines = [...document.querySelectorAll<HTMLElement>('.ink-u__line')];
  drawInkRules(lines, 91);
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('is-seen');
          io.unobserve(e.target);
        }
      }),
    { threshold: 0.6 },
  );
  lines.forEach((l) => io.observe(l));
  let rt = 0;
  window.addEventListener('resize', () => {
    window.clearTimeout(rt);
    rt = window.setTimeout(() => drawInkRules(lines, 91), 150);
  });
</script>

<style is:global>
  /* la console s'écrit à la machine dans le texte, sans fenêtre : trois lignes qui défilent */
  .about__term {
    min-height: calc(1.8em * 3);
    margin-bottom: 18px;
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 12px;
    line-height: 1.8;
    color: var(--ink-soft);
  }
  .about__term b {
    margin-right: 10px;
    font-weight: 400;
    color: #3a56e8;
  }
  .about__term .cons__line[data-typing]::after {
    content: '_';
    margin-left: 2px;
    animation: cons-blink 1s step-end infinite;
  }
  @keyframes cons-blink {
    50% {
      opacity: 0;
    }
  }
  .about {
    max-width: none;
    padding-inline: clamp(10px, 1.2vw, 18px);
  }
  .about__hero {
    padding: clamp(40px, 8vh, 100px) 0 clamp(50px, 9vh, 110px);
  }
  .about__learn > .label {
    margin: 0 0 clamp(16px, 2.4vw, 30px);
    font-family: var(--font-serif);
    font-size: 17px;
    font-weight: 350;
    letter-spacing: 0;
    text-transform: none;
    color: var(--ink);
  }
  .about__statement,
  .about__quote {
    margin: 0;
    max-width: none;
    font-size: clamp(38px, 8vw, 138px);
    line-height: 0.96;
    letter-spacing: -0.015em;
    text-align: left;
    text-indent: 12%;
    text-wrap: pretty;
  }
  .about__statement .ink-u,
  .about__quote .ink-u {
    text-indent: 0;
  }
  /* petit bloc de texte, justifié, calé à droite ; un point comme repère sur la gauche */
  .about__aside,
  .about__learn-text {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 36%);
    align-items: start;
    margin-top: clamp(26px, 4.5vw, 64px);
  }
  .about__aside-col {
    grid-column: 2;
  }
  .about__learn-cols {
    grid-column: 2;
  }
  .about__aside p,
  .about__text > p,
  .about__learn-cols p {
    margin: 0 0 1.1em;
    font-size: 14px;
    line-height: 1.38;
    text-align: justify;
    hyphens: auto;
    text-wrap: pretty;
  }
  .about__learn-text {
    grid-template-columns: minmax(0, 1fr) minmax(0, 52%);
  }
  .about__learn-cols {
    columns: 2;
    column-gap: clamp(16px, 2.4vw, 36px);
  }
  .about__learn-cols p {
    break-inside: avoid;
  }

  /* la grille à 12 colonnes : l'arche, le texte, les petites images */
  .about__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(12px, 1.6vw, 26px);
    align-items: start;
    padding-bottom: clamp(70px, 13vh, 150px);
  }
  .about__photo {
    grid-column: 1 / 5;
    margin: 0;
  }
  .about__text {
    grid-column: 6 / 10;
    padding-top: clamp(0px, 4vw, 70px);
  }
  .about__pair {
    grid-column: 10 / 13;
    display: grid;
    gap: clamp(26px, 4vw, 56px);
    padding-top: clamp(40px, 9vw, 150px);
  }
  .about__arch,
  .about__small {
    position: relative;
  }
  .about__arch img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 999px 999px 18px 18px;
  }
  /* contour d'encre tremblé, légèrement décalé */
  .about__line {
    position: absolute;
    inset: -9px;
    border: 1.8px solid #2a5cc8;
    border-radius: 999px 999px 24px 24px;
    filter: url(#ink-rough);
    pointer-events: none;
  }
  .about__small {
    margin: 0;
    align-self: start;
  }
  .about__small img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4px;
  }
  .about__small .about__line {
    inset: -7px;
    border-radius: 8px;
  }
  .about__small--a {
    width: 70%;
  }
  .about__small--b {
    width: 100%;
  }
  .about__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px 28px;
    margin-top: 26px;
  }
  .about__manifesto:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .about__learn {
    padding: clamp(20px, 4vw, 50px) 0 clamp(80px, 14vh, 160px);
  }

  @media (max-width: 1000px) {
    .about__grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .about__photo {
      grid-column: 1 / 4;
    }
    .about__text {
      grid-column: 4 / 7;
      padding-top: 0;
    }
    .about__pair {
      grid-column: 1 / 7;
      grid-template-columns: 1fr 1fr;
      align-items: start;
      padding-top: 0;
      margin-top: 40px;
    }
    .about__small--a,
    .about__small--b {
      width: 100%;
    }
  }
  @media (max-width: 700px) {
    .about__statement,
    .about__quote {
      text-indent: 0;
      font-size: clamp(30px, 9.4vw, 46px);
    }
    .about__aside,
    .about__learn-text {
      grid-template-columns: 1fr;
    }
    .about__aside-col,
    .about__learn-cols {
      grid-column: 1;
    }
    .about__learn-cols {
      columns: 1;
    }
    .about__grid {
      grid-template-columns: 1fr;
      row-gap: 40px;
    }
    /* même espace au-dessus et en dessous de l'image */
    .about__hero {
      padding-bottom: 25px;
    }
    .about__photo,
    .about__text,
    .about__pair {
      grid-column: 1;
    }
    .about__photo {
      max-width: 320px;
    }
    .about__pair {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ink-u__line path {
      transition: none;
    }
  }
</style>
