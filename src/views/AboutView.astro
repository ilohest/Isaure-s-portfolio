---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getDict, localePath } from '../i18n';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = getDict(lang);
const portrait = '/assets/media/pages/home/photo_2024-03-21_10-25-00-960.webp';

// la phrase d'ouverture : deux passages soulignés à la main
const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;');
let statement = esc(d.about.statement);
for (const phrase of d.about.underline) {
  statement = statement.replace(esc(phrase), `<span class="ink-u">${esc(phrase)}<i class="ink-u__line" aria-hidden="true"></i></span>`);
}

// l'enseignement : une phrase forte, soulignée à la main sur le passage clé
let quote = esc(d.about.learn.quote);
quote = quote.replace(
  esc(d.about.learn.mark),
  `<span class="ink-u">${esc(d.about.learn.mark)}<i class="ink-u__line" aria-hidden="true"></i></span>`,
);
---

<SiteLayout lang={lang} title={d.about.title} description={d.about.description}>
  <main class="page about">
    <header class="about__hero">
      <p class="label reveal">{d.about.heading}</p>
      <h1 class="about__statement display reveal" set:html={statement} />
    </header>

    <div class="about__grid">
      <figure class="about__photo reveal">
        <div class="about__arch">
          <img src={portrait} alt={d.about.photoAlt} width="640" height="800" loading="eager" decoding="async" />
          <span class="about__line" aria-hidden="true"></span>
        </div>
      </figure>

      <div class="about__text">
        {d.about.paragraphs.map((p) => <p class="reveal">{p}</p>)}

        <div class="about__pair reveal">
          <figure class="about__small about__small--a">
            <img
              src="/assets/media/pages/home/about-building.webp"
              alt={d.about.altBuilding}
              loading="lazy"
              decoding="async"
            />
            <span class="about__line" aria-hidden="true"></span>
          </figure>
          <figure class="about__small about__small--b">
            <img
              src="/assets/media/pages/home/about-spoons.webp"
              alt={d.about.altSpoons}
              loading="lazy"
              decoding="async"
            />
            <span class="about__line" aria-hidden="true"></span>
          </figure>
        </div>

        <div class="about__links reveal">
          <a class="pill-link" href={localePath('/contact', lang)}>{d.about.cta}</a>
          <a class="about__manifesto label" href="/2026-inspo">{d.about.manifesto} →</a>
        </div>
      </div>
    </div>

    <section class="about__learn">
      <p class="label reveal">{d.about.learn.label}</p>
      <div class="about__learn-body">
        <blockquote class="about__quote display reveal" set:html={quote} />
        <div class="about__learn-text">
          {d.about.learn.paragraphs.map((p) => <p class="reveal">{p}</p>)}
        </div>
      </div>
    </section>
  </main>
</SiteLayout>

<script>
  import { drawInkRules } from '../scripts/ink';

  const lines = [...document.querySelectorAll<HTMLElement>('.ink-u__line')];
  drawInkRules(lines, 91);
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('is-seen');
          io.unobserve(e.target);
        }
      }),
    { threshold: 0.6 },
  );
  lines.forEach((l) => io.observe(l));
  let rt = 0;
  window.addEventListener('resize', () => {
    window.clearTimeout(rt);
    rt = window.setTimeout(() => drawInkRules(lines, 91), 150);
  });
</script>

<style is:global>
  .about {
    max-width: 1280px;
  }

  /* phrase d'ouverture : autant d'espace au-dessus qu'en dessous */
  .about__hero {
    --space: clamp(60px, 11vh, 130px);
    padding: var(--space) 0;
  }
  .about__hero .label {
    margin: 0 0 22px;
    color: #85847e;
  }
  .about__statement {
    margin: 0;
    max-width: 33ch;
    font-size: clamp(30px, 4.1vw, 60px);
    line-height: 1.02;
  }
  /* soulignement tracé à la main */
  .ink-u {
    position: relative;
    display: inline-block;
    white-space: nowrap;
  }
  .ink-u__line {
    position: absolute;
    left: -2%;
    right: -2%;
    bottom: -0.22em;
    height: 18px;
    pointer-events: none;
  }
  .ink-u__line svg {
    display: block;
    width: 100%;
    height: 18px;
    overflow: visible;
  }
  .ink-u__line path {
    opacity: 0;
    fill: none;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1.3s cubic-bezier(0.5, 0, 0.2, 1);
  }
  .ink-u__line .r1 {
    stroke: #3f80df;
    stroke-width: 2.6;
  }
  .ink-u__line .r2 {
    stroke: #3f80df;
    stroke-width: 1.2;
    transition-delay: 0.15s;
  }
  .ink-u__line.is-seen path {
    opacity: 1;
    stroke-dashoffset: 0;
  }
  .ink-u__line.is-seen .r2 {
    opacity: 0.5;
  }

  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
    column-gap: clamp(40px, 8vw, 130px);
    align-items: start;
    padding-bottom: clamp(60px, 12vh, 140px);
  }
  .about__photo {
    position: sticky;
    top: calc(var(--nav-h) + 24px);
    margin: 0;
    max-width: 420px;
  }
  .about__arch,
  .about__small {
    position: relative;
  }
  .about__arch img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 999px 999px 18px 18px;
  }
  /* contour d'encre tremblé, légèrement décalé */
  .about__line {
    position: absolute;
    inset: -9px;
    border: 1.8px solid #2a5cc8;
    border-radius: 999px 999px 24px 24px;
    filter: url(#ink-rough);
    pointer-events: none;
  }
  .about__text {
    max-width: 34rem;
    font-size: clamp(16px, 1.3vw, 19px);
    line-height: 1.5;
  }
  .about__text > p {
    margin: 0 0 1.3em;
  }
  .about__pair {
    display: flex;
    align-items: flex-end;
    gap: clamp(20px, 3vw, 40px);
    margin: clamp(36px, 6vw, 70px) 0;
  }
  .about__small {
    margin: 0;
  }
  .about__small img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4px;
  }
  .about__small .about__line {
    inset: -7px;
    border-radius: 8px;
  }
  .about__small--a {
    width: 34%;
  }
  .about__small--b {
    width: 52%;
    margin-bottom: 18px;
  }
  .about__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px 28px;
    margin-top: 10px;
  }
  .about__manifesto:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* ce que j'ai appris */
  .about__learn {
    display: grid;
    grid-template-columns: minmax(11rem, 0.36fr) minmax(0, 1fr);
    gap: clamp(1rem, 4vw, 4rem);
    padding: clamp(32px, 5vw, 64px) 0 clamp(80px, 14vh, 160px);
    border-top: 1px solid color-mix(in srgb, var(--ink) 72%, transparent);
  }
  .about__learn > .label {
    margin: 0;
    color: #85847e;
  }
  .about__quote {
    margin: 0 0 clamp(28px, 4vw, 48px);
    max-width: 24ch;
    font-size: clamp(28px, 3.7vw, 54px);
    line-height: 1.06;
  }
  .about__learn-text {
    max-width: 38rem;
    font-size: clamp(16px, 1.3vw, 19px);
    line-height: 1.5;
  }
  .about__learn-text p {
    margin: 0 0 1.2em;
  }

  @media (max-width: 860px) {
    .about__learn {
      grid-template-columns: 1fr;
    }
    .about__grid {
      grid-template-columns: 1fr;
      row-gap: 40px;
    }
    .about__photo {
      position: static;
      max-width: 300px;
    }
    .about__statement {
      max-width: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ink-u__line path {
      transition: none;
    }
  }
</style>
