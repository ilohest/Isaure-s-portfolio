---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getDict, localePath } from '../i18n';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = getDict(lang);

const hrefs = {
  work: localePath('/work', lang),
  services: localePath('/services', lang),
  about: localePath('/about', lang),
  process: localePath('/process', lang),
  contact: localePath('/contact', lang),
  ai: 'https://ai.isaure-lohest.com/',
};
---

<SiteLayout lang={lang} title={d.home.title} description={d.home.description} hideFooter bodyClass="is-home">
  <main class="home">
    <h1 class="sr-only">{d.home.title}</h1>
    <div
      class="river"
      data-river
      data-labels={JSON.stringify(d.home.shapes)}
      data-hrefs={JSON.stringify(hrefs)}
      data-title={d.home.tagline}
      data-cta={d.home.cta}
      data-cta-href={localePath('/contact', lang)}
    >
    </div>
    <div class="home__clock label" data-clock data-lang={lang} data-location={d.home.location}>
      <span data-clock-date></span>
      <span data-clock-time></span>
    </div>
    <ul class="home__services">
      {d.services.items.map((it) => <li><a href={localePath('/services', lang)}>{it.title}</a></li>)}
    </ul>
    <noscript>
      <ul class="home__fallback">
        {Object.entries(hrefs).map(([k, href]) => <li><a href={href}>{d.home.shapes[k as keyof typeof d.home.shapes]}</a></li>)}
      </ul>
    </noscript>
  </main>
</SiteLayout>

<script>
  import '../scripts/river';

  const clock = document.querySelector<HTMLElement>('[data-clock]');
  if (clock) {
    const lang = clock.dataset.lang === 'en' ? 'en-US' : 'fr-FR';
    const where = clock.dataset.location ?? '';
    const dateEl = clock.querySelector<HTMLElement>('[data-clock-date]')!;
    const timeEl = clock.querySelector<HTMLElement>('[data-clock-time]')!;
    const tick = () => {
      const now = new Date();
      dateEl.textContent = new Intl.DateTimeFormat(lang, {
        weekday: 'long',
        day: 'numeric',
        month: 'long',
        timeZone: 'Europe/Brussels',
      })
        .format(now)
        .toUpperCase();
      const time = new Intl.DateTimeFormat(lang, {
        hour: '2-digit',
        minute: '2-digit',
        hour12: false,
        timeZone: 'Europe/Brussels',
      }).format(now);
      timeEl.textContent = `${where.toUpperCase()}, ${time}`;
    };
    tick();
    window.setInterval(tick, 15000);
  }
</script>

<style is:global>
  body.is-home {
    --paper: #f7f7f6;
    background: linear-gradient(90deg, #ececeb 0%, #f4f4f3 38%, #fbfbfa 100%);
  }
  body.is-home .nav {
    background: none;
  }
  .home {
    position: relative;
    flex: 1;
    min-height: 100svh;
  }
  .river {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .river__svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .home__clock {
    position: absolute;
    left: var(--gutter);
    bottom: 22px;
    display: grid;
    gap: 2px;
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 11px;
    letter-spacing: 0.16em;
    color: #475268;
    text-shadow: 0 0 5px var(--paper), 0 0 2px var(--paper), 0 0 9px var(--paper);
    pointer-events: none;
  }
  .home__services {
    position: absolute;
    right: var(--gutter);
    bottom: 22px;
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: right;
    font-family: var(--font-serif);
    font-size: 17px;
    line-height: 1.5;
  }
  .home__services a {
    transition: opacity 0.3s var(--ease);
  }
  .home__services:hover a {
    opacity: 0.45;
  }
  .home__services a:hover {
    opacity: 1;
  }
  @media (max-width: 520px) {
    .home__services {
      font-size: 14.5px;
    }
    .home__clock {
      font-size: 10px;
      letter-spacing: 0.1em;
    }
  }
  .home__fallback {
    position: absolute;
    inset: auto var(--gutter) 60px;
    display: flex;
    gap: 18px;
    list-style: none;
    padding: 0;
  }

  /* rivière */
  .river__water {
    filter: drop-shadow(0 6px 14px rgba(58, 116, 214, 0.12));
  }
  .river__streak {
    fill: none;
    stroke: rgba(255, 255, 255, 0.34);
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-dasharray: 22 46;
    animation: river-flow 5s linear infinite;
  }
  .river__streak--b {
    stroke-dasharray: 10 70;
    stroke-width: 1;
    animation-duration: 7.5s;
  }
  @keyframes river-flow {
    to {
      stroke-dashoffset: -136;
    }
  }
  .fish__line {
    fill: none;
    stroke: #2a5cc8;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .fish__line--thin {
    stroke-width: 1.7;
    opacity: 0.85;
  }
  .fish__line--thick {
    stroke-width: 6;
    opacity: 0.5;
  }
  .fish__eye {
    fill: #2a5cc8;
  }
  .river__cta {
    cursor: pointer;
  }
  .cta__hull,
  .cta__sail {
    fill: #fffdf7;
    stroke: #2a5cc8;
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .cta__sail--b {
    fill: #eef4ff;
  }
  .cta__fold {
    fill: none;
    stroke: #2a5cc8;
    stroke-width: 1.2;
    stroke-linecap: round;
    opacity: 0.6;
  }
  .cta__text {
    fill: #25417f;
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    transition: letter-spacing 0.5s var(--ease);
  }
  .river__cta:hover .cta__text {
    letter-spacing: 0.3em;
  }
  .cta__hit {
    fill: transparent;
  }
  .river__link {
    cursor: pointer;
    opacity: 0;
    transition: opacity 1.4s var(--ease);
  }
  .river__svg.is-ready .river__link {
    opacity: 1;
  }
  .river__hit {
    fill: none;
    stroke: transparent;
    stroke-width: 44;
    pointer-events: stroke;
  }
  .river__text {
    fill: #c9f4ff;
    font-family: var(--font-sans);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    pointer-events: none;
    transition: fill 0.4s var(--ease);
  }
  .river__link:hover .river__text,
  .river__link:focus-visible .river__text {
    fill: #fff;
  }

  @media (prefers-reduced-motion: reduce) {
    .river__streak {
      animation: none;
    }
  }
</style>
