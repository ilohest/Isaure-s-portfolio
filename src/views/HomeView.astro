---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getDict, localePath } from '../i18n';
import type { Lang } from '../i18n';
import { BOAT_VIEWBOX, boatInner } from '../lib/boat';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = getDict(lang);

const hrefs = {
  work: localePath('/work', lang),
  services: localePath('/services', lang),
  about: localePath('/about', lang),
  process: localePath('/process', lang),
  contact: localePath('/contact', lang),
  ai: 'https://ai.isaure-lohest.com/',
};
---

<SiteLayout lang={lang} title={d.home.title} description={d.home.description} hideFooter bodyClass="is-home">
  <main class="home">
    <h1 class="sr-only">{d.home.title}</h1>
    <div
      class="river"
      data-river
      data-labels={JSON.stringify(d.home.shapes)}
      data-hrefs={JSON.stringify(hrefs)}
      data-title={d.home.tagline}
      data-cta={d.home.cta}
      data-cta-href={localePath('/contact', lang)}
    >
    </div>
    <div class="home__clock label" data-clock data-lang={lang} data-location={d.home.location}>
      <span data-clock-date></span>
      <span data-clock-time></span>
    </div>
    <a class="home__cta" href={localePath('/contact', lang)}>
      <svg class="home__cta-bg" viewBox="0 0 300 56" preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <filter id="cta-rough" x="-5%" y="-20%" width="110%" height="140%">
            <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="9" result="n" />
            <feDisplacementMap in="SourceGraphic" in2="n" scale="3.4" />
          </filter>
        </defs>
        <path
          filter="url(#cta-rough)"
          vector-effect="non-scaling-stroke"
          d="M30,5 C95,2 205,7 270,4 C291,7 297,22 296,29 C294,45 281,52 262,51 C200,55 100,53 32,51 C11,50 4,39 4,27 C4,13 13,7 30,5 Z"
        />
      </svg>
      <span class="home__cta-label">{d.home.cta}</span>
    </a>
    <ul class="home__services">
      {d.home.services.map((label) => <li><a href={localePath('/services', lang)}>{label}</a></li>)}
    </ul>
    <noscript>
      <ul class="home__fallback">
        {Object.entries(hrefs).map(([k, href]) => <li><a href={href}>{d.home.shapes[k as keyof typeof d.home.shapes]}</a></li>)}
      </ul>
    </noscript>
  </main>
</SiteLayout>

<script>
  import '../scripts/river';

  const clock = document.querySelector<HTMLElement>('[data-clock]');
  if (clock) {
    const lang = clock.dataset.lang === 'en' ? 'en-US' : 'fr-FR';
    const where = clock.dataset.location ?? '';
    const dateEl = clock.querySelector<HTMLElement>('[data-clock-date]')!;
    const timeEl = clock.querySelector<HTMLElement>('[data-clock-time]')!;
    const tick = () => {
      const now = new Date();
      dateEl.textContent = new Intl.DateTimeFormat(lang, {
        weekday: 'long',
        day: 'numeric',
        month: 'long',
        timeZone: 'Europe/Brussels',
      })
        .format(now)
        .toUpperCase();
      const time = new Intl.DateTimeFormat(lang, {
        hour: '2-digit',
        minute: '2-digit',
        hour12: false,
        timeZone: 'Europe/Brussels',
      }).format(now);
      timeEl.textContent = `${where.toUpperCase()}, ${time}`;
    };
    tick();
    window.setInterval(tick, 15000);
  }
</script>

<style is:global>
  body.is-home .nav {
    background: none;
  }
  .home {
    position: relative;
    flex: 1;
    min-height: 100svh;
  }
  .river {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .river__svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .home__clock {
    position: absolute;
    z-index: 3;
    left: var(--gutter);
    bottom: 22px;
    display: flex;
    gap: 10px;
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 11px;
    letter-spacing: 0.14em;
    white-space: nowrap;
    color: #475268;
    text-shadow: 0 0 6px var(--paper), 0 0 2px var(--paper);
    pointer-events: none;
  }
  .home__clock [data-clock-time]::before {
    content: '·';
    margin-right: 10px;
  }
  .home__cta {
    position: absolute;
    z-index: 3;
    left: 50%;
    bottom: 18px;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 13px;
    padding: 15px 30px 15px 32px;
    color: #25417f;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 17px;
    white-space: nowrap;
    transition:
      color 0.5s var(--ease),
      transform 0.6s var(--ease);
  }
  .home__cta-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    z-index: -1;
  }
  .home__cta-bg path {
    fill: rgba(255, 253, 247, 0.94);
    stroke: #2a5cc8;
    stroke-width: 1.8;
    stroke-linejoin: round;
    transition: fill 0.6s var(--ease);
  }
  .home__cta:hover {
    color: #fff;
    transform: translateX(-50%) translateY(-2px) rotate(-0.6deg);
  }
  .home__cta:hover .home__cta-bg path {
    fill: #3f80df;
  }
  .home__services {
    position: absolute;
    z-index: 3;
    right: var(--gutter);
    bottom: 22px;
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: right;
    font-family: var(--font-serif);
    font-size: 17px;
    line-height: 1.5;
  }
  .home__services a {
    transition: opacity 0.3s var(--ease);
  }
  .home__services:hover a {
    opacity: 0.45;
  }
  .home__services a:hover {
    opacity: 1;
  }
  @media (max-width: 520px) {
    .home__services {
      font-size: 14.5px;
    }
    /* mobile : la date en haut à droite, sous le sélecteur de langue, sur deux lignes */
    .home__clock {
      font-size: 9.5px;
      letter-spacing: 0.08em;
      left: auto;
      right: var(--gutter);
      bottom: auto;
      top: calc(var(--nav-h) + 10px);
      flex-direction: column;
      align-items: flex-end;
      gap: 3px;
      text-align: right;
    }
    .home__clock [data-clock-time]::before {
      content: none;
    }
    .home__services {
      bottom: 102px;
    }
    .home__cta {
      bottom: 20px;
      font-size: 15.5px;
      padding: 14px 20px 14px 16px;
    }
  }
  .home__fallback {
    position: absolute;
    inset: auto var(--gutter) 60px;
    display: flex;
    gap: 18px;
    list-style: none;
    padding: 0;
  }

  /* rivière */
  .river__water {
    filter: drop-shadow(0 6px 14px rgba(58, 116, 214, 0.12));
  }
  .river__streak {
    fill: none;
    stroke: rgba(255, 255, 255, 0.3);
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 16 42 5 58 24 36;
    animation: river-flow 6s linear infinite;
  }
  .river__streak--b {
    stroke-dasharray: 8 64 18 50 4 70;
    stroke-width: 1;
    animation-duration: 8.5s;
  }
  .river__streak--c {
    stroke-dasharray: 5 90 12 74;
    stroke-width: 0.9;
    animation-duration: 10s;
  }
  /* les reflets avancent vers l'aval : de la gauche vers la droite */
  @keyframes river-flow {
    from {
      stroke-dashoffset: 181;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  .fish__line {
    fill: none;
    stroke: #2a5cc8;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .fish__line--thin {
    stroke-width: 1.7;
    opacity: 0.85;
  }
  .fish__line--thick {
    stroke-width: 6;
    opacity: 0.5;
  }
  .fish__eye {
    fill: #2a5cc8;
  }
  .river__boat {
    cursor: pointer;
  }
  .boat__g {
    transition: opacity 1.2s var(--ease);
  }
  .boat__hit {
    fill: transparent;
  }
  .river__link {
    cursor: pointer;
    opacity: 0;
    transition: opacity 1.4s var(--ease);
  }
  .river__svg.is-ready .river__link {
    opacity: 1;
  }
  .river__hit {
    fill: none;
    stroke: transparent;
    stroke-width: 44;
    pointer-events: stroke;
  }
  .river__text {
    /* éléments du menu : majuscules et blancs */
    fill: #fff;
    opacity: 0.92;
    font-family: var(--font-serif);
    font-style: normal;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    pointer-events: none;
    transition: opacity 0.4s var(--ease);
  }
  .river__link:hover .river__text,
  .river__link:focus-visible .river__text {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .river__streak,
    .home__cta::before {
      animation: none;
    }
  }
</style>
