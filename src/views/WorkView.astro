---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getDict, localePath } from '../i18n';
import type { Lang } from '../i18n';
import { getProjects, summaryFor, titleFor } from '../lib/projects';
import { sectorFor } from '../lib/sectors';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = getDict(lang);
const projects = await getProjects();
// les projets de la page (adresses internes) suivent la langue : /projets/… ou /en/work/…
const hrefFor = (h: string) => (h.startsWith('/') ? localePath(h, lang) : h);
const num = (i: number) => String(i + 1).padStart(2, '0');
---

<SiteLayout lang={lang} title={d.work.title} description={d.work.description} hideFooter>
  <main class="page work" data-work>
    <h1 class="sr-only">{d.work.heading}</h1>

    <div class="sheet">
      {/* à gauche : l'index des projets, en texte vertical (se lit de bas en haut) */}
      <nav class="sheet__index" aria-label={d.work.heading}>
        {
          projects.map((p, i) => (
            <>
              <a class="idx" href={hrefFor(p.href)} data-for={p.id}>
                <span class="idx__n">[{num(i)}]</span> {titleFor(p, lang)}
              </a>{' '}
            </>
          ))
        }
      </nav>

      {/* au centre : quelques mots, qui changent selon le projet survolé */}
      <div class="sheet__say" data-say>
        <div class="say is-active" data-say-for="">
          <p class="say__reflect" data-scr data-reflect data-texts={JSON.stringify(d.work.reflections.map((r) => `[${r}]`))}>[{d.work.reflections[0]}]</p>
        </div>
        {
          projects.map((p, i) => (
            <div class="say" data-say-for={p.id}>
              <div class="say__media">
                {p.video ? (
                  <video data-src={p.video} poster={p.cover} muted loop playsinline preload="none" aria-hidden="true" />
                ) : (
                  <img src={p.cover} alt="" loading="lazy" decoding="async" draggable="false" />
                )}
              </div>
              <p class="say__tag" data-scr>[{num(i)}]</p>
              <p class="say__lines">
                <span data-scr>{titleFor(p, lang)}</span>
                {sectorFor(p, lang) && <span data-scr>[{sectorFor(p, lang)}]</span>}
              </p>
              {summaryFor(p, lang) && <p class="say__sum" data-scr>{summaryFor(p, lang)}</p>}
              <a class="say__open" href={hrefFor(p.href)}>
                {d.work.open} →
              </a>
            </div>
          ))
        }
      </div>

      {/* à droite : les images, alignées verticalement */}
      <ul class="sheet__strip">
        {
          projects.map((p, i) => (
            <li class="thumb">
              <span class="thumb__n" aria-hidden="true">[{num(i)}]</span>
              <a class="thumb__link" href={hrefFor(p.href)} data-for={p.id} aria-label={`${titleFor(p, lang)} (${p.year})`}>
                <img src={p.cover} alt="" loading="lazy" decoding="async" draggable="false" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </main>
</SiteLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-work]');
  if (root) {
    // le bandeau d'images à droite défile à l'infini : la liste est dupliquée sous elle-même,
    // et quand on atteint le début de la copie, on revient au même endroit de l'original
    const strip = root.querySelector<HTMLElement>('.sheet__strip');
    const originals = strip ? ([...strip.children] as HTMLElement[]) : [];
    if (strip && originals.length) {
      const copies = Math.max(1, Math.ceil((window.innerHeight * 2) / Math.max(strip.offsetHeight, 1)));
      for (let c = 0; c < copies; c += 1) {
        originals.forEach((li) => {
          const clone = li.cloneNode(true) as HTMLElement;
          clone.setAttribute('aria-hidden', 'true');
          clone.querySelector('a')?.setAttribute('tabindex', '-1');
          strip.appendChild(clone);
        });
      }
      const first = originals[0];
      const firstClone = strip.children[originals.length] as HTMLElement;
      let wrapRaf = 0;
      const wrap = () => {
        wrapRaf = 0;
        const loop = firstClone.offsetTop - first.offsetTop;
        const seamY = firstClone.getBoundingClientRect().top + window.scrollY;
        if (loop > 0 && window.scrollY >= seamY) {
          window.scrollTo({ top: window.scrollY - loop, behavior: 'instant' });
        }
      };
      window.addEventListener(
        'scroll',
        () => {
          if (!wrapRaf) wrapRaf = window.requestAnimationFrame(wrap);
        },
        { passive: true },
      );
    }

    const says = [...root.querySelectorAll<HTMLElement>('[data-say-for]')];
    const triggers = [...root.querySelectorAll<HTMLElement>('[data-for]')];
    // la réflexion du centre : une phrase différente à chaque chargement, qui ne change plus ensuite
    const reflect = root.querySelector<HTMLElement>('[data-reflect]');
    const texts: string[] = JSON.parse(reflect?.dataset.texts ?? '[]');
    const ri = texts.length ? Math.floor(Math.random() * texts.length) : 0;
    let current = '';
    if (reflect && texts[ri]) reflect.textContent = texts[ri];
    let leaveTimer = 0;

    const show = (id: string) => {
      window.clearTimeout(leaveTimer);
      if (id === current) return;
      current = id;
      says.forEach((s) => {
        const on = (s.dataset.sayFor ?? '') === id;
        s.classList.toggle('is-active', on);
        const v = s.querySelector<HTMLVideoElement>('video');
        if (v) {
          if (on) {
            if (!v.src && v.dataset.src) v.src = v.dataset.src;
            void v.play().catch(() => undefined);
          } else v.pause();
        }
      });
      triggers.forEach((t) => t.classList.toggle('is-on', t.dataset.for === id));
    };
    const reset = () => {
      window.clearTimeout(leaveTimer);
      leaveTimer = window.setTimeout(() => show(''), 250);
    };
    // au toucher : pas de survol. Un premier appui affiche l'aperçu (et il reste affiché), un second ouvre le projet
    const touch = window.matchMedia('(hover: none)');
    triggers.forEach((t) => {
      const id = t.dataset.for ?? '';
      t.addEventListener('pointerenter', (e) => {
        if ((e as PointerEvent).pointerType !== 'touch') show(id);
      });
      t.addEventListener('focus', () => {
        if (!touch.matches) show(id);
      });
      t.addEventListener('pointerleave', (e) => {
        if ((e as PointerEvent).pointerType !== 'touch') reset();
      });
      t.addEventListener('blur', () => {
        if (!touch.matches) reset();
      });
      t.addEventListener('click', (e) => {
        if (touch.matches && current !== id) {
          e.preventDefault();
          show(id);
        }
      });
    });
  }
</script>

<style is:global>
  /* le défilement est infini : pas de barre de défilement sur cette page */
  html:has([data-work]) {
    scrollbar-width: none;
  }
  html:has([data-work])::-webkit-scrollbar {
    display: none;
  }

  .work {
    --grey: #85847e;
    max-width: none;
    /* pleine largeur : plus de marges sur les côtés */
    padding-inline: clamp(10px, 1.2vw, 18px);
    padding-top: calc(var(--nav-h) + 20px);
    padding-bottom: 20px;
    font-family: var(--font-serif);
    font-size: 14px;
    line-height: 1.4;
  }

  /* la feuille : texte vertical à gauche, mots au centre, images à droite */
  .sheet {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: stretch;
    gap: clamp(16px, 3vw, 48px);
    min-height: calc(100svh - var(--nav-h) - 40px);
    margin-top: 0;
  }

  /* index vertical : se lit de bas en haut, sur plusieurs colonnes */
  .sheet__index {
    position: sticky;
    top: calc(var(--nav-h) + 20px);
    align-self: start;
    grid-column: 1;
    /* la hauteur d'écran moins la barre du haut et deux marges : le texte ne peut pas dépasser */
    height: calc(100svh - var(--nav-h) - 40px);
    max-width: 38vw;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    line-height: 1.55;
    color: var(--grey);
    overflow: hidden;
    text-transform: none;
    letter-spacing: 0;
    font-family: var(--font-serif);
    font-size: 14px;
  }
  .idx {
    transition: color 0.3s var(--ease);
  }
  .idx__n {
    color: var(--ink);
  }
  .idx:hover,
  .idx.is-on,
  .idx:focus-visible {
    color: #2a5cc8;
  }

  /* mots au centre : centrés sur la hauteur de l'écran, quelle que soit la longueur de la page */
  .sheet__say {
    position: sticky;
    top: 0;
    align-self: start;
    display: grid;
    place-items: center;
    grid-column: 2;
    /* centré sur toute la hauteur de l'écran */
    margin-top: calc(-1 * (var(--nav-h) + 20px));
    height: 100svh;
    pointer-events: none;
    text-align: center;
  }
  .say {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 24rem;
    padding: 0 12px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition:
      opacity 0.45s var(--ease),
      transform 0.6s var(--ease),
      visibility 0s linear 0.45s;
  }
  .say.is-active {
    pointer-events: auto;
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }
  .say__media {
    width: clamp(200px, 23vw, 340px);
    margin-bottom: 26px;
  }
  /* l'image apparaît depuis son centre : un cadre qui s'ouvre en cercles concentriques, en grandissant */
  .say__media {
    clip-path: inset(50% 50% 50% 50%);
    transform: scale(0.55);
    transition:
      clip-path 0.3s var(--ease),
      transform 0.3s var(--ease);
  }
  .say.is-active .say__media {
    clip-path: inset(0 0 0 0);
    transform: none;
    transition:
      clip-path 0.85s var(--ease) 0.05s,
      transform 0.95s var(--ease) 0.05s;
  }
  @media (prefers-reduced-motion: reduce) {
    .say__media,
    .say.is-active .say__media {
      clip-path: none;
      transform: none;
      transition: none;
    }
  }
  .say__media img,
  .say__media video {
    display: block;
    width: 100%;
    max-height: 44vh;
    object-fit: contain;
  }
  .say__tag {
    margin: 0 0 8px;
    font-family: var(--font-serif);
    font-size: 17px;
    color: var(--ink);
  }
  .say__lines {
    display: grid;
    margin: 0;
    font-family: var(--font-serif);
    font-size: 17px;
    line-height: 1.25;
  }
  /* le secteur, un peu plus clair que le titre (comme dans « More projects ») */
  .say__lines > span + span {
    color: var(--grey);
  }
  .say__reflect {
    display: grid;
    margin: 0;
    max-width: 19rem;
    font-family: var(--font-serif);
    font-size: 17px; /* taille du texte courant du site */
    line-height: 1.25;
    text-wrap: balance;
  }
  /* défilement de lettres : un double invisible garde la mise en page du texte final */
  .scr {
    position: relative;
  }
  .scr__ghost {
    visibility: hidden;
  }
  .scr__live {
    position: absolute;
    inset: 0;
  }
  .say__sum {
    margin: 18px 0 0;
    max-width: 22rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 15px;
    line-height: 1.45;
    color: var(--grey);
  }
  .say__open {
    margin-top: 18px;
    border-bottom: 1px solid currentColor;
    color: #2a5cc8;
    text-transform: none;
    letter-spacing: 0;
    font-family: var(--font-serif);
    font-size: 15px;
  }

  /* images alignées à droite */
  .sheet__strip {
    grid-column: 3;
    display: flex;
    flex-direction: column;
    gap: 5px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .thumb {
    display: flex;
    flex: 1 1 0;
    align-items: stretch;
    justify-content: flex-end;
    gap: 8px;
    min-height: clamp(58px, 5.6vw, 86px);
  }
  .thumb__n {
    align-self: flex-end;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: 9px;
    letter-spacing: 0.06em;
    color: var(--grey);
  }
  .thumb__link {
    display: block;
    width: clamp(94px, 8.4vw, 132px);
    overflow: hidden;
    transition:
      transform 0.5s var(--ease),
      opacity 0.4s var(--ease);
  }
  .thumb__link img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* quand un projet est survolé, les autres s'effacent un peu */
  .sheet__strip:hover .thumb__link:not(:hover) {
    opacity: 0.45;
  }
  /* au survol, la vignette ET son numéro glissent ensemble vers la gauche (le numéro reste visible) */
  .thumb {
    transition: transform 0.5s var(--ease);
  }
  .thumb:has(.thumb__link:hover),
  .thumb:has(.thumb__link.is-on),
  .thumb:has(.thumb__link:focus-visible) {
    transform: translateX(-14px);
  }

  @media (max-width: 760px) {
    /* mots à gauche, images (plus grandes) à droite ; pas d'index vertical */
    .sheet__index {
      display: none;
    }
    .sheet {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 12px;
    }
    .sheet__say {
      grid-column: 1;
    }
    .sheet__strip {
      grid-column: 2;
    }
    .say {
      padding: 0 4px;
    }
    .say__reflect {
      font-size: 15px;
    }
    .thumb__link {
      width: clamp(130px, 40vw, 190px);
    }
    .thumb {
      min-height: clamp(78px, 23vw, 110px);
    }
    .say__media {
      width: 140px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .say,
    .thumb__link {
      transition: none;
    }
  }
</style>
