---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getDict } from '../i18n';
import type { Lang } from '../i18n';
import { getProjects, summaryFor } from '../lib/projects';
import { BOAT_VIEWBOX, boatInner } from '../lib/boat';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = getDict(lang);
const projects = await getProjects();
const pad = (n: number) => String(n).padStart(2, '0');
---

<SiteLayout lang={lang} title={d.work.title} description={d.work.description}>
  <main class="page work" data-work data-view="index">
    <header class="work__bar label">
      <div class="work__title">
        <h1>{d.work.heading}</h1>
        <span>({projects.length})</span>
        <span class="work__intro">{d.work.intro}</span>
      </div>
      <div class="work__views" role="group" aria-label="Vue">
        <button type="button" data-set-view="index" aria-pressed="true">{d.work.viewIndex}</button>
        <span aria-hidden="true">/</span>
        <button type="button" data-set-view="overview" aria-pressed="false">{d.work.viewOverview}</button>
      </div>
    </header>

    <!-- INDEX : une ligne par projet, le bateau navigue jusqu'à la ligne survolée -->
    <section class="index" aria-label={d.work.viewIndex}>
      <div class="index__head label">
        <span></span>
        <span>{d.work.colNo}</span>
        <span>{d.work.colProject}</span>
        <span></span>
        <span>{d.work.colSector}</span>
        <span class="index__yr">{d.work.colYear}</span>
      </div>
      <div class="index__rows" data-rows>
        <svg class="work__boat" viewBox={BOAT_VIEWBOX} aria-hidden="true" set:html={boatInner} />
        {
          projects.map((p, i) => (
            <a class="row" href={p.href} data-cover={p.cover}>
              <span class="row__boat-gutter"></span>
              <span class="row__no">{pad(i + 1)}</span>
              <span class="row__title">{p.title}</span>
              <span class="row__sum">{summaryFor(p, lang)}</span>
              <span class="row__sector">{p.sector}</span>
              <span class="row__year">{p.year}</span>
              <img class="row__thumb" src={p.cover} alt="" loading="lazy" decoding="async" />
            </a>
          ))
        }
      </div>
      <img class="work__thumb" data-thumb alt="" aria-hidden="true" />
    </section>

    <!-- APERÇU : petites vignettes -->
    <section class="overview" aria-label={d.work.viewOverview}>
      {
        projects.map((p, i) => (
          <a class="cell" href={p.href}>
            <span class="cell__img">
              <img src={p.cover} alt="" loading="lazy" decoding="async" />
              <svg class="cell__boat" viewBox={BOAT_VIEWBOX} aria-hidden="true" set:html={boatInner} />
            </span>
            <span class="cell__cap">
              <span>{pad(i + 1)}</span>
              <span>{p.title}</span>
              <span class="cell__yr">{p.year}</span>
            </span>
          </a>
        ))
      }
    </section>
  </main>
</SiteLayout>

<script>
  import '../scripts/work-index';
</script>

<style is:global>
  .work {
    --rule: color-mix(in srgb, var(--ink) 72%, transparent);
    --grey: #85847e;
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.35;
    letter-spacing: 0.005em;
  }
  .work .label {
    letter-spacing: 0.06em;
    font-size: 11px;
  }

  /* barre du haut */
  .work__bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px 24px;
    padding-bottom: 16px;
    margin-top: clamp(24px, 8vh, 90px);
  }
  .work__title {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    align-items: baseline;
  }
  .work__title h1 {
    margin: 0;
    font: inherit;
    letter-spacing: inherit;
    text-transform: uppercase;
  }
  .work__intro {
    color: var(--grey);
    text-transform: none;
    letter-spacing: 0;
    font-size: 12.5px;
  }
  .work__views {
    display: inline-flex;
    gap: 8px;
    text-transform: uppercase;
  }
  .work__views button {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: pointer;
    color: var(--grey);
    transition: color 0.3s var(--ease);
  }
  .work__views button[aria-pressed='true'],
  .work__views button:hover {
    color: var(--ink);
  }

  /* ---------- index ---------- */
  .index {
    position: relative;
    border-top: 1px solid var(--rule);
  }
  .index__head,
  .row {
    display: grid;
    grid-template-columns: 52px 44px minmax(0, 1.15fr) minmax(0, 2fr) minmax(0, 0.9fr) 56px;
    column-gap: 14px;
    align-items: baseline;
  }
  .index__head {
    padding: 10px 0;
    color: var(--grey);
    text-transform: uppercase;
  }
  .index__yr,
  .row__year {
    text-align: right;
  }
  .index__rows {
    position: relative;
    border-top: 1px solid var(--rule);
  }
  .row {
    position: relative;
    padding: 15px 0 16px;
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 18%, transparent);
    transition: opacity 0.4s var(--ease);
  }
  .row__no {
    color: var(--grey);
    font-variant-numeric: tabular-nums;
  }
  .row__title {
    font-size: 14px;
  }
  .row__sum {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 14.5px;
    color: var(--grey);
  }
  .row__sector {
    color: var(--grey);
  }
  .row__thumb {
    display: none;
  }
  @media (hover: hover) {
    .index__rows:hover .row:not(:hover) {
      opacity: 0.32;
    }
  }

  /* le bateau navigue dans la marge, jusqu'à la ligne survolée */
  .work__boat {
    position: absolute;
    left: 4px;
    top: 0;
    z-index: 2;
    width: 36px;
    height: 23px;
    margin-top: -33px;
    overflow: visible;
    pointer-events: none;
    transition: transform 0.85s cubic-bezier(0.34, 1.25, 0.5, 1);
    animation: work-rock 4.2s ease-in-out infinite;
  }
  .work__boat.is-sailing {
    animation-duration: 1.2s;
  }
  @keyframes work-rock {
    0%,
    100% {
      rotate: -3deg;
    }
    50% {
      rotate: 3deg;
    }
  }

  /* vignette qui suit la souris */
  .work__thumb {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 20;
    width: 250px;
    height: 176px;
    object-fit: cover;
    border: 1px solid var(--rule);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s var(--ease);
  }
  .work__thumb.is-on {
    opacity: 1;
  }

  /* ---------- aperçu ---------- */
  .overview {
    display: none;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 34px 22px;
    border-top: 1px solid var(--rule);
    padding-top: 22px;
  }
  .work[data-view='overview'] .overview {
    display: grid;
  }
  .work[data-view='overview'] .index {
    display: none;
  }
  .cell {
    display: block;
  }
  .cell__img {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--ink) 25%, transparent);
    background: var(--paper-2);
  }
  .cell__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.4s var(--ease);
  }
  .cell:hover .cell__img img {
    opacity: 0.82;
  }
  .cell__boat {
    position: absolute;
    left: 10px;
    bottom: 8px;
    width: 34px;
    height: 22px;
    overflow: visible;
    opacity: 0;
    transform: translateX(-14px);
    transition:
      opacity 0.4s var(--ease),
      transform 0.7s cubic-bezier(0.34, 1.25, 0.5, 1);
    animation: work-rock 4.2s ease-in-out infinite;
  }
  .cell:hover .cell__boat {
    opacity: 1;
    transform: none;
  }
  .cell__cap {
    display: grid;
    grid-template-columns: 30px 1fr auto;
    gap: 8px;
    padding-top: 8px;
  }
  .cell__cap > span:first-child,
  .cell__yr {
    color: var(--grey);
  }

  /* ---------- mobile / tactile ---------- */
  @media (max-width: 900px) {
    .overview {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 760px), (hover: none) {
    .work__boat,
    .work__thumb {
      display: none;
    }
    .index__head {
      display: none;
    }
    .row {
      grid-template-columns: 74px 28px minmax(0, 1fr) auto;
      grid-template-areas:
        'thumb no title year'
        'thumb . sum sum'
        'thumb . sector sector';
      row-gap: 3px;
      padding: 14px 0;
    }
    .row__boat-gutter {
      display: none;
    }
    .row__thumb {
      display: block;
      grid-area: thumb;
      width: 74px;
      height: 56px;
      object-fit: cover;
      border: 1px solid color-mix(in srgb, var(--ink) 25%, transparent);
    }
    .row__no {
      grid-area: no;
    }
    .row__title {
      grid-area: title;
    }
    .row__year {
      grid-area: year;
    }
    .row__sum {
      grid-area: sum;
      font-size: 13.5px;
    }
    .row__sector {
      grid-area: sector;
      font-size: 12px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .work__boat,
    .cell__boat {
      animation: none;
    }
  }
</style>
