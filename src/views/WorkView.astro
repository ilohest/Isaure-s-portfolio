---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getDict } from '../i18n';
import type { Lang } from '../i18n';
import { getProjects, summaryFor } from '../lib/projects';
import { BOAT_VIEWBOX, boatInner } from '../lib/boat';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = getDict(lang);
const projects = await getProjects();
---

<SiteLayout lang={lang} title={d.work.title} description={d.work.description}>
  <main class="page work" data-work>
    <div class="work__rows" data-rows>
      <svg class="work__boat" viewBox={BOAT_VIEWBOX} aria-hidden="true" set:html={boatInner} />

      {
        projects.map((p) => {
          const summary = summaryFor(p, lang);
          return (
            <section class="proj" data-proj>
              <div class="proj__rule" data-rule aria-hidden="true"></div>
              {/* 1 · carte d'info : numéro, titre, mots-clés, secteur */}
              <article class="cell cell--info" data-info>
                <h2 class="info__title">
                  <a href={p.href}>{p.title}</a>
                </h2>
                {p.keywords.length > 0 && (
                  <ul class="info__keys">
                    {p.keywords.map((k) => (
                      <li>{k}</li>
                    ))}
                  </ul>
                )}
                <p class="info__meta">
                  {p.year}
                  {p.sector && (
                    <>
                      <br />
                      {p.sector}
                    </>
                  )}
                </p>
                {summary && <p class="info__sum">{summary}</p>}
                <a class="info__open" href={p.href}>
                  {d.work.open} →
                </a>
              </article>

              {/* 2 · la vidéo (si le projet en a une) */}
              {p.video && (
                <figure class="cell cell--media cell--video" data-media>
                  <div class="media__frame" style={`aspect-ratio:${p.images[0] ? `${p.images[0].w} / ${p.images[0].h}` : '16 / 10'}`}>
                    <video data-src={p.video} poster={p.cover} muted loop playsinline preload="none" aria-label={`${p.title} — video`} />
                  </div>
                </figure>
              )}

              {/* 3 · les images, dans leur format d'origine */}
              {p.images.map((img) => (
                <figure class="cell cell--media" data-media>
                  {img.caption && <figcaption class="media__label">{img.caption}</figcaption>}
                  <div class="media__frame" style={`aspect-ratio:${img.w} / ${img.h}`}>
                    <img
                      src={img.src}
                      width={img.w}
                      height={img.h}
                      alt={img.caption ? `${p.title} — ${img.caption}` : p.title}
                      loading="lazy"
                      decoding="async"
                      draggable="false"
                    />
                  </div>
                </figure>
              ))}
            </section>
          );
        })
      }
      <div class="proj__rule proj__rule--end" data-rule aria-hidden="true"></div>
    </div>
  </main>
</SiteLayout>

<noscript>
  <style>
    .media__frame img,
    .media__frame video {
      opacity: 1 !important;
      clip-path: none !important;
      filter: none !important;
    }
  </style>
</noscript>

<script>
  import '../scripts/work-grid';
</script>

<style is:global>
  .work {
    --rule: color-mix(in srgb, var(--ink) 72%, transparent);
    --grey: #85847e;
    --cols: 6;
    max-width: none;
    font-family: var(--font-sans);
    font-size: 12.5px;
    line-height: 1.4;
    letter-spacing: 0.005em;
  }
  .work .label {
    letter-spacing: 0.06em;
    font-size: 11px;
  }

  /* ---------- grille : une ligne par projet ---------- */
  .work__rows {
    position: relative;
    padding-left: 46px;
    margin-top: clamp(10px, 4vh, 40px);
  }
  .proj {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    column-gap: 14px;
    row-gap: 22px;
    align-items: start;
    padding: 0 0 34px;
  }
  /* lignes horizontales dessinées à la main (même trait que la page Process) */
  .proj__rule {
    grid-column: 1 / -1;
    height: 18px;
    margin: 0 0 12px;
  }
  .proj__rule--end {
    margin: 0;
  }
  .proj__rule svg {
    display: block;
    width: 100%;
    height: 18px;
    overflow: visible;
  }
  .proj__rule path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1.6s cubic-bezier(0.5, 0, 0.2, 1);
  }
  .proj__rule .r1 {
    stroke: #1f2a52;
    stroke-width: 1.4;
  }
  .proj__rule .r2 {
    stroke: #1f2a52;
    stroke-width: 0.8;
    opacity: 0.5;
    transition-delay: 0.15s;
  }
  .proj__rule.is-seen path {
    stroke-dashoffset: 0;
  }
  .cell {
    margin: 0;
    min-width: 0;
  }

  /* carte d'info */
  .cell--info {
    display: grid;
    gap: 14px;
    align-content: start;
    padding-right: 6px;
  }
  .info__title {
    margin: 0;
    font: inherit;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .info__title a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .info__keys {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .info__meta {
    margin: 0;
    color: var(--ink);
  }
  .info__sum {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 14px;
    line-height: 1.35;
    color: var(--grey);
  }
  .info__open {
    justify-self: start;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-bottom: 1px solid currentColor;
    opacity: 0.7;
    transition: opacity 0.3s var(--ease);
  }
  .info__open:hover {
    opacity: 1;
  }

  /* cellules d'image / vidéo : vides tant qu'on ne les survole pas */
  .media__label {
    display: block;
    margin-bottom: 8px;
    color: var(--grey);
    transition: color 0.5s var(--ease);
  }
  .cell--media.is-shown .media__label {
    color: var(--ink);
  }
  .media__frame {
    position: relative;
    width: 100%;
    overflow: hidden;
  }
  .media__frame img,
  .media__frame video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    filter: blur(7px);
    clip-path: inset(0 0 100% 0);
    transform: translateY(6px);
    /* disparition : on fond d'abord, puis on referme la fenêtre */
    transition:
      opacity 1.1s ease,
      filter 1.1s ease,
      transform 1.1s var(--ease),
      clip-path 0s linear 1.15s;
  }
  .cell--media.is-shown .media__frame img,
  .cell--media.is-shown .media__frame video {
    opacity: 1;
    filter: blur(0);
    clip-path: inset(0 0 0 0);
    transform: none;
    transition:
      opacity 0.9s ease var(--rd, 0ms),
      filter 1s ease var(--rd, 0ms),
      transform 1s var(--ease) var(--rd, 0ms),
      clip-path 0.95s cubic-bezier(0.65, 0, 0.2, 1) var(--rd, 0ms);
  }

  /* le bateau navigue dans la marge jusqu'au projet survolé */
  .work__boat {
    position: absolute;
    left: 2px;
    top: 0;
    z-index: 2;
    width: 36px;
    height: 23px;
    margin-top: 10px;
    overflow: visible;
    pointer-events: none;
    transition: transform 0.9s cubic-bezier(0.34, 1.25, 0.5, 1);
    animation: work-rock 4.2s ease-in-out infinite;
  }
  .work__boat.is-sailing {
    animation-duration: 1.2s;
  }
  @keyframes work-rock {
    0%,
    100% {
      rotate: -3deg;
    }
    50% {
      rotate: 3deg;
    }
  }

  @media (max-width: 1280px) {
    .work {
      --cols: 5;
    }
  }
  @media (max-width: 980px) {
    .work {
      --cols: 3;
    }
  }
  @media (max-width: 640px) {
    .work {
      --cols: 2;
    }
    .work__rows {
      padding-left: 0;
    }
    .work__boat {
      display: none;
    }
    .cell--info {
      grid-column: 1 / -1;
    }
  }
  @media (hover: none) {
    .work__boat {
      display: none;
    }
    .work__rows {
      padding-left: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .work__boat {
      animation: none;
    }
    .media__frame img,
    .media__frame video {
      filter: none;
      transform: none;
      clip-path: none;
    }
    .proj__rule path {
      stroke-dashoffset: 0;
      transition: none;
    }
  }
</style>
