---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getDict, localePath } from '../i18n';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = getDict(lang);
const radii = ['999px', '34% 66% 30% 70% / 60% 30% 70% 40%', '50% 50% 50% 8%', '48px 48px 999px 999px'];
---

<SiteLayout lang={lang} title={d.services.title} description={d.services.description}>
  <canvas class="particles" aria-hidden="true"></canvas>
  <main class="page services">
    <p class="label reveal">{d.services.heading}</p>
    <h1 class="services__title display reveal">{d.services.intro}</h1>

    <div class="services__grid">
      {
        d.services.items.map((s, i) => {
          const Tag = s.href ? 'a' : 'div';
          return (
            <article class="svc reveal" style={`--c: var(--${s.color}); --d:${i * 90}ms`}>
              <Tag
                class="svc__main"
                {...(s.href ? { href: s.href, target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                <span class="svc__shape" style={`border-radius:${radii[i % radii.length]}`} aria-hidden="true" />
                <span class="svc__num label">0{i + 1}</span>
                <h2 class="svc__title display">
                  {s.title}
                  {s.href && <span aria-hidden="true"> ↗</span>}
                </h2>
                <p class="svc__line">{s.line}</p>
                <ul class="svc__tags label">
                  {s.tags.map((tag) => <li>{tag}</li>)}
                </ul>
              </Tag>
              <details class="svc__more">
                <summary class="label">{d.services.more}</summary>
                <p>{s.detail}</p>
              </details>
            </article>
          );
        })
      }
    </div>

    <a class="pill-link reveal services__cta" href={localePath('/contact', lang)}>{d.services.cta}</a>
  </main>
</SiteLayout>

<script>
  import { initParticles } from '../scripts/particles';
  const canvas = document.querySelector<HTMLCanvasElement>('.particles');
  if (canvas) initParticles(canvas);
</script>

<style is:global>
  .particles {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .services {
    position: relative;
    z-index: 1;
  }
  .services__title {
    font-size: clamp(36px, 6vw, 80px);
    margin: clamp(10px, 2vw, 24px) 0 clamp(32px, 6vw, 72px);
    max-width: 14ch;
  }
  .services__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(18px, 3vw, 40px);
  }
  .svc {
    transition-delay: var(--d);
  }
  .svc__main {
    position: relative;
    display: grid;
    align-content: end;
    gap: 6px;
    min-height: clamp(260px, 30vw, 400px);
    padding: clamp(22px, 3vw, 38px);
    overflow: hidden;
    color: var(--ink);
    border-radius: 28px;
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    backdrop-filter: blur(2px);
  }
  .svc__shape {
    position: absolute;
    top: clamp(18px, 2.4vw, 30px);
    right: clamp(18px, 2.4vw, 30px);
    width: clamp(90px, 12vw, 160px);
    height: clamp(90px, 12vw, 160px);
    border: 8px solid var(--c);
    filter: blur(2.2px);
    transition:
      transform 1.1s var(--ease),
      border-width 0.6s var(--ease);
  }
  .svc__main:hover .svc__shape {
    transform: rotate(18deg) scale(1.12);
    border-width: 12px;
  }
  .svc__num {
    position: absolute;
    top: clamp(22px, 3vw, 36px);
    left: clamp(22px, 3vw, 38px);
    color: var(--ink-soft);
  }
  .svc__title {
    margin: 0;
    font-size: clamp(28px, 3.6vw, 50px);
  }
  .svc__line {
    margin: 0;
    max-width: 30ch;
    color: var(--ink-soft);
    font-style: italic;
  }
  .svc__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
  }
  .svc__tags li {
    padding: 4px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
  }
  .svc__more {
    padding: 14px clamp(22px, 3vw, 38px) 0;
  }
  .svc__more summary {
    cursor: pointer;
    list-style: none;
    color: var(--ink-soft);
  }
  .svc__more summary::-webkit-details-marker {
    display: none;
  }
  .svc__more summary::after {
    content: ' +';
  }
  .svc__more[open] summary::after {
    content: ' –';
  }
  .svc__more p {
    max-width: 52ch;
    margin: 12px 0 0;
  }
  .services__cta {
    margin-top: clamp(36px, 6vw, 72px);
  }
  @media (max-width: 760px) {
    .services__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
