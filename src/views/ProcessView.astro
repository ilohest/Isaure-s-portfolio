---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getDict, localePath } from '../i18n';
import type { Lang } from '../i18n';
import { BOAT_VIEWBOX, boatInner } from '../lib/boat';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = getDict(lang);
const [wordA, wordB] = d.process.heading.split(' ');

/** un petit dessin à l'encre par étape (même trait que les icônes des services) ; les <g class="a …"> s'animent doucement */
const FIGS: Record<string, string> = {
  // comprendre : une conversation, et la loupe qui cherche le vrai problème
  think:
    '<path d="M14,16 C40,13 78,14 96,15 L97,52 C84,53 70,53 60,53 L44,69 L45,54 C34,54 22,54 15,53 Z" class="paper"/>' +
    '<path d="M26,29 C40,28 62,29 82,28"/>' +
    '<path d="M26,40 C38,39.5 50,40 66,39"/>' +
    '<g class="a a-search">' +
    '<path d="M92,58 a17,17 0 1,0 34,0 a17,17 0 1,0 -34,0" class="paper"/>' +
    '<path d="M121,71 C127,77 131,83 136,90" class="thick"/>' +
    '<path d="M121,71 C127,77 131,83 136,90"/>' +
    '<path d="M109,58 l.1 0" class="dot"/>' +
    '<path d="M100,52 C103,47 108,45 113,46"/>' +
    '</g>',
  // construire : des blocs qui s'empilent, et le crayon qui les dessine
  build:
    '<path d="M12,62 C28,60 50,61 64,62 L63,88 C48,90 28,89 13,88 Z"/>' +
    '<path d="M72,62 C88,61 108,62 122,62 L121,88 C106,90 88,89 73,88 Z"/>' +
    '<g class="a a-block">' +
    '<path d="M38,34 C52,32 76,33 90,34 L89,60 C74,61 54,61 39,60 Z" class="paper"/>' +
    '<path d="M50,46 C58,45.5 68,46 78,45" class="thick"/>' +
    '</g>' +
    '<path d="M22,74 C32,73.5 42,74 52,73 M84,74 C94,73.5 104,74 112,73" class="thick"/>' +
    '<g class="a a-pencil">' +
    '<path d="M104.8,8.4 L116.8,24.4 L94.2,32.6 Q89.5,31.5 90.6,27.8 Z" class="paper"/>' +
    '<path d="M96,28.5 C96.5,23 100.5,19.5 104,21.5 C106.5,17.5 112,18.5 111,22.5 C113,25.5 108.5,27.5 105,26.5 C101,30.5 97,31.5 96,28.5 Z" class="mortar"/>' +
    '<path d="M91.5,36.5 l.1 0" class="dot"/>' +
    '<path d="M110,17 C111,13 111.5,10 114,8"/>' +
    '<path d="M113.6,4.6 L124.6,-3.5 C127.5,-2.6 129,-0.6 128.4,1.7 L117.4,9.8 Z" class="paper"/>' +
    '<path d="M115.2,3.4 L119,8.6"/>' +
    '</g>',
  // déployer : le projet prend son envol
  deploy:
    '<g class="a a-fly"><g class="a a-loop">' +
    '<path d="M16,56 C50,42 90,28 124,16 C112,44 100,66 88,86 C82,74 76,66 70,60 Z" class="paper"/>' +
    '<path d="M124,16 C104,34 84,48 70,60"/>' +
    '<path d="M70,60 C69,68 68,74 66,80 C72,76 78,72 83,70"/>' +
    '</g></g>' +
    '<g class="a a-trail">' +
    '<path d="M12,88 l.1 0 M22,84 l.1 0 M32,76 l.1 0 M42,70 l.1 0 M52,66 l.1 0" class="dot"/>' +
    '</g>',
  // fêter : le cornet de confettis qui éclate
  celebrate:
    '<path d="M14,90 C23,72 31,54 40,42 C50,50 60,60 68,68 C52,78 34,86 14,90 Z" class="paper"/>' +
    '<path d="M26,68 C34,72 40,76 46,82 M33,54 C41,58 47,62 55,68"/>' +
    '<g class="a a-burst">' +
    '<path d="M50,36 C57,26 68,21 82,18"/>' +
    '<path d="M60,46 C74,40 88,40 102,44"/>' +
    '<path d="M44,28 C46,19 49,13 52,6"/>' +
    '</g>' +
    '<path d="M84,31 l.1 0" class="dot a a-conf" style="--d:0"/>' +
    '<path d="M98,22 l.1 0" class="dot a a-conf" style="--d:1"/>' +
    '<path d="M110,38 l.1 0" class="dot a a-conf" style="--d:2"/>' +
    '<path d="M72,10 l.1 0" class="dot a a-conf" style="--d:3"/>' +
    '<path d="M106,58 l.1 0" class="dot a a-conf" style="--d:4"/>' +
    '<path d="M120,26 l.1 0" class="dot a a-conf" style="--d:5"/>' +
    '<g class="a a-spark">' +
    '<path d="M112,50 C113,58 116,61 124,63 C116,65 113,68 112,76 C111,68 108,65 100,63 C108,61 111,58 112,50 Z" class="paper"/>' +
    '</g>' +
    '<path d="M78,60 C84,54 88,66 94,60 C100,54 104,66 108,62"/>',
};
---

<SiteLayout lang={lang} title={d.process.title} description={d.process.description}>
  <!-- fond : orbes floues qui fuient la souris puis reviennent en dérivant -->
  <canvas class="proc__orbs" data-orbs aria-hidden="true"></canvas>

  <main class="proc" data-process>
    <header class="proc__hero">
      <h1 class="proc__h display">
        <span>{wordA}</span>
        <span>{wordB}</span>
      </h1>
      <p class="proc__vision">{d.process.vision}</p>
    </header>

    <div class="proc__steps">
      {
        d.process.steps.map((s) => (
          <article class="step" data-step>
            <div class="step__layout">
              <h2 class="step__title display">
                <span class="step__hash" data-hash aria-hidden="true">#</span>{s.title}
              </h2>
              <div class="step__rule" data-rule aria-hidden="true"></div>
              <div class="step__copy">
                <p>{s.text}</p>
              </div>
              {FIGS[s.key] && (
                <svg
                  class="step__fig"
                  viewBox="0 0 140 100"
                  aria-hidden="true"
                  focusable="false"
                  set:html={`<g filter="url(#boat-rough)">${FIGS[s.key]}</g>`}
                />
              )}
            </div>
          </article>
        ))
      }

      <section class="timeline" data-timeline>
        <p class="label">{d.process.timeline.label}</p>
        <div class="tl">
          <svg class="tl__river" aria-hidden="true" data-tl-river>
            <defs>
              <linearGradient id="tl-grad" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="1000" y2="0" data-tl-grad>
                <stop offset="0" stop-color="#3a74d6" />
                <stop offset="1" stop-color="#5a9be8" />
              </linearGradient>
            </defs>
            <path class="tl__path" data-tl-path />
            <path class="tl__ribbon" data-tl-ribbon fill="url(#tl-grad)" />
          </svg>
          <svg class="tl__sailor" viewBox={BOAT_VIEWBOX} aria-hidden="true" data-tl-boat set:html={boatInner} />
          <ol class="tl__list">
            {
              d.process.timeline.items.map((it, i, all) => {
                const last = i === all.length - 1;
                const xs = [4, 15, 28, 40, 53, 63, 77, 91];
                const ys = [48, 66, 38, 62, 42, 68, 34, 56];
                return (
                  <li
                    class:list={['tl__item', i % 2 === 0 ? 'is-up' : 'is-down', { 'is-last': last }]}
                    style={`--x:${xs[i]}%;--y:${ys[i]}%;--i:${i}`}
                  >
                    <span class="tl__dot" aria-hidden="true" data-tl-dot />
                    <div class="tl__txt">
                      <span class="tl__n">{String(i + 1).padStart(2, '0')}/</span>
                      <h3>{it.title}</h3>
                      <p>{it.desc}</p>
                    </div>
                  </li>
                );
              })
            }
          </ol>
        </div>
      </section>

      <div class="proc__end">
        <a class="pill-link" href={localePath('/contact', lang)}>{d.process.cta}</a>
      </div>
    </div>
  </main>
</SiteLayout>

<script>
  // ------------------------------------------------ en pratique : un fil d'encre qui relie les huit étapes
  const tl = document.querySelector<HTMLElement>('.tl');
  if (tl) {
    const svg = tl.querySelector<SVGSVGElement>('[data-tl-river]')!;
    const path = tl.querySelector<SVGPathElement>('[data-tl-path]')!;
    const ribbon = tl.querySelector<SVGPathElement>('[data-tl-ribbon]')!;
    const grad = tl.querySelector<SVGLinearGradientElement>('[data-tl-grad]')!;
    const dots = [...tl.querySelectorAll<Element>('[data-tl-dot]')];
    const sailor = tl.querySelector<SVGElement>('[data-tl-boat]')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const DRAW = 3.4; // secondes

    // bruit de valeur : la largeur et les rives de la rivière changent doucement le long du lit
    const hash = (i: number) => {
      let h = Math.imul(i ^ 0x9e3779b9, 0x85ebca6b);
      h ^= h >>> 13;
      h = Math.imul(h, 0xc2b2ae35);
      h ^= h >>> 16;
      return ((h >>> 0) / 4294967295) * 2 - 1;
    };
    const vnoise = (x: number, seed: number) => {
      const i = Math.floor(x);
      const f = x - i;
      const u = f * f * (3 - 2 * f);
      return hash(i + seed * 7919) * (1 - u) + hash(i + 1 + seed * 7919) * u;
    };

    const STEP = 5;
    let poly: [number, number][] = [];
    let NX: number[] = [];
    let NY: number[] = [];
    let drawStart = -1; // -1 : pas encore commencé
    let tipEnd = false;
    let endAt = 0;
    const pointer = { x: -9999, y: -9999 };
    tl.addEventListener('pointermove', (e) => {
      const r = tl.getBoundingClientRect();
      pointer.x = e.clientX - r.left;
      pointer.y = e.clientY - r.top;
    });
    tl.addEventListener('pointerleave', () => {
      pointer.x = pointer.y = -9999;
    });

    const f1 = (v: number) => v.toFixed(1);
    const paint = (now: number) => {
      if (drawStart < 0 || !poly.length) return;
      const n = poly.length;
      const t = (now - drawStart) / 1000;
      const progress = reduce ? 1 : Math.min(1, t / DRAW);
      const eased = 1 - (1 - progress) ** 3;
      const count = Math.max(2, Math.floor(n * eased));
      const flow = reduce ? 0 : t * 38; // px/s : la matière avance le long du lit
      const narrow = window.innerWidth <= 900;
      const L: string[] = [];
      const R: string[] = [];
      for (let i = 0; i < count; i++) {
        const s = i * STEP;
        const u = i / n;
        const taper = progress < 1 ? Math.min(1, (count - i) / 16) : 1;
        let w = (narrow ? 12 : 17) * (0.8 + 0.35 * vnoise((s - flow) / 110, 3) + 0.12 * vnoise((s - flow * 1.4) / 37, 2)) * (1 - u * 0.3);
        const dx = poly[i][0] - pointer.x;
        const dy = poly[i][1] - pointer.y;
        const d2 = dx * dx + dy * dy;
        if (d2 < 120 * 120) w += 11 * (1 - Math.sqrt(d2) / 120) ** 2;
        w *= taper;
        if (tipEnd) w *= Math.min(1, (n - i) / 14);
        const jl = 1.6 * vnoise(s / 70, 11) + 0.7 * vnoise((s - flow * 0.15) / 13, 12) + 0.35 * vnoise(s / 4.2, 13);
        const jr = 1.6 * vnoise(s / 80, 21) + 0.7 * vnoise((s - flow * 0.15) / 12, 22) + 0.35 * vnoise(s / 4.6, 23);
        L.push(`${f1(poly[i][0] + NX[i] * (w / 2 + jl))},${f1(poly[i][1] + NY[i] * (w / 2 + jl))}`);
        R.push(`${f1(poly[i][0] - NX[i] * (w / 2 + jr))},${f1(poly[i][1] - NY[i] * (w / 2 + jr))}`);
      }
      ribbon.setAttribute('d', `M${L.join('L')}L${R.reverse().join('L')}Z`);
    };
    let raf = 0;
    let live = false;
    const loop = (now: number) => {
      paint(now);
      raf = requestAnimationFrame(loop);
    };
    // l'animation ne tourne que si la frise est à l'écran
    const watch = () => {
      if (reduce || !('IntersectionObserver' in window)) return;
      new IntersectionObserver((entries) => {
        const on = entries[0].isIntersecting;
        if (on && !live) {
          live = true;
          raf = requestAnimationFrame(loop);
        } else if (!on && live) {
          live = false;
          cancelAnimationFrame(raf);
        }
      }).observe(tl);
    };

    const curve = (pts: [number, number][]) => {
      let d = `M${pts[0][0].toFixed(1)},${pts[0][1].toFixed(1)}`;
      for (let i = 0; i < pts.length - 1; i++) {
        const p0 = pts[Math.max(0, i - 1)];
        const p1 = pts[i];
        const p2 = pts[i + 1];
        const p3 = pts[Math.min(pts.length - 1, i + 2)];
        const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
        const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
        d += `C${c1[0].toFixed(1)},${c1[1].toFixed(1)} ${c2[0].toFixed(1)},${c2[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`;
      }
      return d;
    };

    const build = () => {
      const box = tl.getBoundingClientRect();
      const pts: [number, number][] = dots.map((el) => {
        const r = el.getBoundingClientRect();
        return [r.left + r.width / 2 - box.left, r.top + r.height / 2 - box.top];
      });
      const narrow = window.innerWidth <= 900;
      const first = pts[0];
      const last = pts[pts.length - 1];
      let route: [number, number][];
      if (narrow) {
        // mobile : la rivière descend depuis le haut de la liste et se termine en pointe sous la dernière étape
        // elle serpente doucement entre deux étapes (et repasse par chaque point)
        const amp = Math.min(16, box.width * 0.05);
        route = [[first[0], -14]];
        pts.forEach((q, i) => {
          route.push(q);
          const nx = pts[i + 1];
          if (nx) route.push([q[0] + (i % 2 ? -amp : amp), (q[1] + nx[1]) / 2]);
        });
        route.push([last[0] + amp * 0.6, last[1] + 36], [last[0], last[1] + 70]);
      } else {
        // desktop : elle entre par le bord gauche de l'écran et repart par le bord droit
        const left = -box.left - 40;
        const right = window.innerWidth - box.left + 60;
        route = [
          [left, first[1] + 38],
          [(left + first[0]) / 2, first[1] + 10],
          ...pts,
          [(last[0] + right) / 2, last[1] - 22],
          [right, last[1] + 6],
        ];
      }
      tipEnd = narrow;
      svg.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);
      path.setAttribute('d', curve(route));
      grad.setAttribute('x2', String(box.width));
      const len = path.getTotalLength();
      const n = Math.max(2, Math.floor(len / STEP));
      poly = [];
      NX = [];
      NY = [];
      for (let i = 0; i < n; i++) {
        const q = path.getPointAtLength(i * STEP);
        poly.push([q.x, q.y]);
      }
      for (let i = 0; i < n; i++) {
        const a = poly[Math.max(0, i - 1)];
        const b = poly[Math.min(n - 1, i + 1)];
        const l = Math.hypot(b[0] - a[0], b[1] - a[1]) || 1;
        NX.push(-(b[1] - a[1]) / l);
        NY.push((b[0] - a[0]) / l);
      }
      // le bateau s'arrête à la dernière étape
      let best = 0;
      let bd = Infinity;
      poly.forEach((q, i) => {
        const dd = Math.hypot(q[0] - last[0], q[1] - last[1]);
        if (dd < bd) {
          bd = dd;
          best = i;
        }
      });
      endAt = best * STEP;
      if (reduce) paint(performance.now());
    };

    // le bateau suit le fil dessiné ; il s'arrête à la dernière étape, puis repart du début
    let sailing = false;
    let curAng = 0;
    const place = (len: number, at: number, snap = false) => {
      const a = path.getPointAtLength(at);
      // tangente : le bateau est parallèle à la rivière
      const p0 = path.getPointAtLength(Math.max(0, at - 14));
      const p1 = path.getPointAtLength(Math.min(len, at + 14));
      let target = (Math.atan2(p1.y - p0.y, p1.x - p0.x) * 180) / Math.PI;
      // mobile : la rivière descend ; le bateau, retourné, descend avec elle (proue vers le bas, mât vers l'extérieur)
      const narrowNow = window.innerWidth <= 900;
      if (narrowNow) target -= 180;
      curAng = snap ? target : curAng + (target - curAng) * 0.18;
      // mobile : le bateau longe la rivière, côté gauche, hors de l'eau et loin du texte
      const off = window.innerWidth <= 900 ? -26 : 0;
      sailor.style.transform = `translate(${(a.x - 25 + off).toFixed(1)}px, ${(a.y - 26).toFixed(1)}px) rotate(${curAng.toFixed(1)}deg)${window.innerWidth <= 900 ? ' scale(-1, 1)' : ''}`;
    };
    const sail = () => {
      if (sailing) return;
      sailing = true;
      const SPEED = 120; // px/s
      let t0 = performance.now();
      let phase: 'go' | 'rest' | 'fade' = 'go';
      sailor.classList.add('is-on');
      const tick = (now: number) => {
        const len = path.getTotalLength();
        const stop = len; // le bateau traverse toute la rivière : il entre par la gauche, hors de la page, et repart par la droite
        const t = (now - t0) / 1000;
        if (phase === 'go') {
          const at = Math.min(stop, t * SPEED);
          place(len, at);
          if (at >= stop) {
            phase = 'rest';
            t0 = now;
          }
        } else if (phase === 'rest') {
          place(len, stop);
          if (t > 1.2) {
            sailor.classList.remove('is-on');
            phase = 'fade';
            t0 = now;
          }
        } else if (t > 0.9) {
          phase = 'go';
          t0 = now;
          place(len, 0, true);
          sailor.classList.add('is-on');
        }
        requestAnimationFrame(tick);
      };
      place(path.getTotalLength(), 0, true);
      requestAnimationFrame(tick);
    };

    const run = () => {
      tl.classList.add('is-drawn');
      window.setTimeout(sail, DRAW * 1000 + 300);
      drawStart = performance.now();
    };

    // les points sont mesurés au repos : leur transform d'entrée (scale 0.4) ne décale pas leur centre
    build();
    watch();
    if (reduce || !('IntersectionObserver' in window)) {
      tl.classList.add('is-drawn');
      drawStart = performance.now() - DRAW * 1000;
      paint(performance.now());
      place(path.getTotalLength(), endAt || path.getTotalLength(), true);
      sailor.classList.add('is-on');
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            io.disconnect();
            run();
          }
        },
        { threshold: 0.1 },
      );
      io.observe(tl);
    }
    let rt = 0;
    window.addEventListener('resize', () => {
      window.clearTimeout(rt);
      rt = window.setTimeout(build, 150);
    });
    document.fonts?.ready.then(build);
  }
</script>

<script>
  import { drawInkHashes, drawInkRules } from '../scripts/ink';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ------------------------------------------------ l'étape au centre reste nette
  const steps = [...document.querySelectorAll<HTMLElement>('[data-step]')];
  let ticking = false;
  const update = () => {
    ticking = false;
    const vh = window.innerHeight;
    let current = 0;
    let best = Infinity;
    steps.forEach((el, i) => {
      const r = el.getBoundingClientRect();
      const dist = Math.abs(r.top + r.height / 2 - vh / 2);
      if (dist < best) {
        best = dist;
        current = i;
      }
    });
    steps.forEach((el, i) => {
      el.classList.toggle('is-current', i === current);
      el.classList.toggle('is-near', Math.abs(i - current) === 1);
      el.classList.toggle('is-dim', Math.abs(i - current) > 1);
      if (Math.abs(i - current) <= 1) el.classList.add('is-seen'); // traits et # : une fois dessinés, ils restent
    });
  };
  const onScroll = () => {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(update);
    }
  };

  // # et traits dessinés à la main, tous différents
  drawInkHashes([...document.querySelectorAll<HTMLElement>('[data-hash]')]);
  const rules = [...document.querySelectorAll<HTMLElement>('[data-rule]')];
  drawInkRules(rules);
  update();
  if (!reduce) window.addEventListener('scroll', onScroll, { passive: true });

  // ------------------------------------------------ fond qui réagit à la souris (orbes qui fuient le pointeur)
  const canvas = document.querySelector<HTMLCanvasElement>('[data-orbs]');
  const ctx = canvas?.getContext('2d', { alpha: true });
  interface Orb {
    baseX: number;
    baseY: number;
    x: number;
    y: number;
    vx: number;
    vy: number;
    r0: number;
    r: number;
    phase: number;
    speed: number;
    ax: number;
    ay: number;
  }
  let orbList: Orb[] = [];
  let W = 1;
  let H = 1;
  let dpr = 1;
  let frame = 0;
  const mouse = { active: false, x: 0, y: 0 };
  const clamp = (v: number, lo: number, hi: number) => Math.min(Math.max(v, lo), hi);
  const sr = (seed: number) => {
    const v = Math.sin(seed * 12.9898) * 43758.5453;
    return v - Math.floor(v);
  };
  // bleu de la rivière, version pâle
  const COLOR: [number, number, number] = [79, 149, 231];

  const makeOrbs = () => {
    const count = W < 760 ? 18 : 30;
    orbList = Array.from({ length: count }, (_, i) => {
      const baseX = (sr(i + 1) * 1.18 - 0.09) * W;
      const baseY = (0.1 + sr(i + 18) * 0.86) * H;
      const r0 = W < 760 ? clamp(70 + sr(i + 34) * 110, 60, 160) : clamp(150 + sr(i + 34) * 260, 130, 420);
      return {
        baseX,
        baseY,
        x: baseX,
        y: baseY,
        vx: 0,
        vy: 0,
        r0,
        r: r0,
        phase: sr(i + 51) * Math.PI * 2,
        speed: 0.00038 + sr(i + 68) * 0.0009,
        ax: 72 + sr(i + 85) * 130,
        ay: 70 + sr(i + 102) * 125,
      };
    });
  };

  const sizeCanvas = () => {
    if (!canvas || !ctx) return;
    const b = canvas.getBoundingClientRect();
    W = Math.max(1, b.width);
    H = Math.max(1, b.height);
    dpr = Math.min(window.devicePixelRatio || 1, 1.35);
    canvas.width = Math.round(W * dpr);
    canvas.height = Math.round(H * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    makeOrbs();
  };

  const step = (o: Orb, time: number) => {
    const tx = o.baseX + Math.sin(time * o.speed + o.phase) * o.ax;
    const ty = o.baseY + Math.cos(time * o.speed * 0.8 + o.phase) * o.ay;
    if (mouse.active) {
      const dx = o.x - mouse.x;
      const dy = o.y - mouse.y;
      const dist = Math.hypot(dx, dy) || 1;
      const R = 390;
      if (dist < R) {
        const force = (R - dist) / R;
        const ang = Math.atan2(dy, dx);
        o.vx += Math.cos(ang) * force * 2.6;
        o.vy += Math.sin(ang) * force * 2.6;
        o.r += (o.r0 * 0.72 - o.r) * 0.1;
      } else o.r += (o.r0 - o.r) * 0.05;
    } else o.r += (o.r0 - o.r) * 0.05;
    o.vx = (o.vx + (tx - o.x) * 0.014) * 0.9;
    o.vy = (o.vy + (ty - o.y) * 0.014) * 0.9;
    o.x += o.vx;
    o.y += o.vy;
  };

  const draw = (time: number) => {
    if (!ctx) return;
    ctx.clearRect(0, 0, W, H);
    ctx.globalCompositeOperation = 'multiply';
    for (const o of orbList) {
      if (!reduce) step(o, time);
      const g = ctx.createRadialGradient(o.x, o.y, 0, o.x, o.y, o.r);
      const [r, gg, b] = COLOR;
      g.addColorStop(0, `rgba(${r}, ${gg}, ${b}, 0.34)`);
      g.addColorStop(0.35, `rgba(${r}, ${gg}, ${b}, 0.2)`);
      g.addColorStop(0.72, `rgba(${r}, ${gg}, ${b}, 0.08)`);
      g.addColorStop(1, `rgba(${r}, ${gg}, ${b}, 0)`);
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.arc(o.x, o.y, o.r, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.globalCompositeOperation = 'source-over';
    if (!reduce) frame = requestAnimationFrame(draw);
  };

  if (canvas && ctx) {
    sizeCanvas();
    frame = requestAnimationFrame(draw);
    window.addEventListener(
      'pointermove',
      (e) => {
        const b = canvas.getBoundingClientRect();
        mouse.active = e.clientX >= b.left && e.clientX <= b.right && e.clientY >= b.top && e.clientY <= b.bottom;
        mouse.x = e.clientX - b.left;
        mouse.y = e.clientY - b.top;
      },
      { passive: true },
    );
    window.addEventListener('pointerleave', () => (mouse.active = false), { passive: true });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) cancelAnimationFrame(frame);
      else if (!reduce) frame = requestAnimationFrame(draw);
    });
  }

  let rt = 0;
  window.addEventListener('resize', () => {
    window.clearTimeout(rt);
    rt = window.setTimeout(() => {
      drawInkRules(rules);
      update();
      sizeCanvas();
    }, 150);
  });
</script>

<style is:global>
  /* ---------- fond ---------- */
  /* le fond d'orbes passe derrière l'en-tête */
  body:has(.proc__orbs) .nav {
    background: none;
  }
  body:has(.proc__orbs) .nav * {
    text-shadow: none;
  }
  .proc__orbs {
    position: fixed;
    inset: -16% -8%;
    z-index: 0;
    width: 116%;
    height: 132%;
    filter: blur(52px);
    pointer-events: none;
    transform: translateZ(0);
