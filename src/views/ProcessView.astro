---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getDict, localePath } from '../i18n';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = getDict(lang);
const [wordA, wordB] = d.process.heading.split(' ');
---

<SiteLayout lang={lang} title={d.process.title} description={d.process.description}>
  <!-- fond : orbes floues qui fuient la souris puis reviennent en dérivant -->
  <canvas class="proc__orbs" data-orbs aria-hidden="true"></canvas>

  <main class="proc" data-process>
    <!-- le titre reste fixé à gauche, pendant que les étapes défilent par-dessus -->
    <div class="proc__title">
      <div class="proc__title-in">
        <h1 class="proc__h display">
          <span>{wordA}</span>
          <span>{wordB}</span>
        </h1>
        <a class="pill-link proc__cta" href={localePath('/contact', lang)}>{d.process.cta}</a>
      </div>
    </div>

    <div class="proc__steps">
      {
        d.process.steps.map((s) => (
          <article class="step" data-step>
            <div class="step__layout">
              <h2 class="step__title display">
                <span class="step__hash">#</span>{s.title}
              </h2>
              <div class="step__rule" data-rule aria-hidden="true"></div>
              <div class="step__copy">
                <p>{s.text}</p>
                <p class="step__note">{s.note}</p>
              </div>
            </div>
          </article>
        ))
      }
      <a class="pill-link proc__cta proc__cta--bottom" href={localePath('/contact', lang)}>{d.process.cta}</a>
    </div>
  </main>
</SiteLayout>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ------------------------------------------------ l'étape au centre reste nette
  const steps = [...document.querySelectorAll<HTMLElement>('[data-step]')];
  let ticking = false;
  const update = () => {
    ticking = false;
    const vh = window.innerHeight;
    let current = 0;
    let best = Infinity;
    steps.forEach((el, i) => {
      const r = el.getBoundingClientRect();
      const dist = Math.abs(r.top + r.height / 2 - vh / 2);
      if (dist < best) {
        best = dist;
        current = i;
      }
    });
    steps.forEach((el, i) => {
      el.classList.toggle('is-current', i === current);
      el.classList.toggle('is-near', Math.abs(i - current) === 1);
      el.classList.toggle('is-dim', Math.abs(i - current) > 1);
      if (Math.abs(i - current) <= 1) el.classList.add('is-seen'); // le trait, une fois dessiné, reste
    });
  };
  const onScroll = () => {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(update);
    }
  };
  update();
  if (!reduce) window.addEventListener('scroll', onScroll, { passive: true });

  // ------------------------------------------------ trait horizontal irrégulier, dessiné à la main
  const NS = 'http://www.w3.org/2000/svg';
  const rnd = (seed: number) => {
    let a = seed >>> 0;
    return () => {
      a = (a + 0x6d2b79f5) >>> 0;
      let t = a;
      t = Math.imul(t ^ (t >>> 15), t | 1);
      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  };
  const rules = [...document.querySelectorAll<HTMLElement>('[data-rule]')];
  const drawRules = () => {
    rules.forEach((el, k) => {
      const w = Math.round(el.getBoundingClientRect().width);
      if (!w) return;
      const r = rnd(31 + k * 17);
      const phases = [r() * 6.28, r() * 6.28, r() * 6.28];
      const line = (offset: number, jitter: number) => {
        let d = '';
        let drift = 0;
        for (let x = 0; x <= w; x += 7) {
          drift += (r() - 0.5) * jitter;
          drift *= 0.94;
          const y =
            9 +
            offset +
            Math.sin(x / 140 + phases[0]) * 1.6 +
            Math.sin(x / 47 + phases[1]) * 0.9 +
            Math.sin(x / 13 + phases[2]) * 0.35 +
            drift;
          d += `${x ? 'L' : 'M'}${x},${y.toFixed(2)}`;
        }
        return d;
      };
      el.innerHTML =
        `<svg xmlns="${NS}" width="${w}" height="18" viewBox="0 0 ${w} 18" preserveAspectRatio="none">` +
        `<path class="r1" pathLength="1" d="${line(0, 1.1)}"/>` +
        `<path class="r2" pathLength="1" d="${line(1.3, 0.9)}"/></svg>`;
    });
  };
  drawRules();

  // ------------------------------------------------ fond qui réagit à la souris (orbes qui fuient le pointeur)
  const canvas = document.querySelector<HTMLCanvasElement>('[data-orbs]');
  const ctx = canvas?.getContext('2d', { alpha: true });
  interface Orb {
    baseX: number;
    baseY: number;
    x: number;
    y: number;
    vx: number;
    vy: number;
    r0: number;
    r: number;
    phase: number;
    speed: number;
    ax: number;
    ay: number;
  }
  let orbList: Orb[] = [];
  let W = 1;
  let H = 1;
  let dpr = 1;
  let frame = 0;
  const mouse = { active: false, x: 0, y: 0 };
  const clamp = (v: number, lo: number, hi: number) => Math.min(Math.max(v, lo), hi);
  const sr = (seed: number) => {
    const v = Math.sin(seed * 12.9898) * 43758.5453;
    return v - Math.floor(v);
  };
  const COLOR: [number, number, number] = [76, 94, 247];

  const makeOrbs = () => {
    const count = W < 760 ? 18 : 30;
    orbList = Array.from({ length: count }, (_, i) => {
      const baseX = (sr(i + 1) * 1.18 - 0.09) * W;
      const baseY = (0.1 + sr(i + 18) * 0.86) * H;
      const r0 = W < 760 ? clamp(70 + sr(i + 34) * 110, 60, 160) : clamp(150 + sr(i + 34) * 260, 130, 420);
      return {
        baseX,
        baseY,
        x: baseX,
        y: baseY,
        vx: 0,
        vy: 0,
        r0,
        r: r0,
        phase: sr(i + 51) * Math.PI * 2,
        speed: 0.00038 + sr(i + 68) * 0.0009,
        ax: 72 + sr(i + 85) * 130,
        ay: 70 + sr(i + 102) * 125,
      };
    });
  };

  const sizeCanvas = () => {
    if (!canvas || !ctx) return;
    const b = canvas.getBoundingClientRect();
    W = Math.max(1, b.width);
    H = Math.max(1, b.height);
    dpr = Math.min(window.devicePixelRatio || 1, 1.35);
    canvas.width = Math.round(W * dpr);
    canvas.height = Math.round(H * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    makeOrbs();
  };

  const step = (o: Orb, time: number) => {
    const tx = o.baseX + Math.sin(time * o.speed + o.phase) * o.ax;
    const ty = o.baseY + Math.cos(time * o.speed * 0.8 + o.phase) * o.ay;
    if (mouse.active) {
      const dx = o.x - mouse.x;
      const dy = o.y - mouse.y;
      const dist = Math.hypot(dx, dy) || 1;
      const R = 390;
      if (dist < R) {
        const force = (R - dist) / R;
        const ang = Math.atan2(dy, dx);
        o.vx += Math.cos(ang) * force * 2.6;
        o.vy += Math.sin(ang) * force * 2.6;
        o.r += (o.r0 * 0.72 - o.r) * 0.1;
      } else o.r += (o.r0 - o.r) * 0.05;
    } else o.r += (o.r0 - o.r) * 0.05;
    o.vx = (o.vx + (tx - o.x) * 0.014) * 0.9;
    o.vy = (o.vy + (ty - o.y) * 0.014) * 0.9;
    o.x += o.vx;
    o.y += o.vy;
  };

  const draw = (time: number) => {
    if (!ctx) return;
    ctx.clearRect(0, 0, W, H);
    ctx.globalCompositeOperation = 'multiply';
    for (const o of orbList) {
      if (!reduce) step(o, time);
      const g = ctx.createRadialGradient(o.x, o.y, 0, o.x, o.y, o.r);
      const [r, gg, b] = COLOR;
      g.addColorStop(0, `rgba(${r}, ${gg}, ${b}, 0.58)`);
      g.addColorStop(0.35, `rgba(${r}, ${gg}, ${b}, 0.34)`);
      g.addColorStop(0.72, `rgba(${r}, ${gg}, ${b}, 0.13)`);
      g.addColorStop(1, `rgba(${r}, ${gg}, ${b}, 0)`);
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.arc(o.x, o.y, o.r, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.globalCompositeOperation = 'source-over';
    if (!reduce) frame = requestAnimationFrame(draw);
  };

  if (canvas && ctx) {
    sizeCanvas();
    frame = requestAnimationFrame(draw);
    window.addEventListener(
      'pointermove',
      (e) => {
        const b = canvas.getBoundingClientRect();
        mouse.active = e.clientX >= b.left && e.clientX <= b.right && e.clientY >= b.top && e.clientY <= b.bottom;
        mouse.x = e.clientX - b.left;
        mouse.y = e.clientY - b.top;
      },
      { passive: true },
    );
    window.addEventListener('pointerleave', () => (mouse.active = false), { passive: true });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) cancelAnimationFrame(frame);
      else if (!reduce) frame = requestAnimationFrame(draw);
    });
  }

  let rt = 0;
  window.addEventListener('resize', () => {
    window.clearTimeout(rt);
    rt = window.setTimeout(() => {
      drawRules();
      update();
      sizeCanvas();
    }, 150);
  });
</script>

<style is:global>
  /* ---------- fond ---------- */
  .proc__orbs {
    position: fixed;
    inset: -16% -8%;
    z-index: 0;
    width: 116%;
    height: 132%;
    filter: blur(52px) saturate(1.08);
    pointer-events: none;
    transform: translateZ(0);
  }

  /* ---------- structure : titre fixé à gauche, étapes par-dessus ---------- */
  .proc {
    position: relative;
    padding: 0 var(--gutter);
  }
  .proc__title {
    position: sticky;
    top: 0;
    z-index: 1;
    height: 100svh;
    display: flex;
    align-items: center;
    pointer-events: none;
  }
  .proc__title-in {
    display: grid;
    gap: 26px;
    justify-items: start;
    width: min(34vw, 27rem);
  }
  .proc__cta {
    pointer-events: auto;
  }
  .proc__h {
    margin: 0;
    display: grid;
    font-size: clamp(50px, 8.2vw, 120px);
    line-height: 0.9;
    color: #fffdf7;
    -webkit-text-stroke: 1.3px #2a5cc8;
    text-transform: uppercase;
  }
  .proc__steps {
    position: relative;
    z-index: 2;
    margin-top: -100svh;
    padding-top: 10vh;
    padding-bottom: 60vh;
    pointer-events: none;
  }
  .proc__cta--bottom {
    display: none;
  }

  /* ---------- étapes ---------- */
  .step {
    margin: clamp(88px, 13vh, 160px) 0;
    transition:
      opacity 0.4s ease,
      filter 0.4s ease;
  }
  .step.is-near {
    opacity: 0.5;
    filter: blur(1.6px) saturate(0.85);
  }
  .step.is-dim {
    opacity: 0.18;
    filter: blur(3px) saturate(0.6);
  }
  .step__layout {
    display: grid;
    grid-template-columns: minmax(13rem, 0.72fr) minmax(12rem, 1fr);
    column-gap: clamp(2rem, 7vw, 8rem);
    align-items: start;
  }
  .step__title {
    margin: 0;
    font-size: clamp(52px, 7vw, 112px);
    line-height: 0.9;
    text-transform: lowercase;
  }
  .step__hash {
    color: #3f58d8;
    margin-right: 0.04em;
  }
  /* trait horizontal irrégulier */
  .step__rule {
    grid-column: 1 / -1;
    height: 18px;
    margin: clamp(10px, 2vw, 22px) 0 clamp(20px, 3.4vw, 46px);
  }
  .step__rule svg {
    display: block;
    width: 100%;
    height: 18px;
    overflow: visible;
  }
  .step__rule path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1.6s cubic-bezier(0.5, 0, 0.2, 1);
  }
  .step__rule .r1 {
    stroke: #1f2a52;
    stroke-width: 1.5;
  }
  .step__rule .r2 {
    stroke: #1f2a52;
    stroke-width: 0.8;
    opacity: 0.55;
    transition-delay: 0.15s;
  }
  .step.is-seen .step__rule path {
    stroke-dashoffset: 0;
  }
  .step__copy {
    grid-column: 2;
    max-width: 36rem;
    margin-left: auto;
    font-size: clamp(19px, 1.85vw, 26px);
    line-height: 1.18;
  }
  .step__copy p {
    margin: 0;
  }
  .step__note {
    max-width: 31rem;
    margin-top: clamp(20px, 2.8vw, 36px) !important;
    font-size: clamp(16px, 1.3vw, 19px);
    line-height: 1.35;
    font-style: normal;
    color: color-mix(in srgb, var(--ink) 74%, transparent);
  }

  @media (max-width: 900px) {
    .proc__title {
      position: static;
      height: auto;
      padding: calc(var(--nav-h) + 30px) 0 10px;
      pointer-events: auto;
    }
    .proc__title .proc__cta {
      display: none;
    }
    .proc__h {
      font-size: clamp(54px, 18vw, 96px);
    }
    .proc__steps {
      margin-top: 0;
      padding-top: 0;
      padding-bottom: 80px;
    }
    .step {
      margin: clamp(60px, 11vh, 100px) 0;
    }
    .step.is-near,
    .step.is-dim {
      opacity: 1;
      filter: none;
    }
    .step__layout {
      display: block;
    }
    .step__copy {
      margin-left: 0;
    }
    .proc__cta--bottom {
      display: inline-flex;
      pointer-events: auto;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .step {
      transition: none;
    }
    .step.is-near,
    .step.is-dim {
      opacity: 1;
      filter: none;
    }
    .step__rule path {
      stroke-dashoffset: 0;
      transition: none;
    }
  }
</style>
